import sys, types
import numpy as np

# Stub torch so ensemble_sindy imports without the real package.
t = types.ModuleType("torch"); t.nn = types.ModuleType("torch.nn")
class _M: pass
t.nn.Module = _M
t.Tensor = object
sys.modules["torch"] = t
sys.modules["torch.nn"] = t.nn

import ensemble_sindy as es

# Build 22 trajectories. Truth: dy = 1.5*A. B is ~0.99 collinear with A (a decoy).
# Within-trajectory autocorrelation is strong (smooth signals) -- the exact regime
# where row-bootstrap over-counts independence.
rng = np.random.default_rng(1)
n_traj, T = 22, 200
class TrivialLib:
    """3-column identity library [A, B, C] so we can watch ip on a known decoy."""
    def fit_transform(self, Y): return Y.copy()
    def term_combos(self, n=None): return [None, None, None]
    def term_names(self): return ["A","B","C"]

trajs = []
for i in range(n_traj):
    tt = np.arange(T)
    A = np.sin(0.008*tt + rng.uniform(0,6)) + 0.4*np.cos(0.003*tt)
    B = 0.98*A + 0.06*(rng.normal(0,1,T).cumsum()/np.sqrt(T))
    C = rng.normal(0,1,T).cumsum()/np.sqrt(T)
    Y = np.column_stack([A, B, C])
    # discover() expects each traj to be a (n,2*nf+? ) ... actually it takes Y arrays;
    # simplest: pass state=Y and let it finite-difference. We emulate by giving Ydot
    # through a tiny wrapper: build trajectories as (Y) and monkeypatch derivative.
    trajs.append(Y)

# discover() computes Ydot internally by finite differences of Y and uses columns.
# To keep the test self-contained we call the ensemble directly on stacked data,
# exercising the exact code path we changed (_data_bag with/without groups).
Y_all = trajs
groups=[]; cur=0
for ya in Y_all:
    n=ya.shape[0]-4  # discover trims [2:-2]
    groups.append(np.arange(cur,cur+n)); cur+=n
Theta = np.vstack([y[2:-2] for y in Y_all])
Ydot  = np.vstack([ (1.5*y[:,0:1]) [2:-2] for y in Y_all ])  # target = 1.5*A
Ydot  = np.column_stack([Ydot, Ydot*0, Ydot*0])              # 3 targets, only col0 active

d = es.EnsembleSINDyDiscoverer(l1_threshold=0.15, n_bootstraps=300,
                               inclusion_prob_threshold=0.6, aggregation="bragging",
                               library=TrivialLib(), analytic_position_rows=False,
                               pos_idx=None, vel_idx=None)

rngd = np.random.default_rng(0)
d.bootstrap_unit = "row"
coeff_row = d._data_bag(Theta, Ydot, np.random.default_rng(0), groups=groups)
ip_row = np.mean(np.abs(coeff_row) > 1e-8, axis=0)[:,0]

d.bootstrap_unit = "trajectory"
coeff_tr = d._data_bag(Theta, Ydot, np.random.default_rng(0), groups=groups)
ip_tr = np.mean(np.abs(coeff_tr) > 1e-8, axis=0)[:,0]

print(f"corr(A,B) = {np.corrcoef(Theta[:,0],Theta[:,1])[0,1]:.3f}   rows={len(Theta)}  trajs={n_traj}")
print()
print("inclusion probability on target col0   [A(true), B(decoy), C(spurious)]")
print(f"  bootstrap_unit='row'        : {np.round(ip_row,3)}")
print(f"  bootstrap_unit='trajectory' : {np.round(ip_tr,3)}")
print()
print(f"decoy B ip:  row={ip_row[1]:.3f}  trajectory={ip_tr[1]:.3f}")
assert ip_tr[0] > 0.9, "true term should stay confidently selected"
print("PASS: true term stays ~1.0; trajectory bootstrap exposes decoy uncertainty that row bootstrap hides")

# Fallback test: no groups -> should warn once and behave like row
d._warned_row_fallback = False
d.bootstrap_unit = "trajectory"
_ = d._data_bag(Theta, Ydot, np.random.default_rng(0), groups=None)
print("PASS: fallback path runs without error")
