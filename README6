# NBF Anomaly Detection - Windows Server 2022 / process isolation
#
# The `version:` key is obsolete in Compose v2 and is intentionally absent;
# leaving it in produces a warning on every invocation.
#
# CRITICAL: `source:` must be a path the Docker daemon (LocalSystem, Session 0)
# can resolve. See the handover notes. Pick ONE of the three source styles
# below and comment out the others.

services:
  anomaly-detector:
    build: .
    image: automation-toolset:latest
    container_name: automation-test-run
    isolation: process
    ports:
      - "8501:8501"

    environment:
      STREAMLIT_SERVER_HEADLESS: "true"
      NBF_LOG_DIR: 'C:\app\logs'
      NBF_REPORT_DIR: 'C:\app\reports'
      NBF_DATA_DIR: 'C:\app\data'
      # Path an ANALYST on the host uses to reach the trace tree. This is what
      # the [Raw Log] links in the PDF will point at, so it must be the host
      # view (G:\... or \\server\share\...), never the container view.
      NBF_HOST_LOG_ROOT: 'G:\docker-storage\logs'

    volumes:
      # ---- ACTIVE: G: drive, long-form syntax.
      # Confirmed 2026-07-27: G: is a local fixed disk (Win32_LogicalDisk
      # DriveType 3, no ProviderName) and the daemon mounts it successfully
      # via `docker run -v G:\docker-storage\logs:C:\probe`. The drive was
      # never the problem - the short-form volume string was. Long-form
      # syntax removes the colon-splitting ambiguity entirely.
      - type: bind
        source: 'G:\docker-storage\logs'
        target: 'C:\app\logs'
        read_only: true
      - type: bind
        source: 'G:\docker-storage\reports'
        target: 'C:\app\reports'

      # Uncomment ONLY after creating G:\docker-storage\dart on the host,
      # otherwise this mount reproduces "bind source path does not exist".
      # - type: bind
      #   source: 'G:\docker-storage\dart'
      #   target: 'C:\app\data'
      #   read_only: true

      # ---- ALTERNATIVE 1: directory mount point on the system drive.
      # Requires `mountvol C:\docker-storage\ \\?\Volume{GUID}\` first.
      # Only worth doing if the G: letter ever stops being assigned at boot.
      # - type: bind
      #   source: 'C:\docker-storage\logs'
      #   target: 'C:\app\logs'
      #   read_only: true

      # ---- ALTERNATIVE 2: UNC source, no drive letter involved.
      # - type: bind
      #   source: '\\NBF-FS01\sit-traces\logs'
      #   target: 'C:\app\logs'
      #   read_only: true

    restart: unless-stopped
