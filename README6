# eom_library.py
"""Parametric Equations-of-Motion (EOM) basis for the physics backbone.

The idea
--------
SINDy exists to discover *unknown structure*. But the structure of atmospheric
glide flight is not unknown -- it is textbook 3-DoF point-mass physics: gravity,
aerodynamic drag along the velocity vector, aerodynamic lift perpendicular to it,
and geometric curvature terms. What is genuinely unknown for a given threat is a
handful of AERODYNAMIC COEFFICIENTS (C_D*A/m, C_L*A/m and their lateral analogue).

Asking a sparse-regression search to rediscover Newton from ~22 noisy flights is
badly under-determined: it invents non-physical positive-feedback terms (h*h, s*s)
that fit one step and destroy the rollout. This module instead writes the known
force laws down and leaves only the unknown coefficients free.

The crucial property that makes this a drop-in: the EOM are **linear in the unknown
coefficients**, so the same `stridge` / ensemble machinery and the same standalone
rollout evaluation work unchanged -- only the candidate columns differ. Instead of
~85 polynomial columns we offer ~6 physically-derived ones.

Basis columns (all evaluated in PHYSICAL units, then normalised)
---------------------------------------------------------------
With V = sqrt(v_s^2 + v_h^2), dynamic-pressure-like factor q = 0.5*rho(h)*V^2 and
rho(h) = exp(-h/H):

  drag_s   = -q * v_s / V        (drag, along-track component)   -> coeff k_D
  drag_h   = -q * v_h / V        (drag, vertical component)      -> coeff k_D
  lift_s   = +q * v_h / V        (in-plane lift, along-track)    -> coeff k_L
  lift_h   = -q * v_s / V        (in-plane lift, vertical)       -> coeff k_L
  lat_aero =  q                  (lateral/bank force -> turn rate) -> coeff k_lat
  gravity  = -g0*(Re/(Re+h))^2   (gravity, vertical)             -> coeff ~1 (fixed form)
  curv     = +v_s^2/(Re+h)       (centrifugal/curvature, vertical) -> coeff ~1
  bias     =  1                  (small constant offset / trim)

Every column is a genuine force term. There is no term whose magnitude grows with
POSITION in a way that feeds back on itself, so a fitted model is structurally
incapable of the runaway that the polynomial library produced.
"""

from __future__ import annotations

import numpy as np

EARTH_RADIUS_M = 6371000.0
G0 = 9.80665
# Speed-of-sound model for the Mach proxy. A simple two-layer ISA-like temperature
# profile is enough: what matters for the library is that M varies correctly with
# altitude and speed, not absolute atmospheric fidelity (the fitted coefficients
# absorb any constant offset).
GAMMA_AIR = 1.4
R_SPECIFIC = 287.05
T_SEA = 288.15
T_LAPSE = 0.0065
T_TROPO = 216.65
T_MIN, T_MAX = 180.0, 320.0
_V_EPS = 1e-9
_EXP_ARG_MAX = 10.0


class EOMLibrary:
    """Physically-derived candidate columns for glide-phase equations of motion."""

    def __init__(
        self,
        state_vector_len: int = 5,
        h_idx: int = 1,
        vs_idx: int = 2,
        va_idx: int = 3,
        vh_idx: int = 4,
        h_sign: float = 1.0,
        s_idx: int = 0,
        include_frame_transport: bool = True,
        s_floor: float = 5000.0,
        mach_powers: tuple[int, ...] = (),
        scale_heights: tuple[float, ...] = (7200.0,),
        earth_radius: float = EARTH_RADIUS_M,
        feature_mean=None,
        feature_scale=None,
        include_bias: bool = True,
        include_linear_velocity: bool = True,
        clip: float = 8.0,
        # kept for interface compatibility with the other libraries
        degree: int = 2,
        pos_idx=(0, 1),
        vel_idx=(2, 4),
        poly_mode: str = "eom",
    ):
        self.state_vector_len = state_vector_len
        self.h_idx, self.vs_idx, self.va_idx, self.vh_idx = h_idx, vs_idx, va_idx, vh_idx
        # See PhysicsInformedLibrary.h_sign. Converts the frame's altitude-like
        # channel to TRUE ALTITUDE (positive up): +1 for geodesic h and DCU Up,
        # -1 for grdth's NED Down. Feeds rho(h)=exp(-h/H), the gravity term
        # g0*(Re/(Re+h))^2 and the curvature denominator, all of which are wrong
        # (and the first of which saturates) if the sign is inverted.
        self.h_sign = float(h_sign)
        # --- polar-frame transport / rotating-frame terms -------------------
        # The geodesic-integrated frame is a POLAR system centred on the impact
        # point: s = radius, azimuth = polar angle, v_s = radial rate, v_alpha ~
        # angular rate (see NEXT_geodesic_frame.ecef_to_local_geodesic_vec). A polar
        # frame has MANDATORY transport (fictitious) terms -- they are not optional
        # physics, they are what the coordinate system itself requires:
        #     dv_r/dt   = a_radial + r*omega^2          (centripetal)
        #     domega/dt = a_tang/r - 2*v_r*omega/r      (Coriolis/transport)
        # Neither was present in the original basis. Measured on representative
        # glide numbers (s=1000 km, v_s=-5 km/s, v_alpha=1e-4) the transport term
        # alone changes v_alpha by ~3x its own typical magnitude over 300 s.
        #
        # Separately, ECEF is a ROTATING frame, so true Coriolis appears. Projecting
        # a_cor = -2*Omega x v onto this frame's (radial, tangential) axes, the
        # azimuth dependence CANCELS for the sin(lat0) part:
        #     a_cor . t_hat = -f * v_l ,   a_cor . l_hat = +f * v_s ,   f = 2*Om*sin(lat0)
        # so the dominant (f-plane) Coriolis IS expressible in this state. The
        # residual cos(lat0)*v_h terms require the azimuth, which is not a state
        # variable, and are therefore left to the neural residual.
        # f*|v_s| ~ 0.42 m/s^2 at 35 deg latitude -> ~19 km of cross-range over 300 s,
        # which exceeds the entire current error budget. Omitting it forces the fit
        # to absorb a large, systematic, coherent force.
        self.s_idx = int(s_idx)
        self.include_frame_transport = bool(include_frame_transport)
        # Division by s is guarded: s -> 0 at the impact point (the frame origin),
        # mirroring NEXT_geodesic_frame's own S_EPS_M guard but with a larger floor,
        # because these columns divide by s rather than merely evaluating at it.
        self.s_floor = float(s_floor)
        # --- Mach-dependent aerodynamic coefficients ------------------------
        # The base aero columns (aero_along/aero_vert/aero_q) each carry ONE fitted
        # constant, i.e. they assume C_L and C_D are constant. Measured on the real
        # 28-trajectory set that is false: the effective C_L has a within-flight
        # coefficient of variation of 0.45 (smoothed, so not differentiation noise)
        # and a 2.7x spread of per-flight means, and ~53% of that variation is
        # predictable from (Mach, altitude, V). A single constant therefore cannot
        # represent the lift, and no amount of ADDITIONAL constant-coefficient terms
        # helps -- it is a functional-form limitation, not a term-selection one.
        #
        # Real hypersonic aero uses C_L(Mach, alpha) tables; hand-derived models
        # encode that dependence explicitly. `mach_powers` reproduces it in a
        # SINDy-compatible way: for each power k, an extra column (base_aero * M^k)
        # is offered, so sparse regression can assemble
        #     C(M) = c0 + c1*M + c2*M^2 + ...
        # Each column remains LINEAR in its coefficient, so E-SINDy, the trainable-Xi
        # co-learning and ONNX export are all unchanged.
        #
        # Empty tuple () = original constant-coefficient behaviour.
        self.mach_powers = tuple(int(k) for k in mach_powers if int(k) != 0)
        self.scale_heights = tuple(float(H) for H in scale_heights)
        self.earth_radius = float(earth_radius)
        self.include_bias = bool(include_bias)
        # A small linear-in-velocity block lets the fit absorb mild unmodelled damping
        # without introducing any position dependence (hence no feedback risk).
        self.include_linear_velocity = bool(include_linear_velocity)
        self.clip = float(clip)
        self.feature_mean = None if feature_mean is None else np.asarray(feature_mean, float)
        self.feature_scale = None if feature_scale is None else np.asarray(feature_scale, float)
        self.col_scale_ = None  # frozen normalisation, set on first fit_transform
        # Frozen Mach centring/scaling reference, set on the first fit_transform and
        # shared with the torch path via library_spec. Mach spans only ~8.5-10.3 over a
        # glide (a 19% relative range), so an UNCENTRED factor M makes (base*M) a
        # rescaled copy of base -- measured correlation 0.9999, i.e. rank-deficient and
        # useless to sparse regression. Centring on the training-set mean makes the
        # column encode the Mach VARIATION (the actual C_L(Mach) dependence), dropping
        # the correlation to ~0.995. The reference must be FROZEN, not recomputed per
        # call, or the numpy (discovery) and torch (model) columns would disagree.
        self.mach_ref_ = None   # (mean, std)
        self.pos_idx = tuple(int(i) for i in pos_idx)
        self.vel_idx = tuple(int(i) for i in vel_idx)

        # (name, kind, scale_height_or_None)
        self.terms: list[tuple[str, str, float | None]] = []
        if self.include_bias:
            self.terms.append(("1", "bias", None))
        self.terms.append(("gravity", "gravity", None))
        self.terms.append(("curv_vs2", "curv", None))
        for H in self.scale_heights:
            # IMPORTANT -- avoid degenerate columns. In the in-plane 3-DoF form,
            # drag_s = -q*v_s/V and lift_h = -q*v_s/V are the SAME column, and
            # drag_h = -q*v_h/V is the negative of lift_s. Offering all four makes the
            # regression rank-deficient: coefficients split arbitrarily between exact
            # duplicates (observed as identical coefficients on paired terms). Offer
            # only the two independent in-plane aero directions, plus the lateral term.
            self.terms.append((f"aero_along@H={int(H)}", "drag_s", H))   # ~ -q*v_s/V
            self.terms.append((f"aero_vert@H={int(H)}", "drag_h", H))    # ~ -q*v_h/V
            self.terms.append((f"aero_q@H={int(H)}", "lat_aero", H))     # ~  q (bank/lateral)
            # Mach-scaled replicas: (base aero) * M^k. Together with the k=0 base
            # column above, sparse regression can build a Mach polynomial for each
            # aerodynamic coefficient instead of being forced to a single constant.
            for k in self.mach_powers:
                self.terms.append((f"aero_along*M{k}@H={int(H)}", f"drag_s_m{k}", H))
                self.terms.append((f"aero_vert*M{k}@H={int(H)}", f"drag_h_m{k}", H))
                self.terms.append((f"aero_q*M{k}@H={int(H)}", f"lat_aero_m{k}", H))
        if self.include_linear_velocity:
            # v_s is nearly collinear with the aero columns on glide data (both track
            # speed), so it is excluded; v_h and v_al add independent information.
            self.terms.append(("v_h", "lin_vh", None))
            self.terms.append(("v_al", "lin_va", None))

        if self.include_frame_transport:
            # Polar-frame transport terms (mandatory kinematics of this frame).
            #   centripetal : s * v_alpha^2      -> feeds dv_s/dt
            #   transport   : v_s * v_alpha / s  -> feeds dv_alpha/dt (the -2 v_r w / r term)
            # Rotating-Earth (f-plane) Coriolis, azimuth-independent components:
            #   cor_along   : v_l = s * v_alpha  -> feeds dv_s/dt   (coefficient ~ -f)
            #   cor_turn    : v_s / s            -> feeds dv_alpha/dt (coefficient ~ +f)
            # NOTE: a "total horizontal speed" curvature column
            # (v_s^2 + v_l^2)/(Re+h) was evaluated and REJECTED: on glide data it is
            # 0.998-collinear with the existing curv_vs2 (v_l ~ 137 m/s vs v_s ~ 5200
            # m/s, a 0.07% correction), so it only adds rank deficiency. The library
            # docstring's own warning about degenerate columns applies.
            self.terms.append(("centripetal_s", "centripetal", None))
            self.terms.append(("transport_va", "transport", None))
            self.terms.append(("cor_along", "cor_along", None))
            self.terms.append(("cor_turn", "cor_turn", None))

    # ------------------------------------------------------------- interface

    def term_names(self) -> list[str]:
        return [t[0] for t in self.terms]

    def term_combos(self, n_features: int | None = None) -> list:
        """Bias reported as the empty tuple so callers can locate it; rest opaque."""
        return [() if t[1] == "bias" else None for t in self.terms]

    @property
    def n_terms(self) -> int:
        return len(self.terms)

    def library_spec(self) -> dict:
        return {
            "kind": "eom",
            "state_vector_len": self.state_vector_len,
            "terms": [(n, k, H) for (n, k, H) in self.terms],
            "h_idx": self.h_idx, "vs_idx": self.vs_idx,
            "va_idx": self.va_idx, "vh_idx": self.vh_idx,
            "h_sign": self.h_sign,
            "s_idx": self.s_idx,
            "s_floor": self.s_floor,
            "mach_ref": None if self.mach_ref_ is None else list(self.mach_ref_),
            "earth_radius": self.earth_radius,
            "feature_mean": None if self.feature_mean is None else self.feature_mean.tolist(),
            "feature_scale": None if self.feature_scale is None else self.feature_scale.tolist(),
            "clip": self.clip,
            "col_scale": None if self.col_scale_ is None else list(self.col_scale_),
            "poly_combos": [],
            "physics_terms": [],
        }

    # ------------------------------------------------------------ evaluation

    def _to_physical(self, Y: np.ndarray) -> np.ndarray:
        if self.feature_mean is None or self.feature_scale is None:
            return Y
        return Y * self.feature_scale + self.feature_mean

    def fit_transform(self, Y: np.ndarray) -> np.ndarray:
        n = Y.shape[0]
        P = self._to_physical(Y)
        h = self.h_sign * P[:, self.h_idx]  # true altitude, positive up
        vs = P[:, self.vs_idx]
        va = P[:, self.va_idx]
        vh = P[:, self.vh_idx]

        V = np.sqrt(vs * vs + vh * vh + _V_EPS)
        Re = self.earth_radius
        g = G0 * (Re / (Re + h)) ** 2

        # Mach proxy for the Mach-dependent aero columns.
        T = np.where(h < 11000.0, T_SEA - T_LAPSE * h,
                     np.where(h < 20000.0, T_TROPO, T_TROPO + 0.001 * (h - 20000.0)))
        T = np.clip(T, T_MIN, T_MAX)
        mach = V / np.sqrt(GAMMA_AIR * R_SPECIFIC * T)
        if self.mach_powers:
            if self.mach_ref_ is None:
                _mu = float(np.mean(mach))
                _sd = float(np.std(mach))
                self.mach_ref_ = (_mu, _sd if _sd > 1e-9 else 1.0)
            mach = (mach - self.mach_ref_[0]) / self.mach_ref_[1]

        cols = np.empty((n, self.n_terms), dtype=float)
        # Guarded radius and tangential velocity, shared by the transport columns.
        s_raw = P[:, self.s_idx] if self.s_idx < P.shape[1] else np.zeros(n)
        s_g = np.where(np.abs(s_raw) < self.s_floor,
                       np.sign(s_raw) * self.s_floor + (s_raw == 0) * self.s_floor,
                       s_raw)
        v_l = s_g * va  # tangential velocity implied by the scaled angular rate

        for j, (_, kind, H) in enumerate(self.terms):
            if kind == "bias":
                cols[:, j] = 1.0
            elif kind == "gravity":
                cols[:, j] = -g
            elif kind == "curv":
                cols[:, j] = vs * vs / (Re + h)
            elif kind == "centripetal":
                cols[:, j] = s_g * va * va
            elif kind == "transport":
                cols[:, j] = vs * va / s_g
            elif kind == "cor_along":
                cols[:, j] = v_l
            elif kind == "cor_turn":
                cols[:, j] = vs / s_g
            elif kind == "curv_horiz":
                cols[:, j] = (vs * vs + v_l * v_l) / (Re + h)
            elif kind == "lin_vs":
                cols[:, j] = vs
            elif kind == "lin_vh":
                cols[:, j] = vh
            elif kind == "lin_va":
                cols[:, j] = va
            else:
                rho = np.exp(np.minimum(-h / H, _EXP_ARG_MAX))
                q = 0.5 * rho * V * V
                if kind == "drag_s":
                    cols[:, j] = -q * vs / V
                elif kind == "drag_h":
                    cols[:, j] = -q * vh / V
                elif kind == "lift_s":
                    cols[:, j] = q * vh / V
                elif kind == "lift_h":
                    cols[:, j] = -q * vs / V
                elif kind == "lat_aero":
                    cols[:, j] = q
                elif kind.startswith(("drag_s_m", "drag_h_m", "lat_aero_m")):
                    base, _, kpow = kind.rpartition("_m")
                    mk = mach ** int(kpow)
                    if base == "drag_s":
                        cols[:, j] = -q * vs / V * mk
                    elif base == "drag_h":
                        cols[:, j] = -q * vh / V * mk
                    else:  # lat_aero
                        cols[:, j] = q * mk
                else:
                    raise ValueError(f"unknown EOM term kind: {kind}")

        # Freeze per-column RMS on the first (training) call, then always normalise
        # and clip. Same reasoning as the physics library: exp(-h/H) is unbounded
        # outside the training envelope and would otherwise destabilise a rollout
        # that wanders below it.
        if self.col_scale_ is None:
            rms = np.sqrt(np.mean(cols ** 2, axis=0))
            rms[~np.isfinite(rms) | (rms <= 0)] = 1.0
            self.col_scale_ = rms
        return np.clip(cols / self.col_scale_, -self.clip, self.clip)


def evaluate_eom_library_torch(y, spec: dict):
    """Torch mirror of `EOMLibrary.fit_transform` (identical column order)."""
    import torch

    mean, scale = spec.get("feature_mean"), spec.get("feature_scale")
    if mean is not None and scale is not None:
        mean_t = torch.as_tensor(mean, dtype=y.dtype, device=y.device)
        scale_t = torch.as_tensor(scale, dtype=y.dtype, device=y.device)
        P = y * scale_t + mean_t
    else:
        P = y

    hi, vsi, vai, vhi = spec["h_idx"], spec["vs_idx"], spec["va_idx"], spec["vh_idx"]
    # Default +1.0 preserves the behaviour of specs written before h_sign existed.
    h_sign = float(spec.get("h_sign", 1.0))
    h = h_sign * P[..., hi : hi + 1]
    vs = P[..., vsi : vsi + 1]
    va = P[..., vai : vai + 1]
    vh = P[..., vhi : vhi + 1]
    V = torch.sqrt(vs * vs + vh * vh + _V_EPS)
    Re = spec["earth_radius"]
    g = G0 * (Re / (Re + h)) ** 2

    # Mach proxy -- must mirror the numpy path exactly.
    T = torch.where(h < 11000.0, T_SEA - T_LAPSE * h,
                    torch.where(h < 20000.0,
                                torch.full_like(h, T_TROPO),
                                T_TROPO + 0.001 * (h - 20000.0)))
    T = torch.clamp(T, min=T_MIN, max=T_MAX)
    mach = V / torch.sqrt(GAMMA_AIR * R_SPECIFIC * T)
    _mref = spec.get("mach_ref")
    if _mref is not None:
        mach = (mach - float(_mref[0])) / float(_mref[1])

    # Guarded radius / tangential velocity for the polar-transport columns.
    s_idx = spec.get("s_idx", 0)
    s_floor = float(spec.get("s_floor", 5000.0))
    s_raw = P[..., s_idx : s_idx + 1]
    s_sign = torch.where(s_raw < 0, -torch.ones_like(s_raw), torch.ones_like(s_raw))
    s_g = torch.where(torch.abs(s_raw) < s_floor, s_sign * s_floor, s_raw)
    v_l = s_g * va

    cols = []
    for (_, kind, H) in spec["terms"]:
        if kind == "bias":
            cols.append(torch.ones_like(h))
        elif kind == "gravity":
            cols.append(-g)
        elif kind == "curv":
            cols.append(vs * vs / (Re + h))
        elif kind == "centripetal":
            cols.append(s_g * va * va)
        elif kind == "transport":
            cols.append(vs * va / s_g)
        elif kind == "cor_along":
            cols.append(v_l)
        elif kind == "cor_turn":
            cols.append(vs / s_g)
        elif kind == "curv_horiz":
            cols.append((vs * vs + v_l * v_l) / (Re + h))
        elif kind == "lin_vs":
            cols.append(vs)
        elif kind == "lin_vh":
            cols.append(vh)
        elif kind == "lin_va":
            cols.append(va)
        else:
            rho = torch.exp(torch.clamp(-h / H, max=_EXP_ARG_MAX))
            q = 0.5 * rho * V * V
            if kind == "drag_s":
                cols.append(-q * vs / V)
            elif kind == "drag_h":
                cols.append(-q * vh / V)
            elif kind == "lift_s":
                cols.append(q * vh / V)
            elif kind == "lift_h":
                cols.append(-q * vs / V)
            elif kind == "lat_aero":
                cols.append(q)
            elif kind.startswith(("drag_s_m", "drag_h_m", "lat_aero_m")):
                base, _, kpow = kind.rpartition("_m")
                mk = mach ** int(kpow)
                if base == "drag_s":
                    cols.append(-q * vs / V * mk)
                elif base == "drag_h":
                    cols.append(-q * vh / V * mk)
                else:
                    cols.append(q * mk)
            else:
                raise ValueError(f"unknown EOM term kind: {kind}")

    out = torch.cat(cols, dim=-1)
    cs = spec.get("col_scale")
    clip = float(spec.get("clip", 8.0))
    if cs is not None:
        cs_t = torch.as_tensor(cs, dtype=out.dtype, device=out.device)
        out = torch.clamp(out / cs_t, -clip, clip)
    return out
