"""Tests for the physics term: parity, invariants, OOD behaviour, robustness.

Two implementations of the same equations exist by necessity - numpy in
sindy_physics for offline discovery, torch in gru_ode for training and export.
The SINDy fit initialises the torch parameters, so a disagreement between them
would start training from coefficients that do not describe the field being
integrated, and would surface only as a mysteriously poor result rather than
as an error. Section 1 checks they agree.

Sections 2-4 check the properties the architecture is actually being bought
for: that the physical field cannot add energy at any state in R^n, that it
decelerates rather than accelerates the runaway states prior work observed,
and that coefficient recovery survives sensor noise and unmodelled maneuvers.

Run where torch is available to additionally exercise the real module.
"""
import numpy as np

import sindy_physics as sp

R = sp.EARTH_RADIUS_M
G0 = sp.G0
EPS = 1e-8

# =========================================================================
# 1. Parity: numpy library vs. torch field
# =========================================================================



def torch_forward_transliterated(y_phys, fs, k_drag, k_lift, H,
                                 k_grav=1.0, k_curv=1.0, max_density_ratio=5.0):
    """Line-by-line mirror of HGVPhysics.forward, in numpy.

    Deliberately follows the torch source operation by operation, including
    the index_copy assembly, rather than being rewritten in vectorised numpy.
    A parity test that shares an implementation tests nothing.
    """
    alt = y_phys[:, [fs.height_idx]] + fs.alt_ref_m
    pos_h = y_phys[:, list(fs.horiz_pos_idx)]

    # No tangent-plane altitude correction: NEXT_frame stores true hae.

    rho = np.exp(np.minimum(-alt / H, np.log(max_density_ratio)))

    v = y_phys[:, list(fs.phys_vel_idx)]
    vh = v[:, list(fs.horiz_vel_local)]
    vu = v[:, [fs.vert_vel_local]]
    speed_h = np.sqrt((vh * vh).sum(-1, keepdims=True) + EPS)
    speed = np.sqrt(speed_h * speed_h + vu * vu + EPS)

    zero = np.zeros_like(v)

    acc = -k_drag * rho * speed * v

    lift_h = -(k_lift * rho * speed * vu / speed_h) * vh
    lift_u = k_lift * rho * speed * speed_h
    lift = zero.copy()
    lift[:, list(fs.horiz_vel_local)] = lift_h
    lift[:, [fs.vert_vel_local]] = lift_u
    acc = acc + lift

    g = k_grav * G0 * (R / (R + alt)) ** 2
    grav = zero.copy()
    if fs.fixed_velocity_basis:
        grav[:, list(fs.horiz_vel_local)] = -(g / R) * pos_h
        grav[:, [fs.vert_vel_local]] = -g
    else:
        grav[:, [fs.vert_vel_local]] = -g
    acc = acc + grav

    m_curv = 0.0 if fs.fixed_velocity_basis else 1.0
    curv = zero.copy()
    curv[:, [fs.vert_vel_local]] = m_curv * k_curv * speed_h * speed_h / (R + alt)
    acc = acc + curv

    return acc


def library_field(y_phys, fs, k_drag, k_lift, H, max_density_ratio=5.0):
    """Same field assembled from the SINDy library columns."""
    A = sp.build_terms(y_phys, fs, H, max_density_ratio=max_density_ratio)
    names = fs.term_names()
    coef = np.array([
        k_drag if n == sp.TERM_DRAG else k_lift if n == sp.TERM_LIFT else 1.0
        for n in names
    ])
    return A @ coef


rng = np.random.default_rng(11)
ok = True
print("numpy library vs. transliterated torch field")
print("-" * 62)
for frame, mode, alt_ref in (("geodesic", "integrated", 0.0), ("lned", "", 0.0)):
    fs = sp.frame_spec_for(frame, geodesic_mode=mode or "integrated", alt_ref_m=alt_ref)
    y = np.zeros((3000, fs.n_features))
    y[:, fs.height_idx] = rng.uniform(-20_000, 90_000, 3000)
    for i in fs.horiz_pos_idx:
        y[:, i] = rng.uniform(-3e5, 3e5, 3000)
    for i in fs.phys_vel_idx:
        y[:, i] = rng.uniform(-3000, 3000, 3000)

    kd, kl, H = 8.75e-5, 1.75e-4, 7200.0
    a1 = library_field(y, fs, kd, kl, H)
    a2 = torch_forward_transliterated(y, fs, kd, kl, H)
    err = np.max(np.abs(a1 - a2)) / max(np.max(np.abs(a1)), 1e-12)
    good = err < 1e-12
    ok &= good
    print(f"  [{'PASS' if good else 'FAIL'}] {fs.name:<22} max relative disagreement {err:.2e}")

