"""Minimal numpy-backed stand-in for the torch API subset used by the
library torch-mirrors, so numpy/torch column parity can be checked offline."""
import numpy as np


def as_tensor(x, dtype=None, device=None):
    return np.asarray(x, dtype=float)


def ones_like(x):
    return np.ones_like(x)


def sqrt(x):
    return np.sqrt(x)


def exp(x):
    return np.exp(x)


def clamp(x, min=None, max=None):
    return np.clip(x, min, max)


def cat(cols, dim=-1):
    return np.concatenate(cols, axis=dim)
