# 9) Terminal‑Phase “Impact‑Angle” Guidance
# ------------------------------------------------------------------
def impact_angle_guidance(s_own, s_target,
                         theta_imp=np.radians(30),
                         k_imp=0.5):
    """
    Forces the missile to approach the target on a prescribed impact
    angle θ_imp measured from the target‑centric local horizontal plane.
    The law creates a lateral acceleration component that rotates the LOS
    toward the desired impact geometry.
    a = k_imp * ( λ̂_rot – λ̂ )
    where λ̂_rot is the LOS vector rotated by θ_imp about the axis
    perpendicular to the LOS‑plane and the target‑centered local vertical.
    """
    lam = los_vector(s_target, s_own)
    # Define a target‑centric vertical (approximate) as the unit vector
    # from target to Earth centre: for a high‑altitude missile we can take it as [0,0,1].
    # If you have a more accurate model replace `z_hat` accordingly.
    z_hat = np.array([0.0, 0.0, 1.0])
    # Axis that is orthogonal to both LOS and the vertical
    axis = np.cross(lam, z_hat)
    if norm(axis) < 1e-6:                # LOS already aligned with vertical
        axis = np.array([1.0, 0.0, 0.0])
    axis = axis / norm(axis)
    # Rotate LOS by the desired impact angle (away from vertical)
    c = np.cos(theta_imp)
    s = np.sin(theta_imp)
    lam_rot = (c * lam +
               s * np.cross(axis, lam) +
               (1 - c) * np.dot(lam, axis) * axis)
    a = k_imp * (lam_rot - lam)
    return a
