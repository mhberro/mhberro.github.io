# =========================================================================
# 5. lned frame kinematics: is d(pos)/dt == vel, and does the shipped
#    transport correction fix it?
# =========================================================================
# GRUODEPredictorModel overwrites the position channels of the vector field
# with the velocity channels. That identity is exact only when the position
# coordinates are the time-integral of the velocity coordinates. In lned they
# are not: NEXT_frame measures forward/right as GEODESIC displacement and
# altitude as true hae, but resolves velocity with
# ecef_to_ned_velocity(state[VEL_SLICE], origin) - a basis pinned at the
# trajectory's first point. Project modules are not importable standalone
# (geographiclib, pandas, coordinate_transform_functions), so WGS-84 is
# reimplemented here and the transform mirrored line for line.


A_WGS84 = 6378137.0
F_WGS84 = 1.0 / 298.257223563
B_WGS84 = A_WGS84 * (1 - F_WGS84)
E2 = 2 * F_WGS84 - F_WGS84**2
GM = 3.986004418e14


def geodetic_to_ecef(lat_deg, lon_deg, h):
    lat, lon = np.radians(lat_deg), np.radians(lon_deg)
    N = A_WGS84 / np.sqrt(1 - E2 * np.sin(lat) ** 2)
    return np.array([
        (N + h) * np.cos(lat) * np.cos(lon),
        (N + h) * np.cos(lat) * np.sin(lon),
        ((1 - F_WGS84) ** 2 * N + h) * np.sin(lat),
    ])


def ecef_to_geodetic(x, y, z):
    """Bowring's method; sub-millimetre for terrestrial altitudes."""
    lon = np.arctan2(y, x)
    p = np.hypot(x, y)
    ep2 = (A_WGS84**2 - B_WGS84**2) / B_WGS84**2
    th = np.arctan2(A_WGS84 * z, B_WGS84 * p)
    lat = np.arctan2(z + ep2 * B_WGS84 * np.sin(th) ** 3,
                     p - E2 * A_WGS84 * np.cos(th) ** 3)
    N = A_WGS84 / np.sqrt(1 - E2 * np.sin(lat) ** 2)
    h = p / np.cos(lat) - N
    return np.degrees(lat), np.degrees(lon), h


def vincenty_inverse(lat1, lon1, lat2, lon2):
    """Geodesic distance (m) and forward azimuth (deg) on WGS-84."""
    L = np.radians(lon2 - lon1)
    U1 = np.arctan((1 - F_WGS84) * np.tan(np.radians(lat1)))
    U2 = np.arctan((1 - F_WGS84) * np.tan(np.radians(lat2)))
    sU1, cU1, sU2, cU2 = np.sin(U1), np.cos(U1), np.sin(U2), np.cos(U2)
    lam = L
    for _ in range(200):
        sl, cl = np.sin(lam), np.cos(lam)
        sin_sigma = np.hypot(cU2 * sl, cU1 * sU2 - sU1 * cU2 * cl)
        if sin_sigma == 0:
            return 0.0, 0.0
        cos_sigma = sU1 * sU2 + cU1 * cU2 * cl
        sigma = np.arctan2(sin_sigma, cos_sigma)
        sin_alpha = cU1 * cU2 * sl / sin_sigma
        cos2_alpha = 1 - sin_alpha**2
        cos2sm = cos_sigma - 2 * sU1 * sU2 / cos2_alpha if cos2_alpha != 0 else 0.0
        C = F_WGS84 / 16 * cos2_alpha * (4 + F_WGS84 * (4 - 3 * cos2_alpha))
        lam_prev = lam
        lam = L + (1 - C) * F_WGS84 * sin_alpha * (
            sigma + C * sin_sigma * (cos2sm + C * cos_sigma * (-1 + 2 * cos2sm**2))
        )
        if abs(lam - lam_prev) < 1e-14:
            break
    u2 = cos2_alpha * (A_WGS84**2 - B_WGS84**2) / B_WGS84**2
    Aa = 1 + u2 / 16384 * (4096 + u2 * (-768 + u2 * (320 - 175 * u2)))
    Bb = u2 / 1024 * (256 + u2 * (-128 + u2 * (74 - 47 * u2)))
    d_sigma = Bb * sin_sigma * (cos2sm + Bb / 4 * (
        cos_sigma * (-1 + 2 * cos2sm**2)
        - Bb / 6 * cos2sm * (-3 + 4 * sin_sigma**2) * (-3 + 4 * cos2sm**2)))
    s = B_WGS84 * Aa * (sigma - d_sigma)
    azi = np.degrees(np.arctan2(cU2 * np.sin(lam), cU1 * sU2 - sU1 * cU2 * np.cos(lam)))
    return s, azi


def ned_rotation(lat_deg, lon_deg):
    lat, lon = np.radians(lat_deg), np.radians(lon_deg)
    sl, cl, so, co = np.sin(lat), np.cos(lat), np.sin(lon), np.cos(lon)
    return np.array([
        [-sl * co, -sl * so,  cl],
        [-so,       co,       0.0],
        [-cl * co, -cl * so, -sl],
    ])


def ecef_to_ned_velocity(v_ecef, origin_ecef):
    lat0, lon0, _ = ecef_to_geodetic(*origin_ecef)
    return ned_rotation(lat0, lon0) @ v_ecef


def ecef_to_local_ned_hvuh(ecef_data, guide_ecef):
    """Mirror of NEXT_frame.ecef_to_local_ned_hvuh."""
    origin = ecef_data[0, 1:4]
    lat0, lon0, _ = ecef_to_geodetic(*origin)
    lat_g, lon_g, _ = ecef_to_geodetic(*guide_ecef)
    _, azi_g = vincenty_inverse(lat0, lon0, lat_g, lon_g)
    heading0 = np.radians(azi_g)

    out = np.empty((ecef_data.shape[0], 7))
    out[:, 0] = ecef_data[:, 0]
    for i, st in enumerate(ecef_data):
        lat, lon, hae = ecef_to_geodetic(*st[1:4])
        dist, azi = vincenty_inverse(lat0, lon0, lat, lon)
        vel_ned = ecef_to_ned_velocity(st[4:7], origin)
        north = dist * np.cos(np.radians(azi))
        east = dist * np.sin(np.radians(azi))
        out[i, 1] = north * np.cos(heading0) + east * np.sin(heading0)
        out[i, 2] = -north * np.sin(heading0) + east * np.cos(heading0)
        out[i, 3] = hae
        out[i, 4] = vel_ned[0] * np.cos(heading0) + vel_ned[1] * np.sin(heading0)
        out[i, 5] = -vel_ned[0] * np.sin(heading0) + vel_ned[1] * np.cos(heading0)
        out[i, 6] = -vel_ned[2]
    return out

# --- a realistic glide, integrated in ECEF -------------------------------
def simulate_ecef(lat0=25.0, lon0=120.0, h0=40000.0, speed=2200.0,
                  azimuth_deg=70.0, gamma_deg=0.0, T=900.0, dt=1.0,
                  beta=7000.0, ld=2.0):
    p = geodetic_to_ecef(lat0, lon0, h0)
    R = ned_rotation(lat0, lon0)
    az, ga = np.radians(azimuth_deg), np.radians(gamma_deg)
    v_ned = speed * np.array([np.cos(ga) * np.cos(az), np.cos(ga) * np.sin(az), -np.sin(ga)])
    v = R.T @ v_ned

    def acc(p, v):
        r = np.linalg.norm(p)
        g = -GM * p / r**3
        _, _, h = ecef_to_geodetic(*p)
        rho = 1.225 * np.exp(-max(h, 0.0) / 7200.0)
        sp = np.linalg.norm(v)
        drag = -(rho * sp / (2 * beta)) * v
        # lift perpendicular to velocity in the vertical plane, L/D = ld,
        # so the vehicle actually glides instead of ploughing in
        up = p / r
        vhat = v / sp
        perp = up - np.dot(up, vhat) * vhat
        n = np.linalg.norm(perp)
        lift = ld * np.linalg.norm(drag) * (perp / n) if n > 1e-9 else 0.0
        return g + drag + lift

    n = int(T / dt) + 1
    out = np.empty((n, 7))
    t = 0.0
    used = n
    for i in range(n):
        _, _, hh = ecef_to_geodetic(*p)
        if hh <= 0.0:            # stop at impact; below ground is not a trajectory
            used = i
            break
        out[i] = [t, *p, *v]
        k1v, k1a = v, acc(p, v)
        k2v, k2a = v + 0.5 * dt * k1a, acc(p + 0.5 * dt * k1v, v + 0.5 * dt * k1a)
        k3v, k3a = v + 0.5 * dt * k2a, acc(p + 0.5 * dt * k2v, v + 0.5 * dt * k2a)
        k4v, k4a = v + dt * k3a, acc(p + dt * k3v, v + dt * k3a)
        p = p + dt / 6 * (k1v + 2 * k2v + 2 * k3v + k4v)
        v = v + dt / 6 * (k1a + 2 * k2a + 2 * k3a + k4a)
        t += dt
    return out[:used]




def transport_correction_transliterated(F, Rt, Alt, VF, VR, VU):
    """Line-by-line mirror of the transport branch in GRUODEPredictorModel."""
    Re = 6371000.0
    p_h = np.stack([F, Rt], axis=1)
    alt = Alt[:, None]
    v_h = np.stack([VF, VR], axis=1)
    v_u = VU[:, None]

    dist = np.sqrt((p_h * p_h).sum(-1, keepdims=True) + EPS)
    u_hat = p_h / dist
    psi = dist / Re
    sin_p, cos_p = np.sin(psi), np.cos(psi)

    v_along = (v_h * u_hat).sum(-1, keepdims=True)
    v_local_along = v_along * cos_p - v_u * sin_p
    v_local_up = v_along * sin_p + v_u * cos_p
    ground_scale = Re / (Re + alt)

    dpos_h = (v_local_along * u_hat + (v_h - v_along * u_hat)) * ground_scale
    return np.concatenate([dpos_h, v_local_up], axis=1)


print("\nlned frame kinematics (WGS-84, realistic lifting glide)")
print("-" * 62)
_ecef = simulate_ecef(azimuth_deg=70.0)
