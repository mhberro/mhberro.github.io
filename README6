"""Do the lned identities dPos/dt = Vel actually hold at long range?

The lned transform resolves VELOCITY in the NED basis AT THE ORIGIN, but stores
ALTITUDE as true height above the ellipsoid, which follows Earth curvature. Over
a few hundred km those two conventions agree to within noise. Over thousands of
km they cannot: the local vertical at the far end is rotated substantially from
the origin's vertical.

This measures the disagreement as a function of downrange, using the same WGS-84
reimplementation used to validate the frame earlier.
"""
import numpy as np

A = 6378137.0; F = 1/298.257223563; E2 = F*(2-F)
TIME_INDEX = 0; POS_SLICE = slice(1,4); VEL_SLICE = slice(4,7)
d2r, r2d = np.deg2rad, np.rad2deg

def ecef_to_geodetic(x,y,z):
    lon=np.arctan2(y,x); p=np.hypot(x,y); lat=np.arctan2(z,p*(1-E2))
    for _ in range(200):
        N=A/np.sqrt(1-E2*np.sin(lat)**2); h=p/np.cos(lat)-N
        lat=np.arctan2(z,p*(1-E2*N/(N+h)))
    N=A/np.sqrt(1-E2*np.sin(lat)**2); h=p/np.cos(lat)-N
    return r2d(lat), r2d(lon), h

def geodetic_to_ecef(lat,lon,h):
    lat,lon=d2r(lat),d2r(lon); N=A/np.sqrt(1-E2*np.sin(lat)**2)
    return np.array([(N+h)*np.cos(lat)*np.cos(lon),(N+h)*np.cos(lat)*np.sin(lon),
                     (N*(1-E2)+h)*np.sin(lat)])

def _R(lat,lon):
    lat,lon=d2r(lat),d2r(lon); sl,cl,so,co=np.sin(lat),np.cos(lat),np.sin(lon),np.cos(lon)
    return np.array([[-sl*co,-sl*so,cl],[-so,co,0.],[-cl*co,-cl*so,-sl]])

def ecef_to_ned_velocity(v,origin):
    lat,lon,_=ecef_to_geodetic(*origin); return _R(lat,lon)@np.asarray(v)

def inverse_geodesic(lat0,lon0,lat,lon):
    R=6371008.8; p0,p1=d2r(lat0),d2r(lat); dl=d2r(lon-lon0); dp=p1-p0
    a=np.sin(dp/2)**2+np.cos(p0)*np.cos(p1)*np.sin(dl/2)**2
    dist=2*R*np.arcsin(np.sqrt(np.clip(a,0,1)))
    azi=r2d(np.arctan2(np.sin(dl)*np.cos(p1),np.cos(p0)*np.sin(p1)-np.sin(p0)*np.cos(p1)*np.cos(dl)))
    return dist,azi,None,None,None

def _heading(origin,guide):
    lat0,lon0,_=ecef_to_geodetic(*origin); lg,ng,_=ecef_to_geodetic(*guide)
    d,azi,_,_,_=inverse_geodesic(lat0,lon0,lg,ng)
    return d2r(azi)

def ecef_to_lned(ecef,guide):
    origin=ecef[0,POS_SLICE]; lat0,lon0,_=ecef_to_geodetic(*origin)
    h0=_heading(origin,guide)
    out=np.empty((len(ecef),7)); out[:,0]=ecef[:,0]
    for i,st in enumerate(ecef):
        lat,lon,hae=ecef_to_geodetic(*st[POS_SLICE])
        dist,azi,_,_,_=inverse_geodesic(lat0,lon0,lat,lon)
        vn=ecef_to_ned_velocity(st[VEL_SLICE],origin)   # <-- basis at ORIGIN
        n=dist*np.cos(d2r(azi)); e=dist*np.sin(d2r(azi))
        out[i,1]=n*np.cos(h0)+e*np.sin(h0); out[i,2]=-n*np.sin(h0)+e*np.cos(h0)
        out[i,3]=hae                                     # <-- true HAE (curved)
        out[i,4]=vn[0]*np.cos(h0)+vn[1]*np.sin(h0)
        out[i,5]=-vn[0]*np.sin(h0)+vn[1]*np.cos(h0)
        out[i,6]=-vn[2]
    return out

# --- build a long-range, high-altitude profile matching the user's ranges ----
dt=1.0; T=700
lat0,lon0=34.0,-117.0
rng_total_km=3841.0; hmax=110000.0; h0_=33846.0
R_E=6371008.8
ecef=np.zeros((T,7))
for i in range(T):
    f=i/(T-1)
    s=rng_total_km*1000.0*f                      # downrange arc length
    hae=h0_+(hmax-h0_)*np.sin(np.pi*f)**0.9      # lofted arc
    ang=s/R_E
    lat=lat0-r2d(ang)*0.8; lon=lon0+r2d(ang)*0.6
    ecef[i,0]=i*dt; ecef[i,POS_SLICE]=geodetic_to_ecef(lat,lon,hae)
for i in range(T):
    j=min(i+1,T-1); k=max(i-1,0)
    ecef[i,VEL_SLICE]=(ecef[j,POS_SLICE]-ecef[k,POS_SLICE])/max(ecef[j,0]-ecef[k,0],1e-9)
guide=ecef[-1,POS_SLICE]

L=ecef_to_lned(ecef,guide)
t=L[:,0]; F_,R_,ALT=L[:,1],L[:,2],L[:,3]; VF,VR,VU=L[:,4],L[:,5],L[:,6]

def d(x): return np.gradient(x,t)

print("Long-range lned identity check")
print(f"  downrange spans 0 .. {F_.max()/1000:.0f} km,  altitude {ALT.min()/1000:.1f} .. {ALT.max()/1000:.1f} km")
print(f"  central angle at far end: {r2d(F_.max()/R_E):.1f} deg of Earth curvature\n")

print(f"{'downrange km':>13s} {'|dF/dt - VF|':>13s} {'|dR/dt - VR|':>13s} {'|dALT/dt - VU|':>15s}")
for frac in [0.05,0.2,0.4,0.6,0.8,0.98]:
    i=int(frac*(T-1))
    print(f"{F_[i]/1000:13.0f} {abs(d(F_)[i]-VF[i]):13.2f} {abs(d(R_)[i]-VR[i]):13.2f} {abs(d(ALT)[i]-VU[i]):15.2f}")

sl=slice(3,-3)
print("\nRMS identity residual over the trajectory (m/s):")
print(f"  dForward/dt  vs VForward : {np.sqrt(np.mean((d(F_)[sl]-VF[sl])**2)):10.2f}")
print(f"  dRight/dt    vs VRight   : {np.sqrt(np.mean((d(R_)[sl]-VR[sl])**2)):10.2f}")
print(f"  dAltitude/dt vs VUp      : {np.sqrt(np.mean((d(ALT)[sl]-VU[sl])**2)):10.2f}")
print(f"\n  typical |v| = {np.sqrt(VF**2+VR**2+VU**2).mean():.0f} m/s")
