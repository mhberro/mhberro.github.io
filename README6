def _gruode_latent_dim(model_basename: str, state_size: int) -> int:
    """Recover the GRU-ODE / APHYNITY-GRU-ODE latent width from model filename."""
    m = re.findall(r"_(\d+)hid_", model_basename)
    if not m:
        return max(2 * state_size, 100)
    nhidden = int(m[-1])
    return max(2 * state_size, nhidden // 2 if nhidden >= 20 else 16)


_encoder_sess_stash = {}


def _load_encoder_session(model_path: str):
    """Load (and cache) companion `<model>_encoder.onnx` next to the field graph."""
    enc_path = re.sub(r"\.onnx$", "_encoder.onnx", model_path)
    if enc_path in _encoder_sess_stash:
        return _encoder_sess_stash[enc_path]
    if not os.path.exists(enc_path):
        raise FileNotFoundError(
            f"Continuous-time GRU models require an encoder graph to seed latent states, but "
            f"'{enc_path}' was not found. Ensure `<model>_encoder.onnx` exists alongside the model."
        )
    sess = onnxruntime.InferenceSession(enc_path)
    _encoder_sess_stash[enc_path] = sess
    return sess


def main():
    parser = argparse.ArgumentParser(description="Simulator for continuous-time trajectory models.")
    parser.add_argument(
        "truths",
        nargs="+",
        type=str,
        help="list of truth trajectory files to evaluate",
    )
    parser.add_argument("-o", dest="output", required=True, default=None, help="output directory")
    parser.add_argument("-m", dest="model", required=True, default=None, help="onnx model file")
    parser.add_argument(
        "-s",
        dest="scalar",
        required=True,
        default=None,
        help="path to pickled scaler or model output folder containing scalar",
    )
    parser.add_argument(
        "--sr-min",
        type=int,
        default=10000,
        help="minimum slant range cutoff [m]",
    )
    parser.add_argument(
        "--sr-max",
        type=int,
        default=150000000,
        help="maximum slant range cutoff [m]",
    )
    parser.add_argument(
        "--gruode",
        action="store_true",
        help="force continuous GRU-ODE / APHYNITY-GRU-ODE integration logic",
    )
    parser.add_argument(
        "--time-cutoff",
        type=float,
        default=None,
        help="absolute-time ceiling [s]",
    )
    parser.add_argument(
        "--sub-steps",
        type=int,
        default=4,
        help="RK4 sub-steps per training interval",
    )

    args = parser.parse_args()

    if args.sr_min >= args.sr_max:
        raise ValueError("sr-min must be strictly less than sr-max")
    if args.sub_steps <= 0:
        raise ValueError("--sub-steps must be positive")

    if not os.path.exists(args.model):
        raise ValueError(f"Model file not found at {args.model}")

    model_path = os.path.dirname(args.model)
    model_name = ".".join(os.path.basename(args.model).split(".")[:-1])

    if os.path.isdir(args.scalar):
        possible_scalar = os.path.join(args.scalar, f"{model_name}_scalar.pickle")
        if not os.path.exists(possible_scalar):
            base_model = re.sub(r"_\d+win_\d+stride", "", model_name)
            possible_scalar = os.path.join(args.scalar, f"{base_model}_scalar.pickle")
        args.scalar = possible_scalar

    train_test_split_file = os.path.join(model_path, model_name + "_train_test_split.json")
    train_test_trajs = None
    if os.path.exists(train_test_split_file):
        with open(train_test_split_file) as f:
            train_test_trajs = json.load(f)

    sim_many_truths(args, model_name, train_test_trajs)


def sim_many_truths(args, model_name, train_test_trajs):
    tgt_metric = []
    for p in args.truths:
        print("Running sim for", p, flush=True)
        t = sim_single_truth(p, args.output, args, model_name, train_test_trajs)
        if t is not None:
            tgt_metric.append(t)


def load_phase_guide_point(path_to_truth, truth):
    phase_dir = os.path.dirname(path_to_truth)
    target_dir = os.path.dirname(phase_dir)
    impact_path = os.path.join(target_dir, "impact", os.path.basename(path_to_truth))
    if os.path.exists(impact_path):
        try:
            impact_truth = load_single_truth(impact_path)
            return deepcopy(impact_truth[-1, POS_SLICE])
        except Exception as e:
            print(f"[warn] Could not load impact guide point {impact_path}: {e}")
    return deepcopy(truth[-1, POS_SLICE])


def sim_single_truth(path_to_truth, output, args, model_name, train_test_trajs):
    truth = load_single_truth(path_to_truth)
    guide_point_ecef = load_phase_guide_point(path_to_truth, truth)

    truth_states_sr_cut, trajs, truth_trajs = sim_ingress(truth, guide_point_ecef, args)

    truth_filename = os.path.basename(path_to_truth)
    if len(trajs) == 0:
        print(f"No extrapolations were created for {truth_filename}")
        return None

    if isinstance(truth_states_sr_cut, int) and truth_states_sr_cut == -1:
        print("Skipping invalid truth file", path_to_truth)
        return None

    s = f"{model_name}_{truth_filename}"

    if not os.path.exists(output):
        os.makedirs(output, exist_ok=True)
    plot_sim_result(
        truth_states_sr_cut,
        trajs,
        guide_point_ecef,
        args,
        train_test_trajs,
        model_name,
        traj_number=truth_filename,
        filename=s,
        save=True,
        show=False,
        output=output,
    )
    save_sim_result(output, trajs, truth_filename)
    try:
        traj_metric = calc_sim_metric(output, trajs, truth_trajs, truth_filename)
    except Exception:
        traj_metric = None
    return traj_metric


def calc_sim_metric(output, trajs, truth_trajs, truth_filename):
    ingress_metric = []
    for next_traj, truth_traj in zip(trajs, truth_trajs):
        ingress_metric.append(calc_sim_metric_for_one_pair(truth_traj, next_traj))
    return np.mean(ingress_metric)


def calc_sim_metric_for_one_pair(truth_traj, test_traj):
    t = truth_traj
    if len(truth_traj) != len(test_traj):
        reduction_factor = np.gcd(len(test_traj), len(truth_traj))
        t = resample_poly(
            truth_traj,
            len(test_traj) / reduction_factor,
            len(truth_traj) / reduction_factor,
            padtype="line",
        )
    return mean_absolute_error(t[:, POS_SLICE], test_traj[:, POS_SLICE])


