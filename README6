    _dt = 1.0
    _dpos = np.gradient(_l[:, 1:4], _dt, axis=0)
    _naive = _l[:, 4:7]
    _corr = transport_correction_transliterated(*[_l[:, j] for j in (1, 2, 3, 4, 5, 6)])
    _k = slice(3, -3)
    _en = np.abs(_dpos - _naive)[_k].max(axis=0)
    _ec = np.abs(_dpos - _corr)[_k].max(axis=0)
    _dn = abs(np.cumsum(_dpos[:, 2] - _naive[:, 2])[-3] * _dt) / 1000
    _dc = abs(np.cumsum(_dpos[:, 2] - _corr[:, 2])[-3] * _dt) / 1000
    print(f"  {_label} ({_l[:,1].max()/1000:.0f} km down-range, "
          f"{abs(_l[:,2]).max()/1000:.0f} km cross-track)")
    print(f"    naive     d(pos)/dt-vel  max: F {_en[0]:7.3f}  R {_en[1]:7.3f}  Alt {_en[2]:7.3f} m/s"
          f"  -> {_dn:6.2f} km altitude drift")
    print(f"    corrected                max: F {_ec[0]:7.3f}  R {_ec[1]:7.3f}  Alt {_ec[2]:7.3f} m/s"
          f"  -> {_dc:6.3f} km altitude drift")
    _ok = _ec.max() < 0.25 and _dc < 0.1
    all_ok &= _ok
    print(f"    [{'PASS' if _ok else 'FAIL'}] correction closes the frame-kinematics gap")

all_ok &= ok
print("\nALL TESTS PASSED" if all_ok else "\nSOME TESTS FAILED")
raise SystemExit(0 if all_ok else 1)
