# scaling.py
"""The scaled-space <-> physical-space contract for f_physics.

CONVENTION CHOSEN (stated explicitly, per the requirement):

    UNSCALE INSIDE forward, APPLY PHYSICS IN PHYSICAL UNITS, RESCALE THE RESULT.

That is, given a scaled state y_scaled as seen by the solver:

    y_phys   = y_scaled * scale_ + mean_          (StandardScaler inverse)
    f_phys   = f_physics(y_phys)                   [physical units, m/s^2 etc]
    f_scaled = f_phys / scale_                     (derivative transform)

The derivative transform has NO mean term. This is the easy place to get it
wrong: the inverse transform of a STATE includes +mean_, but the transform of a
TIME DERIVATIVE does not, because d/dt(mean_) = 0. A f_physics that adds
mean_/scale_ to xdot would inject a large constant drift into every row while
still "running" perfectly happily.

Why this convention rather than baking the scaling into the coefficients:
exp(-h/H) is nonlinear in h, so there is no exact linear reparameterisation of
the discovered coefficients into scaled space. Any attempt to pre-fold the
scaling would only be valid to first order around the scaler mean. Unscaling
inside forward is exact.

Cost: two elementwise multiplies per evaluation. Negligible, and both are
ONNX-exportable (no data-dependent control flow).
"""

from __future__ import annotations

import numpy as np


def unscale_state(y_scaled: np.ndarray, mean: np.ndarray, scale: np.ndarray) -> np.ndarray:
    """StandardScaler inverse for a STATE: y_phys = y*scale + mean."""
    return y_scaled * scale + mean


def scale_derivative(f_phys: np.ndarray, scale: np.ndarray) -> np.ndarray:
    """Transform a TIME DERIVATIVE into scaled space: f_scaled = f_phys/scale.

    NOTE: no mean term. See module docstring.
    """
    return f_phys / scale


def verify_scaling_roundtrip(mean, scale, rtol=1e-10):
    """Numerical check of the convention on a known analytic case.

    Uses the exact identity row ds/dt = v_s, which must hold in BOTH spaces:
        physical: ds/dt = v_s
        scaled  : ds_scaled/dt = v_s_phys / scale_s
                                = (v_s_scaled*scale_vs + mean_vs) / scale_s

    If a naive implementation forgot the mean on the state inverse, or wrongly
    added a mean to the derivative, this check fails loudly.
    """
    mean = np.asarray(mean, float)
    scale = np.asarray(scale, float)
    rng = np.random.default_rng(0)
    y_scaled = rng.normal(size=(64, 5))

    y_phys = unscale_state(y_scaled, mean, scale)

    # physical-space derivative for the identity rows only
    f_phys = np.zeros_like(y_phys)
    f_phys[:, 0] = y_phys[:, 2]  # ds/dt = v_s
    f_phys[:, 1] = y_phys[:, 4]  # dh/dt = v_h

    f_scaled = scale_derivative(f_phys, scale)

    expect_s = (y_scaled[:, 2] * scale[2] + mean[2]) / scale[0]
    expect_h = (y_scaled[:, 4] * scale[4] + mean[4]) / scale[1]

    err_s = float(np.max(np.abs(f_scaled[:, 0] - expect_s)))
    err_h = float(np.max(np.abs(f_scaled[:, 1] - expect_h)))
    ok = err_s <= rtol * max(1.0, np.abs(expect_s).max()) and \
         err_h <= rtol * max(1.0, np.abs(expect_h).max())
    if not ok:
        raise ValueError(
            f"scaling convention check FAILED: ds err {err_s:.3e}, dh err {err_h:.3e}"
        )
    return {"ds_err": err_s, "dh_err": err_h}


def demonstrate_mean_bug(mean, scale):
    """Show the magnitude of the error the mean-on-derivative bug would cause.

    Returned value is the spurious constant drift (in scaled units/s) that a
    buggy `f_scaled = (f_phys - mean)/scale` would inject. Reported so the user
    can see this is not a rounding-level concern.
    """
    mean = np.asarray(mean, float)
    scale = np.asarray(scale, float)
    return np.abs(mean / scale)
