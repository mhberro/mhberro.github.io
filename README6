# aphynity_loss.py
"""APHYNITY adaptive dual Lagrangian optimization wrapper."""

from __future__ import annotations

import torch
from torch import nn


class APHYNITYAdaptiveLossWrapper(nn.Module):
    """Adaptive Dual Multiplier loss enforcing the APHYNITY least-action constraint."""

    def __init__(
        self,
        base_criterion: nn.Module,
        lambda_init: float = 1.0,
        tau2: float = 5.0,
        max_lambda: float = 50.0,
        node_norm_weight: float = 1.0,
    ):
        """Adaptive dual multiplier for  min ||F_a||  s.t.  trajectory constraint.

        NOTE on scaling: the dual update is lambda += tau2 * L_traj, so a sensible
        tau2 depends entirely on the MAGNITUDE of L_traj. With L_traj ~ 4e-3
        (the regime once the loss is correctly scaled) the paper's tau2 in the
        0.1-100 range gives a gentle, useful ramp. With an inflated L_traj ~ 1.3
        the same tau2 pins lambda at its cap within a few epochs and training
        diverges. If you change the loss scale, re-check tau2.
        """
        super().__init__()
        self.base_criterion = base_criterion
        self.tau2 = float(tau2)
        self.max_lambda = float(max_lambda)
        self.lambda_init = float(lambda_init)
        self.node_norm_weight = float(node_norm_weight)
        self.register_buffer("lambda_val", torch.tensor(lambda_init, dtype=torch.float32))
        self.model_ref = None

    def set_model(self, model: nn.Module) -> None:
        self.model_ref = model
        if hasattr(self.base_criterion, "set_model"):
            self.base_criterion.set_model(model)

    def reset_lagrangian(self) -> None:
        """Resets dual multiplier at strategy phase boundaries."""
        with torch.no_grad():
            self.lambda_val.fill_(self.lambda_init)

    def forward(self, pred: torch.Tensor, target: torch.Tensor) -> dict[str, torch.Tensor]:
        metrics = self.base_criterion(pred, target)
        traj_loss = metrics["loss"]

        node_norm = torch.tensor(0.0, device=pred.device)
        if self.model_ref is not None:
            # pop_node_norm() returns the residual magnitude AGGREGATED over every
            # solver evaluation in this batch's rollout and resets the accumulator.
            # Plain attribute access would leave the accumulator growing across
            # batches (and, before accumulation existed, exposed only a single
            # sub-step sample).
            if hasattr(self.model_ref, "pop_node_norm"):
                node_norm = self.model_ref.pop_node_norm().to(pred.device)
            elif hasattr(self.model_ref, "last_node_norm"):
                node_norm = self.model_ref.last_node_norm.to(pred.device)

        # Dual Lagrangian formulation: L_total = node_norm + lambda * L_traj
        total_loss = self.node_norm_weight * node_norm + self.lambda_val * traj_loss

        out_metrics = dict(metrics)
        out_metrics["loss"] = total_loss
        out_metrics["traj_loss"] = traj_loss.detach()
        out_metrics["node_norm"] = node_norm.detach()
        out_metrics["lambda"] = self.lambda_val.detach()
        return out_metrics

    def update_lagrangian_multiplier(self, last_val_traj_loss: float) -> None:
        """Bounded adaptive update: lambda_{j+1} = min(max_lambda, lambda_j + tau2 * L_traj)"""
        with torch.no_grad():
            updated = self.lambda_val + self.tau2 * last_val_traj_loss
            self.lambda_val.copy_(torch.clamp(updated, max=self.max_lambda))
