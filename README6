def _sim_ingress_row_filter(truth_states, args, TIME_INDEX, VEL_SLICE):
    time_cutoff = getattr(args, "time_cutoff", None)
    if time_cutoff is None:
        rows = tuple(x for x in truth_states if not np.allclose(x[VEL_SLICE], [0, 0, 0]))
    else:
        rows = tuple(x for x in truth_states if x[TIME_INDEX] < time_cutoff and not np.allclose(x[VEL_SLICE], [0, 0, 0]))
    return np.asarray(rows, dtype=np.float64)


def sim_ingress(truth_states, guide_point_ecef, args):
    impact_ecef = deepcopy(guide_point_ecef)
    impact_time = truth_states[-1, 0]

    truth_states_sr_cut = _sim_ingress_row_filter(truth_states, args, TIME_INDEX, VEL_SLICE)

    if truth_states_sr_cut.shape[0] == 0:
        print("[skip] no moving truth rows below time cutoff")
        return -1, -1, -1

    firm_track_time = truth_states_sr_cut[0][0]
    sim_time = deepcopy(firm_track_time)
    trajs, truth_trajs = [], []

    while sim_time <= impact_time - measurement_dt:
        tgt_state_ecef_index = np.where(truth_states_sr_cut[:, 0] == sim_time)
        tgt_state_ecef_index_forward = np.where(truth_states_sr_cut[:, 0] >= sim_time)
        if len(tgt_state_ecef_index[0]) == 0:
            try:
                tgt_state_ecef_index = np.array(tgt_state_ecef_index_forward[0][0])
            except IndexError:
                return truth_states_sr_cut, trajs, truth_trajs
            sim_time = truth_states_sr_cut[tgt_state_ecef_index].squeeze()[0]
        tgt_state_ecef = truth_states_sr_cut[tgt_state_ecef_index]
        truth_traj_forward = truth_states_sr_cut[tgt_state_ecef_index_forward]

        x0 = tgt_state_ecef.squeeze()
        traj = NEXT_tactical_interface(x0[0:7], impact_ecef, extrapolation_dt, max_traj_states, impact_time, args)
        if traj is not None:
            if isinstance(traj, int) and traj == -1:
                break
            trajs.append(traj)
            truth_trajs.append(truth_traj_forward)
        sim_time += measurement_dt
    return truth_states_sr_cut, trajs, truth_trajs


def bound(low, high, x):
    return max(low, min(high, x))


def round_to(x, base):
    return base * round(x / base)


ort_sess_stash = None


def NEXT_tactical_interface(initial_state_ecef, guide_point_ecef, dt, n_steps, extrap_stop_time, args):
    initial_state_slant_range = np.linalg.norm(initial_state_ecef[POS_SLICE] - guide_point_ecef)
    if initial_state_slant_range < args.sr_min:
        print("Target too close", initial_state_slant_range, args.sr_min)
        return -1

    model_basename = os.path.basename(args.model)
    use_obsgeo = "_obsgeo_" in model_basename
    use_grdth = "_grdth_" in model_basename
    use_geodesic = (
        ("_geodesic_" in model_basename)
        or ("_geod_" in model_basename)
        or ("_geodesic-integrated_" in model_basename)
        or ("_geodesic-original_" in model_basename)
    )
    use_geodesic_integrated = (
        ("_geodesic-integrated_" in model_basename)
        or (getattr(args, "frame", "") == "geodesic" and getattr(args, "geodesic_mode", "") == "integrated")
    )

    global ort_sess_stash
    if use_grdth:
        initial_state_NEXT_frame, initial_point_heading = ecef_to_next_grdth(initial_state_ecef, guide_point_ecef)
        initial_state_slant_range = np.hypot(initial_state_NEXT_frame[GR_INDEX], initial_state_NEXT_frame[DOWN_INDEX])
        if not ort_sess_stash:
            ort_sess_stash = onnxruntime.InferenceSession(args.model)
        ort_sess = ort_sess_stash
    elif use_obsgeo:
        initial_point_heading = 0.0
        if not ort_sess_stash:
            ort_sess_stash = onnxruntime.InferenceSession(args.model)
        ort_sess = ort_sess_stash
        initial_state_NEXT_frame = initial_state_ecef
    elif use_geodesic:
        _, initial_point_heading = ecef_to_next_grdth(initial_state_ecef, guide_point_ecef)
        if use_geodesic_integrated:
            state5, initial_azimuth = ecef_to_local_geodesic_vec_frame_trick(
                np.atleast_2d(initial_state_ecef[POS_SLICE]),
                np.atleast_2d(initial_state_ecef[VEL_SLICE]),
                guide_point_ecef,
            )
            state5 = np.atleast_2d(state5)[0]  # (5,)
            initial_state_NEXT_frame = np.hstack([np.atleast_1d(initial_state_ecef[TIME_INDEX]), state5])  # (6,) = time + 5
            initial_state_slant_range = np.hypot(initial_state_NEXT_frame[1], initial_state_NEXT_frame[2])
            initial_point_heading = (initial_point_heading, float(np.ravel(initial_azimuth)[0]))
        else:
            initial_state_NEXT_frame = ecef_to_local_geodesic_vec(
                np.atleast_2d(initial_state_ecef[POS_SLICE]),
                np.atleast_2d(initial_state_ecef[VEL_SLICE]),
                np.zeros_like(np.atleast_2d(initial_state_ecef[VEL_SLICE])),
                guide_point_ecef,
            )
            initial_state_NEXT_frame = np.hstack(
                [np.atleast_2d(initial_state_ecef[TIME_INDEX]), initial_state_NEXT_frame[:, :6]]
            )[0]
            initial_state_slant_range = np.linalg.norm(initial_state_NEXT_frame[POS_SLICE])

        if not ort_sess_stash:
            ort_sess_stash = onnxruntime.InferenceSession(args.model)
        ort_sess = ort_sess_stash
    else:
        initial_state_NEXT_frame, initial_point_heading, flip_c = ecef_to_next_dcu(initial_state_ecef, guide_point_ecef)
        initial_state_slant_range = np.linalg.norm(initial_state_NEXT_frame[POS_SLICE])
        bucket_range = 100000
        rounded_sr = int(bound(bucket_range, args.sr_max, round_to(initial_state_slant_range, bucket_range)) / 1e3)
        model_name_to_load = re.sub(r"_\d{1,3}sr_", f"_{rounded_sr}sr_", args.model)
        ort_sess = onnxruntime.InferenceSession(model_name_to_load)

    try:
        NEXT_extrap = NEXT_extrapolation(
            initial_state_NEXT_frame,
            dt,
            n_steps,
            extrap_stop_time,
            initial_point_heading,
            use_grdth,
            args,
            ort_sess,
            use_geodesic=use_geodesic,
            use_obsgeo=use_obsgeo,
        )
    except ValueError as e:
        print("Extrap failed", traceback.format_exc())
        return None

    if use_grdth:
        NEXT_extrap_ecef = next_grdth_to_ecef(NEXT_extrap, guide_point_ecef, initial_point_heading)
    elif use_obsgeo:
        NEXT_extrap_ecef = NEXT_extrap
    elif use_geodesic:
        if use_geodesic_integrated:
            heading, init_az = initial_point_heading
            ecef_pos_vel = local_geodesic_to_ecef_vec_frame_trick(
                NEXT_extrap[:, 0:6], guide_point_ecef, init_az
            )
            NEXT_extrap_ecef = np.hstack([NEXT_extrap[:, TIME_INDEX][..., np.newaxis], ecef_pos_vel])[:, :7]
        else:
            NEXT_extrap_ecef = np.hstack(
                [
                    NEXT_extrap[:, TIME_INDEX][..., np.newaxis],
                    local_geodesic_to_ecef_vec(
                        np.hstack([NEXT_extrap[:, 1:], np.zeros_like(NEXT_extrap[:, VEL_SLICE])]),
                        guide_point_ecef,
                    ),
                ],
            )[:, :7]
    else:
        NEXT_extrap_ecef = next_dcu_to_ecef(NEXT_extrap, guide_point_ecef, initial_point_heading, flip_c)

    a = np.gradient(NEXT_extrap_ecef[:, VEL_SLICE], axis=0)
    NEXT_extrap_ecef = np.hstack([NEXT_extrap_ecef, a])
    return NEXT_extrap_ecef


def _infer_training_dt(model_basename: str, default: float = 0.1) -> float:
    m = re.findall(r"_([0-9]*\.?[0-9]+)sec_", model_basename)
    if m:
        try:
            return float(m[-1])
        except ValueError:
            pass
    return default


def _field_eval(ort_sess, state_full_scaled, state_size):
    out = ort_sess.run(["output"], {"input": state_full_scaled.astype(np.float32)})[-1].reshape(-1)
    return out


def _integrate_one_step(
    ort_sess,
    x_full_scaled,
    out_dt: float,
    sub_dt: float,
    integrator: str,
    state_size: int,
):
    n_sub = max(1, int(round(out_dt / sub_dt)))
    h_step = out_dt / n_sub

    x = np.asarray(x_full_scaled, dtype=np.float64).reshape(-1).copy()

    def f(state_full):
        return _field_eval(ort_sess, state_full, state_size)

    for _ in range(n_sub):
        if integrator == "euler":
            x = x + h_step * f(x)
        else:  # rk4
            k1 = f(x)
            k2 = f(x + 0.5 * h_step * k1)
            k3 = f(x + 0.5 * h_step * k2)
            k4 = f(x + h_step * k3)
            x = x + (h_step / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
    return x


def NEXT_extrapolation(
    initial_state_next_frame,
    dt: float,
    n_steps: int,
    extrap_stop_time: float,
    ref_angle,
    use_grdth: bool,
    args,
    ort_sess: onnxruntime.InferenceSession,
    use_geodesic: bool = False,
    use_obsgeo: bool = False,
):
    model_basename = os.path.basename(args.model)
    use_geodesic_integrated = (
        ("_geodesic-integrated_" in model_basename)
        or (getattr(args, "frame", "") == "geodesic" and getattr(args, "geodesic_mode", "") == "integrated")
    )
    is_gruode = (
        getattr(args, "gruode", False)
        or ("_gruode_" in model_basename)
        or ("_gruode-min_" in model_basename)
        or ("_aphynity-gruode_" in model_basename)
    )

    use_scalar = "_scalarOn" in model_basename
    NEXT_scalar = None
    if use_scalar:
        scalar_path = args.scalar
        if not os.path.exists(scalar_path):
            clean_basename = re.sub(r"\.onnx$", "", model_basename)
            scalar_path = os.path.join(os.path.dirname(args.model), f"{clean_basename}_scalar.pickle")
        with open(scalar_path, "rb") as scalar_pickle:
            NEXT_scalar = pickle.load(scalar_pickle)

    if is_gruode:
        enc_sess = _load_encoder_session(args.model)
        enc_in_shape = enc_sess.get_inputs()[0].shape
        state_size = int([d for d in enc_in_shape if isinstance(d, int)][-1])
        integrator = "rk4"

        sub_dt = _infer_training_dt(model_basename, default=0.1) / max(1, int(getattr(args, "sub_steps", 4)))
        latent_dim = _gruode_latent_dim(model_basename, state_size)
        aug_width = latent_dim
        print(
            f"Continuous GRU Model Detected: RK4 sub-step ~{sub_dt}s over dt {dt}s; "
            f"state_size={state_size}, latent_dim={latent_dim}; seeding h0 from encoder graph"
        )
    else:
        state_size = 5 if use_grdth else 6
        integrator = "euler"
        sub_dt = dt
        aug_match = re.findall(r"_(\d+)aug_", args.model)
        aug_width = int(aug_match[-1]) if aug_match else 0
        enc_sess = None

    extrap = np.array([np.hstack([initial_state_next_frame])])
    validity_time = deepcopy(initial_state_next_frame[0])

    y0_phys = np.asarray(extrap[-1][1 : state_size + 1], dtype=np.float64)
    if use_scalar and NEXT_scalar is not None:
        y0_seed = NEXT_scalar.transform(np.asarray([y0_phys]))[0]
    else:
        y0_seed = y0_phys

    if is_gruode:
        h_current = enc_sess.run(
            ["h0"], {"y0": y0_seed.astype(np.float32).reshape(-1)}
        )[-1].reshape(-1)
        if h_current.shape[0] != latent_dim:
            raise ValueError(
                f"Encoder produced h0 of width {h_current.shape[0]} but model expected latent_dim={latent_dim}."
            )
    else:
        h_current = np.zeros(aug_width, dtype=np.float64)

    temp_iter = 0
    _stop = float(extrap_stop_time)
    _abs_cut = getattr(args, "time_cutoff", None)
    if _abs_cut is not None:
        _stop = min(_stop, float(_abs_cut))

    while temp_iter < n_steps and float(validity_time) < _stop:
        temp_iter += 1
        validity_time += dt

        cur_phys = np.asarray(extrap[-1][1 : state_size + 1], dtype=np.float64)

        if use_scalar and NEXT_scalar is not None:
            cur_scaled = NEXT_scalar.transform(np.asarray([cur_phys]))[0]
        else:
            cur_scaled = cur_phys

        x_full = np.concatenate([cur_scaled, h_current])

        next_full = _integrate_one_step(
            ort_sess,
            x_full,
            out_dt=dt,
            sub_dt=sub_dt,
            integrator=integrator,
            state_size=state_size,
        )

        next_scaled = next_full[:state_size]
        h_current = next_full[state_size : state_size + aug_width]

        if use_scalar and NEXT_scalar is not None:
            next_state = NEXT_scalar.inverse_transform(next_scaled.reshape(1, -1))
        else:
            next_state = next_scaled.reshape(1, -1)

        next_state = np.insert(next_state, 0, validity_time)

        if use_grdth and (next_state[DOWN_INDEX + 1] > 0 or next_state[GR_INDEX + 1] < 2600e3):
            print("grdth below ground")
            break
        elif use_geodesic:
            if use_geodesic_integrated and next_state[2] <= 0.0:  # Altitude h <= 0
                print("geodesic impact reached ground")
                break
            if not np.all(np.isfinite(next_state[1:6])):
                print("geodesic trajectory diverged")
                break

        extrap = np.vstack([extrap, next_state])

    if extrap.shape[0] < 3:
        raise ValueError(f"Extrapolation output was too short ({extrap.shape[0]} states)")

    return extrap


