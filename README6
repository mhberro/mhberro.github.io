# =========================================================================
# 2-4. Invariants, OOD behaviour, robustness
# =========================================================================



def _random_states(fs, n, alt_lo, alt_hi, spd):
    x = np.zeros((n, fs.n_features))
    x[:, fs.height_idx] = rng.uniform(alt_lo, alt_hi, n)
    for i in fs.horiz_pos_idx:
        x[:, i] = rng.uniform(-2e5, 2e5, n)
    for c, i in enumerate(fs.phys_vel_idx):
        x[:, i] = rng.uniform(-spd, spd, n)
    return x


def check(name, ok, detail=""):
    print(f"  [{'PASS' if ok else 'FAIL'}] {name}" + (f"  {detail}" if detail else ""))
    return ok


rng = np.random.default_rng(0)
all_ok = True
for frame, mode, alt_ref in (("geodesic", "integrated", 0.0), ("lned", "", 0.0)):
    fs = sp.frame_spec_for(frame, geodesic_mode=mode or "integrated", alt_ref_m=alt_ref)
    names = fs.term_names()
    print(f"\n{fs.name}")
    print("-" * 62)

    # ---- 1. Lift is exactly zero-work, at every state including OOD ones ----
    x = _random_states(fs, 4000, -60_000, 120_000, 6000.0)
    A = sp.build_terms(x, fs, 7200.0)
    v = x[:, list(fs.phys_vel_idx)]
    lift = A[:, :, names.index(sp.TERM_LIFT)]
    power = np.sum(lift * v, axis=1)
    scale = np.maximum(np.linalg.norm(lift, axis=1) * np.linalg.norm(v, axis=1), 1e-12)
    all_ok &= check("lift does zero work (a.v == 0) everywhere",
                    np.max(np.abs(power) / scale) < 1e-10,
                    f"max relative power {np.max(np.abs(power)/scale):.2e}")

    # ---- 2. Drag always dissipates, at every state including OOD ones ----
    drag = A[:, :, names.index(sp.TERM_DRAG)]
    dpow = np.sum(drag * v, axis=1)
    all_ok &= check("drag never adds energy (a.v <= 0) everywhere",
                    np.all(dpow <= 1e-9),
                    f"max power {dpow.max():.2e}")

    # ---- 3. Lower altitude => stronger drag (the extrapolation property) ----
    xs = np.zeros((2, fs.n_features))
    xs[:, fs.height_idx] = [30_000.0, 5_000.0]
    xs[:, fs.phys_vel_idx[0]] = 2000.0
    dA = 8.75e-5 * sp.build_terms(xs, fs, 7200.0)[:, :, names.index(sp.TERM_DRAG)]
    lo, hi = np.linalg.norm(dA[0]), np.linalg.norm(dA[1])
    all_ok &= check("drag increases monotonically as altitude falls",
                    hi > lo * 10, f"|a| {lo:.3f} -> {hi:.3f} m/s^2")

    # ---- 4. Density is bounded below ground: no numerical explosion ----
    xs = np.zeros((3, fs.n_features))
    xs[:, fs.height_idx] = [-10_000.0, -100_000.0, -1e6]
    xs[:, fs.phys_vel_idx[0]] = 3000.0
    # Check the acceleration actually applied, i.e. with the fitted coefficient.
    dA = 8.75e-5 * sp.build_terms(xs, fs, 7200.0)[:, :, names.index(sp.TERM_DRAG)]
    peak = np.max(np.abs(dA))
    all_ok &= check("below-ground states stay finite and solver-tractable",
                    np.all(np.isfinite(dA)) and peak < 1e4,
                    f"peak |a| {peak:.0f} m/s^2 = {peak/9.81:.0f} g (density saturated)")

    # ---- 5. The OOD failure mode itself: fast + low => strong deceleration ----
    # Prior work: extrapolations gain energy, exceed launch speed, fly below
    # ground. Check the physics term opposes exactly that.
    xs = np.zeros((1, fs.n_features))
    xs[0, fs.height_idx] = 2_000.0
    xs[0, fs.phys_vel_idx[fs.horiz_vel_local[0]]] = 8000.0   # far above launch speed
    A5 = sp.build_terms(xs, fs, 7200.0)
    kd, kl = 8.75e-5, 1.75e-4
    coef = np.array([kd if n == sp.TERM_DRAG else kl if n == sp.TERM_LIFT else 1.0
                     for n in names])
    acc = A5[0] @ coef
    v5 = xs[0, list(fs.phys_vel_idx)]
    all_ok &= check("runaway-speed state is decelerated, not accelerated",
                    float(acc @ v5) < 0,
                    f"dE/dt = {float(acc @ v5):.3e} J/kg/s")

