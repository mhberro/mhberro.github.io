# ------------------------------------------------------------
# Missile‑Guidance function add‑on for pySINDy
# ------------------------------------------------------------
# All functions accept the *same* state vector:
#     s = [x, y, z, vx, vy, vz]       # ownship (missile) Cartesian state
# They return a 3‑vector acceleration (a_x, a_y, a_z) that would be
# added to the missile’s equations of motion.
# ------------------------------------------------------------
import numpy as np
from numpy.linalg import norm
# ------------------------------------------------------------------
# Helper utilities (shared by many missile laws)
# ------------------------------------------------------------------
def los_vector(s_target, s_own):
    r = s_target[:3] - s_own[:3]
    return r / norm(r)
def los_rate(s_target, s_own):
    r = s_target[:3] - s_own[:3]
    v_rel = s_target[3:6] - s_own[3:6]
    return np.cross(r, v_rel) / (norm(r) ** 2)
def closing_velocity(s_target, s_own):
    """Positive when missile is closing on target."""
    lam = los_vector(s_target, s_own)
    v_rel = s_target[3:6] - s_own[3:6]
    return -np.dot(v_rel, lam)      # Vc > 0 ⇒ closing
# ------------------------------------------------------------------
# 1) Classical Proportional Navigation (PN) – baseline
# ------------------------------------------------------------------
def pn_basic(s_own, s_target, N=4.0):
    """
    a = N * Vc * (λ̇ × λ̂)
    """
    lam = los_vector(s_target, s_own)
    lam_dot = los_rate(s_target, s_own)
    Vc = closing_velocity(s_target, s_own)
    # λ̇ is a vector; the cross product yields a vector orthogonal to LOS
    a = N * Vc * np.cross(lam_dot, lam)
    return a
# ------------------------------------------------------------------
# 2) Augmented PN (APN) – bias term to counteract target manoeuvres
# ------------------------------------------------------------------
def pn_augmented(s_own, s_target, N=4.5, k_bias=0.15):
    """
    a = N * Vc * (λ̇ × λ̂) + k_bias * λ̂
    The bias term provides a small “lead” that helps when the target
    performs a sudden turn.
    """
    a = pn_basic(s_own, s_target, N=N)
    lam = los_vector(s_target, s_own)
    a += k_bias * lam
    return a
# ------------------------------------------------------------------
# 3) True‑Line‑of‑Sight (TLOS) – retain a constant LOS angle
# ------------------------------------------------------------------
def tlos(s_own, s_target, k_tlos=0.6):
    """
    a = -k_tlos * (λ̇ ⟂ λ̂) * Vc * λ̂
    The term (λ̇ ⟂ λ̂) is the component of LOS rate orthogonal to LOS.
    """
    lam = los_vector(s_target, s_own)
    lam_dot = los_rate(s_target, s_own)
    # Remove component parallel to λ̂
    lam_dot_perp = lam_dot - np.dot(lam_dot, lam) * lam
    Vc = closing_velocity(s_target, s_own)
    a = -k_tlos * norm(lam_dot_perp) * Vc * lam
    return a
# ------------------------------------------------------------------
# 4) Constant‑Bearing (CB) – zero bearing‑rate law
# ------------------------------------------------------------------
def constant_bearing(s_own, s_target, k_cb=0.5):
    """
    a = -k_cb * ω_b * Vc * λ̂
    where ω_b is the magnitude of bearing‑rate (the orthogonal part of λ̇).
    """
    lam = los_vector(s_target, s_own)
    lam_dot = los_rate(s_target, s_own)
    # Bearing‑rate magnitude (same as |λ̇_perp|)
    bearing_rate = norm(lam_dot - np.dot(lam_dot, lam) * lam)
    Vc = closing_velocity(s_target, s_own)
    return -k_cb * bearing_rate * Vc * lam
# ------------------------------------------------------------------
# 5) Lead‑Angle Guidance (LA) – fixed lead ahead of LOS
# ------------------------------------------------------------------
def lead_angle(s_own, s_target, psi_lead=np.radians(12), k_la=0.35):
    """
    Rotate the LOS unit vector by a constant lead angle ψ_lead
    in the LOS‑plane and accelerate toward that rotated direction.
    """
    lam = los_vector(s_target, s_own)
    # Choose a reference direction that is not colinear with lam.
    ref = np.array([1.0, 0.0, 0.0])
    if np.allclose(np.cross(lam, ref), 0.0):
        ref = np.array([0.0, 1.0, 0.0])
    axis = np.cross(lam, ref)
    axis = axis / norm(axis)
    # Rodrigues rotation
    c = np.cos(psi_lead)
    s = np.sin(psi_lead)
    lam_lead = (c * lam +
                s * np.cross(axis, lam) +
                (1 - c) * np.dot(lam, axis) * axis)
    return k_la * lam_lead
# ------------------------------------------------------------------
# 6) Zero‑Effort‑Miss (ZEM) / Zero‑Effort‑Velocity (ZEV)
# ------------------------------------------------------------------
def zem_zev(s_own, s_target, t_go=4.0, k_zem=1.0):
    """
    a = -2 (r + v_rel·t_go) / t_go²
    where r = target – missile position, v_rel = target – missile velocity.
    """
    r = s_target[:3] - s_own[:3]
    v_rel = s_target[3:6] - s_own[3:6]
    a = -2.0 * (r + v_rel * t_go) / (t_go ** 2)
    return k_zem * a
# ------------------------------------------------------------------
# 7) Integrated Guidance (IG) – combines PN with a line‑of‑sight rate
#    filter; useful when sensor noise is high.
# ------------------------------------------------------------------
def integrated_guidance(s_own, s_target,
                       N=4.0, tau=0.3, k_i=0.1, state=None):
    """
    Implements a first‑order low‑pass filter on LOS rate:
        λ̇_f = ( -λ̇_f + λ̇ ) / τ
    The returned acceleration:
        a = N * Vc * ( λ̇_f × λ̂ ) + k_i * ∫λ̇_f dt
    `state` is a mutable dict that stores λ̇_f and the integral term.
    It must be supplied by the caller (e.g., the integration loop) so that
    the filter can retain memory between successive calls.
    """
    if state is None:
        raise ValueError("IG requires a mutable state dict (e.g., {'lam_dot_f':np.zeros(3), 'int':np.zeros(3)})")
    lam = los_vector(s_target, s_own)
    lam_dot = los_rate(s_target, s_own)
    Vc = closing_velocity(s_target, s_own)
    # First‑order filter update (explicit Euler)
    lam_dot_f = state["lam_dot_f"]
    lam_dot_f[:] = lam_dot_f + (-lam_dot_f + lam_dot) * (1.0 / tau)
    # Integral update
    state["int"][:] = state["int"] + lam_dot_f * (1.0 / tau)   # dt≈1/τ for simplicity
    a = N * Vc * np.cross(lam_dot_f, lam) + k_i * state["int"]
    return a
