#FROM python:3.11-windowsservercore
#FROM mcr.microsoft.com/windows/servercore:ltsc2022
FROM python:3.11-windowsservercore-ltsc2022
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY requirements.txt .
COPY packages/ ./packages/
RUN pip install --no-index --find-links=./packages -r requirements.txt
COPY src/ ./src/
COPY data/ ./data/
RUN powershell -Command New-Item -ItemType Directory -Path C:\logs
RUN powershell -Command New-Item -ItemType Directory -Force -Path C:\app\logs
RUN powershell -Command New-Item -ItemType Directory -Force -Path C:\app\reports
ENTRYPOINT ["python", "src/nbf_anomaly_detection.py"]
