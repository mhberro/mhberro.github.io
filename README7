# eom_library.py
"""Parametric Equations-of-Motion (EOM) basis for the physics backbone.

The idea
--------
SINDy exists to discover *unknown structure*. But the structure of atmospheric
glide flight is not unknown -- it is textbook 3-DoF point-mass physics: gravity,
aerodynamic drag along the velocity vector, aerodynamic lift perpendicular to it,
and geometric curvature terms. What is genuinely unknown for a given threat is a
handful of AERODYNAMIC COEFFICIENTS (C_D*A/m, C_L*A/m and their lateral analogue).

Asking a sparse-regression search to rediscover Newton from ~22 noisy flights is
badly under-determined: it invents non-physical positive-feedback terms (h*h, s*s)
that fit one step and destroy the rollout. This module instead writes the known
force laws down and leaves only the unknown coefficients free.

The crucial property that makes this a drop-in: the EOM are **linear in the unknown
coefficients**, so the same `stridge` / ensemble machinery and the same standalone
rollout evaluation work unchanged -- only the candidate columns differ. Instead of
~85 polynomial columns we offer ~6 physically-derived ones.

Basis columns (all evaluated in PHYSICAL units, then normalised)
---------------------------------------------------------------
With V = sqrt(v_s^2 + v_h^2), dynamic-pressure-like factor q = 0.5*rho(h)*V^2 and
rho(h) = exp(-h/H):

  drag_s   = -q * v_s / V        (drag, along-track component)   -> coeff k_D
  drag_h   = -q * v_h / V        (drag, vertical component)      -> coeff k_D
  lift_s   = +q * v_h / V        (in-plane lift, along-track)    -> coeff k_L
  lift_h   = -q * v_s / V        (in-plane lift, vertical)       -> coeff k_L
  lat_aero =  q                  (lateral/bank force -> turn rate) -> coeff k_lat
  gravity  = -g0*(Re/(Re+h))^2   (gravity, vertical)             -> coeff ~1 (fixed form)
  curv     = +v_s^2/(Re+h)       (centrifugal/curvature, vertical) -> coeff ~1
  bias     =  1                  (small constant offset / trim)

Every column is a genuine force term. There is no term whose magnitude grows with
POSITION in a way that feeds back on itself, so a fitted model is structurally
incapable of the runaway that the polynomial library produced.
"""

from __future__ import annotations

import numpy as np

EARTH_RADIUS_M = 6371000.0
G0 = 9.80665
_V_EPS = 1e-9
_EXP_ARG_MAX = 10.0


class EOMLibrary:
    """Physically-derived candidate columns for glide-phase equations of motion."""

    def __init__(
        self,
        state_vector_len: int = 5,
        h_idx: int = 1,
        vs_idx: int = 2,
        va_idx: int = 3,
        vh_idx: int = 4,
        scale_heights: tuple[float, ...] = (7200.0,),
        earth_radius: float = EARTH_RADIUS_M,
        feature_mean=None,
        feature_scale=None,
        include_bias: bool = True,
        include_linear_velocity: bool = True,
        clip: float = 8.0,
        # kept for interface compatibility with the other libraries
        degree: int = 2,
        pos_idx=(0, 1),
        vel_idx=(2, 4),
        poly_mode: str = "eom",
    ):
        self.state_vector_len = state_vector_len
        self.h_idx, self.vs_idx, self.va_idx, self.vh_idx = h_idx, vs_idx, va_idx, vh_idx
        self.scale_heights = tuple(float(H) for H in scale_heights)
        self.earth_radius = float(earth_radius)
        self.include_bias = bool(include_bias)
        # A small linear-in-velocity block lets the fit absorb mild unmodelled damping
        # without introducing any position dependence (hence no feedback risk).
        self.include_linear_velocity = bool(include_linear_velocity)
        self.clip = float(clip)
        self.feature_mean = None if feature_mean is None else np.asarray(feature_mean, float)
        self.feature_scale = None if feature_scale is None else np.asarray(feature_scale, float)
        self.col_scale_ = None  # frozen normalisation, set on first fit_transform
        self.pos_idx = tuple(int(i) for i in pos_idx)
        self.vel_idx = tuple(int(i) for i in vel_idx)

        # (name, kind, scale_height_or_None)
        self.terms: list[tuple[str, str, float | None]] = []
        if self.include_bias:
            self.terms.append(("1", "bias", None))
        self.terms.append(("gravity", "gravity", None))
        self.terms.append(("curv_vs2", "curv", None))
        for H in self.scale_heights:
            # IMPORTANT -- avoid degenerate columns. In the in-plane 3-DoF form,
            # drag_s = -q*v_s/V and lift_h = -q*v_s/V are the SAME column, and
            # drag_h = -q*v_h/V is the negative of lift_s. Offering all four makes the
            # regression rank-deficient: coefficients split arbitrarily between exact
            # duplicates (observed as identical coefficients on paired terms). Offer
            # only the two independent in-plane aero directions, plus the lateral term.
            self.terms.append((f"aero_along@H={int(H)}", "drag_s", H))   # ~ -q*v_s/V
            self.terms.append((f"aero_vert@H={int(H)}", "drag_h", H))    # ~ -q*v_h/V
            self.terms.append((f"aero_q@H={int(H)}", "lat_aero", H))     # ~  q (bank/lateral)
        if self.include_linear_velocity:
            # v_s is nearly collinear with the aero columns on glide data (both track
            # speed), so it is excluded; v_h and v_al add independent information.
            self.terms.append(("v_h", "lin_vh", None))
            self.terms.append(("v_al", "lin_va", None))

    # ------------------------------------------------------------- interface

    def term_names(self) -> list[str]:
        return [t[0] for t in self.terms]

    def term_combos(self, n_features: int | None = None) -> list:
        """Bias reported as the empty tuple so callers can locate it; rest opaque."""
        return [() if t[1] == "bias" else None for t in self.terms]

    @property
    def n_terms(self) -> int:
        return len(self.terms)

    def library_spec(self) -> dict:
        return {
            "kind": "eom",
            "state_vector_len": self.state_vector_len,
            "terms": [(n, k, H) for (n, k, H) in self.terms],
            "h_idx": self.h_idx, "vs_idx": self.vs_idx,
            "va_idx": self.va_idx, "vh_idx": self.vh_idx,
            "earth_radius": self.earth_radius,
            "feature_mean": None if self.feature_mean is None else self.feature_mean.tolist(),
            "feature_scale": None if self.feature_scale is None else self.feature_scale.tolist(),
            "clip": self.clip,
            "col_scale": None if self.col_scale_ is None else list(self.col_scale_),
            "poly_combos": [],
            "physics_terms": [],
        }

    # ------------------------------------------------------------ evaluation

    def _to_physical(self, Y: np.ndarray) -> np.ndarray:
        if self.feature_mean is None or self.feature_scale is None:
            return Y
        return Y * self.feature_scale + self.feature_mean

    def fit_transform(self, Y: np.ndarray) -> np.ndarray:
        n = Y.shape[0]
        P = self._to_physical(Y)
        h = P[:, self.h_idx]
        vs = P[:, self.vs_idx]
        va = P[:, self.va_idx]
        vh = P[:, self.vh_idx]

        V = np.sqrt(vs * vs + vh * vh + _V_EPS)
        Re = self.earth_radius
        g = G0 * (Re / (Re + h)) ** 2

        cols = np.empty((n, self.n_terms), dtype=float)
        for j, (_, kind, H) in enumerate(self.terms):
            if kind == "bias":
                cols[:, j] = 1.0
            elif kind == "gravity":
                cols[:, j] = -g
            elif kind == "curv":
                cols[:, j] = vs * vs / (Re + h)
            elif kind == "lin_vs":
                cols[:, j] = vs
            elif kind == "lin_vh":
                cols[:, j] = vh
            elif kind == "lin_va":
                cols[:, j] = va
            else:
                rho = np.exp(np.minimum(-h / H, _EXP_ARG_MAX))
                q = 0.5 * rho * V * V
                if kind == "drag_s":
                    cols[:, j] = -q * vs / V
                elif kind == "drag_h":
                    cols[:, j] = -q * vh / V
                elif kind == "lift_s":
                    cols[:, j] = q * vh / V
                elif kind == "lift_h":
                    cols[:, j] = -q * vs / V
                elif kind == "lat_aero":
                    cols[:, j] = q
                else:
                    raise ValueError(f"unknown EOM term kind: {kind}")

        # Freeze per-column RMS on the first (training) call, then always normalise
        # and clip. Same reasoning as the physics library: exp(-h/H) is unbounded
        # outside the training envelope and would otherwise destabilise a rollout
        # that wanders below it.
        if self.col_scale_ is None:
            rms = np.sqrt(np.mean(cols ** 2, axis=0))
            rms[~np.isfinite(rms) | (rms <= 0)] = 1.0
            self.col_scale_ = rms
        return np.clip(cols / self.col_scale_, -self.clip, self.clip)


def evaluate_eom_library_torch(y, spec: dict):
    """Torch mirror of `EOMLibrary.fit_transform` (identical column order)."""
    import torch

    mean, scale = spec.get("feature_mean"), spec.get("feature_scale")
    if mean is not None and scale is not None:
        mean_t = torch.as_tensor(mean, dtype=y.dtype, device=y.device)
        scale_t = torch.as_tensor(scale, dtype=y.dtype, device=y.device)
        P = y * scale_t + mean_t
    else:
        P = y

    hi, vsi, vai, vhi = spec["h_idx"], spec["vs_idx"], spec["va_idx"], spec["vh_idx"]
    h = P[..., hi : hi + 1]
    vs = P[..., vsi : vsi + 1]
    va = P[..., vai : vai + 1]
    vh = P[..., vhi : vhi + 1]
    V = torch.sqrt(vs * vs + vh * vh + _V_EPS)
    Re = spec["earth_radius"]
    g = G0 * (Re / (Re + h)) ** 2

    cols = []
    for (_, kind, H) in spec["terms"]:
        if kind == "bias":
            cols.append(torch.ones_like(h))
        elif kind == "gravity":
            cols.append(-g)
        elif kind == "curv":
            cols.append(vs * vs / (Re + h))
        elif kind == "lin_vs":
            cols.append(vs)
        elif kind == "lin_vh":
            cols.append(vh)
        elif kind == "lin_va":
            cols.append(va)
        else:
            rho = torch.exp(torch.clamp(-h / H, max=_EXP_ARG_MAX))
            q = 0.5 * rho * V * V
            if kind == "drag_s":
                cols.append(-q * vs / V)
            elif kind == "drag_h":
                cols.append(-q * vh / V)
            elif kind == "lift_s":
                cols.append(q * vh / V)
            elif kind == "lift_h":
                cols.append(-q * vs / V)
            elif kind == "lat_aero":
                cols.append(q)
            else:
                raise ValueError(f"unknown EOM term kind: {kind}")

    out = torch.cat(cols, dim=-1)
    cs = spec.get("col_scale")
    clip = float(spec.get("clip", 8.0))
    if cs is not None:
        cs_t = torch.as_tensor(cs, dtype=out.dtype, device=out.device)
        out = torch.clamp(out / cs_t, -clip, clip)
    return out
