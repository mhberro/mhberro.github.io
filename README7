# sindy_standalone.py
"""Standalone evaluation of the discovered SINDy physics model, on its own.

Why this exists
---------------
The agreed order of operations is to nail the physics backbone FIRST, before
layering APHYNITY or a neural residual on top: if the physics isn't good enough,
there is no reason to believe the residual learner will rescue it. That means we
need to judge the discovered physics *by itself* -- integrate `f_phys` forward
with no neural network at all and measure how far it drifts from truth.

Two capabilities live here:

1. `format_sindy_equations` -- turn the coefficient table `Xi` into readable
   equations (e.g. "dv_h/dt = -0.0385*h + 0.0226*h*h + ..."), so discovered models
   can be compared term-by-term against another implementation.

2. `sindy_rollout` / `evaluate_sindy` -- integrate the pure physics model forward
   from a single initial state (RK4, matching training) and report position error
   against truth in physical units.

Note on the error metric: this reports IN-PLANE error in the geodesic frame --
range (s) and altitude (h). It deliberately does NOT reconstruct cross-range,
which would require integrating the azimuth rate and a full frame inversion (that
is what `standalone_direct_evaluator.py` does for a trained model). In-plane error
is a fast, honest screen for "is the physics backbone any good"; it will read
slightly optimistic versus a full 3D ECEF error.
"""

from __future__ import annotations

import numpy as np

DEFAULT_STATE_NAMES = ["s", "h", "v_s", "v_al", "v_h"]
DEFAULT_TARGET_NAMES = ["ds/dt", "dh/dt", "dv_s/dt", "dv_al/dt", "dv_h/dt"]


# --------------------------------------------------------------------- naming

def library_term_names(library, n_features: int, state_names=None) -> list[str]:
    """Human-readable name for every library column.

    Uses the library's own `term_names()` when it has one (the physics library);
    otherwise derives names from the polynomial combination tuples.
    """
    if hasattr(library, "term_names"):
        try:
            return list(library.term_names())
        except TypeError:
            pass
    names = list(state_names or DEFAULT_STATE_NAMES)[:n_features]
    combos = library.term_combos(n_features)
    out = []
    for combo in combos:
        if combo is None:
            out.append("<physics>")
        elif len(combo) == 0:
            out.append("1")
        else:
            out.append("*".join(names[i] for i in combo))
    return out


# ------------------------------------------------------------------ equations

def format_sindy_equations(
    Xi: np.ndarray,
    term_names: list[str],
    target_names=None,
    min_coef: float = 0.0,
    inclusion_probs: np.ndarray | None = None,
) -> str:
    """Render `Xi` as readable equations, one per state derivative.

    `min_coef` hides terms whose |coefficient| is below the cutoff (0 shows all
    non-zero terms). If `inclusion_probs` is given, each term is annotated with the
    fraction of bootstrap fits that selected it -- the ensemble's confidence.
    """
    targets = list(target_names or DEFAULT_TARGET_NAMES)[: Xi.shape[1]]
    lines = []
    for c in range(Xi.shape[1]):
        target = targets[c] if c < len(targets) else f"d(x{c})/dt"
        pieces = []
        # Show the biggest contributors first.
        order = np.argsort(-np.abs(Xi[:, c]))
        for r in order:
            coef = float(Xi[r, c])
            if coef == 0.0 or abs(coef) < min_coef:
                continue
            sign = "-" if coef < 0 else "+"
            piece = f"{sign} {abs(coef):.6g}*{term_names[r]}"
            if inclusion_probs is not None:
                piece += f" [ip={inclusion_probs[r, c]:.2f}]"
            pieces.append(piece)
        if not pieces:
            lines.append(f"{target} = 0")
            continue
        body = " ".join(pieces)
        if body.startswith("+ "):
            body = body[2:]
        lines.append(f"{target} = {body}")
    return "\n".join(lines)


# ------------------------------------------------------------------- rollout

def _make_rhs(library, Xi, n_features, pos_idx, vel_idx, so_ratio, so_offset):
    """Build the pure-physics derivative function d(scaled state)/dt.

    The kinematic identity for the position channels is enforced explicitly. When
    the discovery used analytic position rows, `Xi` already encodes exactly this,
    so the override is a no-op; when it didn't, this keeps the rollout physically
    consistent either way.
    """
    use_override = (
        pos_idx is not None and vel_idx is not None and so_ratio is not None
    )

    def rhs(y: np.ndarray) -> np.ndarray:
        Theta = library.fit_transform(y.reshape(1, -1))
        dy = np.asarray(Theta @ Xi, dtype=float).reshape(-1)
        if use_override:
            for k, (p_i, v_i) in enumerate(zip(pos_idx, vel_idx)):
                dy[p_i] = y[v_i] * so_ratio[k] + so_offset[k]
        return dy

    return rhs


def sindy_rollout(
    library,
    Xi: np.ndarray,
    y0_scaled: np.ndarray,
    n_steps: int,
    dt: float,
    substeps: int = 8,
    pos_idx=None,
    vel_idx=None,
    so_ratio=None,
    so_offset=None,
    diverge_limit: float = 1e6,
) -> np.ndarray:
    """Integrate the pure physics model forward with RK4.

    Returns the predicted scaled states, shape (n_steps, n_features). Stops early
    and pads with NaN if the state goes non-finite or explodes, so a diverging
    physics model is visible rather than crashing the caller.
    """
    n_features = y0_scaled.shape[-1]
    rhs = _make_rhs(library, Xi, n_features, pos_idx, vel_idx, so_ratio, so_offset)

    out = np.full((n_steps, n_features), np.nan, dtype=float)
    y = np.asarray(y0_scaled, dtype=float).copy()
    out[0] = y
    h = dt / float(substeps)

    for step in range(1, n_steps):
        for _ in range(substeps):
            k1 = rhs(y)
            k2 = rhs(y + 0.5 * h * k1)
            k3 = rhs(y + 0.5 * h * k2)
            k4 = rhs(y + h * k3)
            y = y + (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
        if not np.all(np.isfinite(y)) or np.max(np.abs(y)) > diverge_limit:
            break
        out[step] = y
    return out


# ------------------------------------------------------------------ evaluation

def evaluate_sindy(
    library,
    Xi: np.ndarray,
    trajectories: list[np.ndarray],
    scaler,
    dt: float,
    substeps: int = 8,
    pos_idx=(0, 1),
    vel_idx=(2, 4),
    so_ratio=None,
    so_offset=None,
    names: list[str] | None = None,
    max_steps: int | None = None,
) -> dict:
    """Roll out the pure physics model on each trajectory and score it.

    `trajectories` are SCALED state arrays (n_steps, n_features), the same form
    SINDy was fitted on. Returns per-trajectory rows plus an aggregate summary,
    with errors converted back to metres.
    """
    rows = []
    for i, traj in enumerate(trajectories):
        traj = np.asarray(traj, dtype=float)
        n_steps = traj.shape[0]
        if max_steps is not None:
            n_steps = min(n_steps, max_steps)
        if n_steps < 3:
            continue

        pred = sindy_rollout(
            library, Xi, traj[0], n_steps, dt, substeps,
            pos_idx, vel_idx, so_ratio, so_offset,
        )

        truth_phys = scaler.inverse_transform(traj[:n_steps])
        finite_mask = np.all(np.isfinite(pred), axis=1)
        n_valid = int(finite_mask.sum())
        if n_valid < 2:
            rows.append({
                "name": (names[i] if names else f"traj_{i}"),
                "steps": n_steps, "valid_steps": n_valid,
                "mean_pos_err_m": float("nan"), "final_pos_err_m": float("nan"),
                "max_pos_err_m": float("nan"), "diverged": True,
            })
            continue

        pred_phys = np.full_like(truth_phys, np.nan)
        pred_phys[finite_mask] = scaler.inverse_transform(pred[finite_mask])

        p = np.asarray(pos_idx, dtype=int)
        err = np.linalg.norm(pred_phys[finite_mask][:, p] - truth_phys[finite_mask][:, p], axis=1)
        rows.append({
            "name": (names[i] if names else f"traj_{i}"),
            "steps": n_steps,
            "valid_steps": n_valid,
            "mean_pos_err_m": float(np.mean(err)),
            "final_pos_err_m": float(err[-1]),
            "max_pos_err_m": float(np.max(err)),
            "diverged": bool(n_valid < n_steps),
        })

    finite_rows = [r for r in rows if np.isfinite(r["mean_pos_err_m"])]
    summary = {
        "n_trajectories": len(rows),
        "n_diverged": sum(1 for r in rows if r["diverged"]),
        "mean_pos_err_m": float(np.mean([r["mean_pos_err_m"] for r in finite_rows])) if finite_rows else float("nan"),
        "median_pos_err_m": float(np.median([r["mean_pos_err_m"] for r in finite_rows])) if finite_rows else float("nan"),
        "worst_pos_err_m": float(np.max([r["mean_pos_err_m"] for r in finite_rows])) if finite_rows else float("nan"),
    }
    return {"rows": rows, "summary": summary}


def format_evaluation(result: dict, label: str = "") -> str:
    """Render the evaluation as a readable table."""
    rows, s = result["rows"], result["summary"]
    out = []
    header = f"[pure-SINDy rollout{(' — ' + label) if label else ''}]"
    out.append(header)
    out.append(f"  {'trajectory':<28}{'steps':>7}{'valid':>7}{'mean_m':>12}{'final_m':>12}{'max_m':>12}")
    for r in rows:
        flag = "  DIVERGED" if r["diverged"] else ""
        out.append(
            f"  {r['name'][:28]:<28}{r['steps']:>7}{r['valid_steps']:>7}"
            f"{r['mean_pos_err_m']:>12.1f}{r['final_pos_err_m']:>12.1f}{r['max_pos_err_m']:>12.1f}{flag}"
        )
    out.append(
        f"  SUMMARY: mean={s['mean_pos_err_m']:.1f} m | median={s['median_pos_err_m']:.1f} m | "
        f"worst={s['worst_pos_err_m']:.1f} m | diverged {s['n_diverged']}/{s['n_trajectories']}"
    )
    out.append("  (in-plane geodesic error: range + altitude; excludes cross-range)")
    return "\n".join(out)
