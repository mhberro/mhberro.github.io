New-Item -ItemType Directory -Force C:\temp | Out-Null
$action = New-ScheduledTaskAction -Execute 'cmd.exe' -Argument '/c (whoami & dir G:\) > C:\temp\gtest.txt 2>&1'
$principal = New-ScheduledTaskPrincipal -UserId 'NT AUTHORITY\SYSTEM' -LogonType ServiceAccount -RunLevel Highest
Register-ScheduledTask -TaskName SystemDriveTest -Action $action -Principal $principal -Force
Start-ScheduledTask -TaskName SystemDriveTest
Start-Sleep -Seconds 3
Get-Content C:\temp\gtest.txt
Unregister-ScheduledTask -TaskName SystemDriveTest -Confirm:$false
