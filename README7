version: '3.8'

services:
  anomaly-detector:
    build: .
    image: automation-toolset:latest
    container_name: automation-test-run
    isolation: process
    ports:
      - "8501:8501"
    environment:
      - STREAMLIT_SERVER_HEADLESS=true
    volumes:
      - G:/docker-storage/logs:C:/app/logs:ro
      - G:/docker-storage/reports:C:/app/reports
    entrypoint: ["streamlit", "run", "src/nbf_anomaly_detection.py", "--server.port=8501", "--server.address=0.0.0.0"]
    restart: always


