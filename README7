# ensemble_sindy.py
"""PySINDy ensemble discovery module for sparse physical vector fields."""

from __future__ import annotations

import itertools
import numpy as np
import torch
from torch import nn
import pysindy as ps


class AeroLibrary(ps.feature_library.base.BaseFeatureLibrary):
    """
    Bridge library to match the PyTorch Aero expansion for PySINDy.
    Inherits from PySINDy's BaseFeatureLibrary to safely process lists of 
    trajectories without crashing scikit-learn's _set_output wrapper.
    """
    def __init__(self, h_mean=0.0, h_scale=1.0, H_scale_m=7200.0):
        super().__init__()
        self.h_mean = h_mean
        self.h_scale = h_scale
        self.H_scale_m = H_scale_m

    def fit(self, X, y=None):
        # Safely extract shape whether PySINDy passes an array or a list of arrays
        if isinstance(X, list):
            self.n_features_in_ = X[0].shape[1]
        else:
            self.n_features_in_ = X.shape[1]
        self.n_output_features_ = 8 
        return self

    def transform(self, X):
        if isinstance(X, list):
            return [self._transform_single(x) for x in X]
        else:
            return self._transform_single(X)
            
    def fit_transform(self, X, y=None):
        """Explicitly defined to bypass scikit-learn's crashing wrapper."""
        self.fit(X, y)
        return self.transform(X)

    def _transform_single(self, X):
        X = np.atleast_2d(X)
        n_samples = X.shape[0]
        # X is passed in as scaled data. Velocities can remain scaled for the regression
        # targets, but altitude MUST be unscaled to capture the exponential drop-off.
        v_sq = X[:, 2]**2 + X[:, 4]**2
        h_phys = X[:, 1] * self.h_scale + self.h_mean
        q_proxy = np.exp(-h_phys / self.H_scale_m) * v_sq
        
        cols = [
            np.ones((n_samples, 1)),
            X[:, 1:2],
            X[:, 2:3],
            X[:, 4:5],
            v_sq[:, None],
            q_proxy[:, None],
            (q_proxy * X[:, 2])[:, None],
            (q_proxy * X[:, 4])[:, None],
        ]
        return np.hstack(cols)

    def get_feature_names(self, input_features=None):
        return ["1", "h", "vs", "vh", "v^2", "q", "q*vs", "q*vh"]

    def get_feature_names_out(self, input_features=None):
        """Satisfies modern scikit-learn / PySINDy requirements."""
        return np.array(self.get_feature_names(input_features), dtype=object)

    @property
    def size(self):
        return 8


class PySINDyDiscoverer:
    def __init__(
        self,
        degree: int = 2,
        l1_threshold: float = 0.01,
        use_aero: bool = True,
        ensemble: bool = True,
        n_bootstraps: int = 50,
        subsample_ratio: float = 0.7,
        h_mean: float = 0.0,
        h_scale: float = 1.0,
    ):
        self.degree = degree
        self.l1_threshold = l1_threshold
        self.use_aero = use_aero
        self.ensemble = ensemble
        self.n_bootstraps = n_bootstraps
        self.subsample_ratio = subsample_ratio
        self.h_mean = h_mean
        self.h_scale = h_scale

    def fit(self, Y_list: list[np.ndarray], dt: float) -> tuple[np.ndarray, np.ndarray]:
        valid_Y = [Y[2:-2] for Y in Y_list if len(Y) >= 5]
        if len(valid_Y) == 0:
            raise ValueError("No valid trajectory samples provided to SINDy.")

        # 1. Feature Library Configuration
        if self.use_aero:
            feature_library = AeroLibrary(h_mean=self.h_mean, h_scale=self.h_scale)
        else:
            feature_library = ps.PolynomialLibrary(degree=self.degree, include_bias=True)

        # 2. Optimizer Configuration
        base_opt = ps.STLSQ(threshold=self.l1_threshold, alpha=1e-3, max_iter=25)
        
        if self.ensemble:
            opt = ps.EnsembleOptimizer(
                opt=base_opt,
                bagging=True,
                n_models=self.n_bootstraps,
            )
        else:
            opt = base_opt

        model = ps.SINDy(feature_library=feature_library, optimizer=opt)
        
        # 3. Explicitly compute derivatives over the valid trajectories
        X_stacked = np.vstack(valid_Y)
        X_dot_stacked = np.vstack([np.gradient(y, dt, axis=0) for y in valid_Y])

        # 4. Fit & Extract Coefficients
        if self.ensemble:
            # Pass t=dt to satisfy the PySINDy API requirements
            model.fit(X_stacked, t=dt, x_dot=X_dot_stacked)
            # PySINDy stores ensemble coefficients in coef_list of shape (n_models, n_targets, n_features)
            bootstrap_coeffs = np.array(model.optimizer.coef_list) 
            bootstrap_coeffs = bootstrap_coeffs.transpose(0, 2, 1) # Align to (n_models, n_features, n_targets)
            
            active_masks = np.abs(bootstrap_coeffs) > 1e-8
            inclusion_probs = np.mean(active_masks, axis=0)
            Xi_agg = np.median(bootstrap_coeffs, axis=0)
            
            inclusion_prob_threshold = 0.40
            Xi_agg[inclusion_probs < inclusion_prob_threshold] = 0.0
            return Xi_agg, inclusion_probs
        else:
            # Pass t=dt to satisfy the PySINDy API requirements
            model.fit(X_stacked, t=dt, x_dot=X_dot_stacked)
            Xi = model.coefficients().T 
            return Xi, np.ones_like(Xi)


class SINDyPhysicsModel(nn.Module):
    def __init__(
        self, 
        Xi: np.ndarray, 
        state_vector_len: int = 5, 
        degree: int = 2, 
        use_aero: bool = True,
        h_mean: float = 0.0,
        h_scale: float = 1.0,
        H_scale_m: float = 7200.0,
    ):
        super().__init__()
        self.degree = degree
        self.state_vector_len = state_vector_len
        self.use_aero = use_aero
        self.h_mean = float(h_mean)
        self.h_scale = float(h_scale)
        self.H_scale_m = float(H_scale_m)
        self.register_buffer("Xi", torch.tensor(Xi, dtype=torch.float32))

        if not self.use_aero:
            combos = []
            for d in range(degree + 1):
                combos.extend(itertools.combinations_with_replacement(range(state_vector_len), d))
            self.combos = combos

    def forward(self, y: torch.Tensor) -> torch.Tensor:
        if self.use_aero:
            v_sq = y[..., 2]**2 + y[..., 4]**2
            
            # Physically ground the state before deriving density
            h_phys = y[..., 1] * self.h_scale + self.h_mean
            q_proxy = torch.exp(-h_phys / self.H_scale_m) * v_sq
            
            cols = [
                torch.ones_like(y[..., 0:1]),
                y[..., 1:2],
                y[..., 2:3],
                y[..., 4:5],
                v_sq.unsqueeze(-1),
                q_proxy.unsqueeze(-1),
                (q_proxy * y[..., 2]).unsqueeze(-1),
                (q_proxy * y[..., 4]).unsqueeze(-1),
            ]
            Theta = torch.cat(cols, dim=-1)
        else:
            cols = []
            for combo in self.combos:
                if len(combo) == 0:
                    cols.append(torch.ones_like(y[..., :1]))
                elif len(combo) == 1:
                    cols.append(y[..., combo[0] : combo[0] + 1])
                elif len(combo) == 2:
                    cols.append(y[..., combo[0] : combo[0] + 1] * y[..., combo[1] : combo[1] + 1])
                elif len(combo) == 3:
                    cols.append(
                        y[..., combo[0] : combo[0] + 1]
                        * y[..., combo[1] : combo[1] + 1]
                        * y[..., combo[2] : combo[2] + 1]
                    )
                else:
                    raise NotImplementedError("Polynomial degree > 3 not supported.")
            Theta = torch.cat(cols, dim=-1)
            
        return torch.matmul(Theta, self.Xi)
