def compute_masked_loss(pred: torch.Tensor, target: torch.Tensor, seq_lengths: torch.Tensor, weights: torch.Tensor) -> torch.Tensor:
    # Construct exact boolean mask from sequence lengths: shape (B, T, 1)
    batch_size, max_timesteps, n_features = pred.shape
    t_idx = torch.arange(max_timesteps, device=pred.device).unsqueeze(0).expand(batch_size, max_timesteps)
    valid_mask = (t_idx < seq_lengths.unsqueeze(1)).unsqueeze(-1).float()

    elementwise_loss = torch.nn.functional.mse_loss(pred, target, reduction="none")
    weighted_loss = elementwise_loss * weights.view(1, 1, -1) * valid_mask
    return weighted_loss.sum() / (valid_mask.sum() * n_features + 1e-8)

