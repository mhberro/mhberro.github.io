class HGVAerodynamicLibrary:
    """Aerodynamic feature library for hypersonic glide dynamics."""
    def __init__(self, h_scale_m: float = 7500.0, r_earth_m: float = 6371000.0, scaler=None):
        self.h_scale = h_scale_m
        self.r_earth = r_earth_m
        self.scaler = scaler

    def fit_transform(self, Y_scaled: np.ndarray) -> np.ndarray:
        if self.scaler is not None:
            Y_phys = self.scaler.inverse_transform(Y_scaled)
        else:
            Y_phys = Y_scaled

        s = Y_phys[:, 0]
        h = Y_phys[:, 1]
        v_s = Y_phys[:, 2]
        v_alpha = Y_phys[:, 3]
        v_h = Y_phys[:, 4]

        v_total_sq = v_s**2 + (v_alpha * np.maximum(s, 100.0))**2 + v_h**2
        rho_rel = np.exp(-np.clip(h, 0.0, 120000.0) / self.h_scale)

        features = [
            np.ones_like(s),                                    # Bias
            rho_rel * v_total_sq,                               # Dynamic pressure proxy (~ Drag/Lift)
            rho_rel * (v_s**2),                                 # Along-track aerodynamic drag
            rho_rel * v_s * v_h,                                # Vertical aerodynamic lift coupling
            v_total_sq / (self.r_earth + np.maximum(h, 0.0)),   # Centrifugal acceleration
            -9.80665 * (self.r_earth / (self.r_earth + np.maximum(h, 0.0)))**2, # Gravity
            v_s, v_alpha, v_h                                   # Kinematic damping terms
        ]
        return np.column_stack(features)

