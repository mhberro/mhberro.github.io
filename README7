# physics_library.py
"""Frame-aware aerodynamic candidate library for HGV glide dynamics.

Supports two frames:

  geodesic (5-state): [s, h, v_s, v_alpha, v_h]
      h is RELATIVE altitude; v_alpha is a RATE (rad/s), not a linear velocity.
  lned     (6-state): [Forward, Right, Altitude, VForward, VRight, VUp]
      Altitude is TRUE height above ellipsoid; all three velocity components are
      genuine linear velocities in m/s.

The lned frame is the better host for a physics term, for two concrete reasons:
  1. exp(-h/H) is a function of GEOMETRIC altitude. lned supplies true HAE, so
     the density term is physically exact. In the geodesic frame h is relative,
     so an unknown offset is absorbed into the fitted coefficient and the
     extrapolation is only trustworthy near the reference point -- precisely the
     regime where extrapolation safety does not matter.
  2. The speed norm is unambiguous: sqrt(VF^2 + VR^2 + VU^2), all linear. In the
     geodesic frame v_alpha must be excluded from the norm to avoid summing
     rad/s with m/s, and the lateral row is a rate-of-rate.

The library is built from flight-mechanics forms, NOT a generic polynomial
sweep: a polynomial sweep cannot express exp(-h/H), and that term is the single
thing buying correct out-of-distribution extrapolation.

Everything here operates in PHYSICAL UNITS (metres, seconds, radians).
"""

from __future__ import annotations

import numpy as np

G0 = 9.80665  # [m/s^2]

# Candidate exponential-atmosphere scale heights [m]. US-standard is ~7.16 km in
# the 10-50 km band; the ensemble chooses, because the effective scale height
# depends on the altitude band actually flown.
# A single exponential does not describe 20-110 km. Below ~86 km the scale
# height is ~6-8 km; in the thermosphere it grows to tens of km. Several
# candidates let the ensemble superpose exponentials to approximate a
# piecewise profile, and let it choose which band actually carries the drag.
SCALE_HEIGHTS_M = (6000.0, 7000.0, 8000.0, 9000.0,
                   12000.0, 16000.0, 22000.0, 30000.0, 45000.0, 60000.0)


# ---------------------------------------------------------------------------
# frame specifications
# ---------------------------------------------------------------------------
class FrameSpec:
    def __init__(self, name, state_names, alt_idx, speed_idx, pos_idx, vel_idx,
                 accel_rows, lateral_idx=None, rate_idx=None):
        self.name = name
        self.state_names = list(state_names)
        self.n_state = len(state_names)
        self.alt_idx = alt_idx
        self.speed_idx = list(speed_idx)      # components entering |v|
        self.pos_idx = list(pos_idx)          # position rows (exact identities)
        self.vel_idx = list(vel_idx)          # paired velocities
        self.accel_rows = list(accel_rows)    # rows SINDy actually fits
        self.lateral_idx = lateral_idx        # cross-track channel, if any
        self.rate_idx = rate_idx              # angular-rate channel, if any
        self.accel_row_names = [f"d{state_names[r]}/dt" for r in accel_rows]
        self.identity_pairs = list(zip(pos_idx, vel_idx))

    def __repr__(self):
        return f"FrameSpec({self.name}, {self.n_state}-state)"


GEODESIC_5 = FrameSpec(
    name="geodesic",
    state_names=["s", "h", "v_s", "v_alpha", "v_h"],
    alt_idx=1,
    speed_idx=[2, 4],          # v_alpha EXCLUDED: it is rad/s, not m/s
    pos_idx=[0, 1],
    vel_idx=[2, 4],            # ds/dt = v_s, dh/dt = v_h
    accel_rows=[2, 3, 4],
    lateral_idx=None,
    rate_idx=3,
)

LNED_6 = FrameSpec(
    name="lned",
    state_names=["Forward", "Right", "Altitude", "VForward", "VRight", "VUp"],
    alt_idx=2,                 # TRUE height above ellipsoid
    speed_idx=[3, 4, 5],       # all three are genuine linear velocities
    pos_idx=[0, 1, 2],
    vel_idx=[3, 4, 5],         # dF/dt=VF, dR/dt=VR, dAlt/dt=VUp
    accel_rows=[3, 4, 5],
    lateral_idx=4,             # VRight: cross-track, where maneuvers live
    rate_idx=None,
)

FRAMES = {"geodesic": GEODESIC_5, "lned": LNED_6}


def get_frame(name):
    if name not in FRAMES:
        raise ValueError(f"unknown frame {name!r}; expected one of {sorted(FRAMES)}")
    return FRAMES[name]


# ---------------------------------------------------------------------------
# library construction
# ---------------------------------------------------------------------------
FAMILY_NOTES = {
    "const": "Gravity / trim bias. The vertical row must contain ~-g; recovery is a sanity check.",
    "density": "rho(h) ~ exp(-h/H). The OOD-safety term: lower h -> denser air -> more drag.",
    "drag": "rho(h)*v_i*|v|. Quadratic drag, the dominant glide force, one per velocity axis.",
    "lift": "rho(h)*|v|^2. Dynamic pressure; sustains glide equilibrium on the vertical row.",
    "side": "rho(h)*|v|*v_lat and rho(h)*|v|^2*v_lat. Weathervane / side-force restoring terms.",
    "poly": "Low-order velocity polynomials. Absorb mild non-aerodynamic structure.",
    "coupling": "Pairwise velocity products. Kinematic curvature coupling.",
}


def speed(X, frame):
    """|v| from the frame's genuine linear-velocity components only."""
    acc = 0.0
    for i in frame.speed_idx:
        acc = acc + X[:, i] ** 2
    return np.sqrt(acc) + 1e-12


def build_library(X, frame, scale_heights=SCALE_HEIGHTS_M):
    """Build the candidate feature matrix Theta(X).

    Args:
        X: (N, n_state) states in PHYSICAL units.
        frame: FrameSpec or frame name.
    Returns:
        Theta: (N, n_features), names: list[str] aligned with columns.

    Term names use the frame's own state names, so the same parser in
    physics_field.py reconstructs them for either frame.
    """
    if isinstance(frame, str):
        frame = get_frame(frame)
    X = np.asarray(X, dtype=np.float64)
    if X.ndim != 2 or X.shape[1] != frame.n_state:
        raise ValueError(
            f"expected (N,{frame.n_state}) physical-unit states for frame "
            f"{frame.name!r}, got {X.shape}"
        )

    h = X[:, frame.alt_idx]
    v = speed(X, frame)
    names, cols = [], []

    def add(col, name):
        cols.append(np.asarray(col, dtype=np.float64))
        names.append(name)

    vel_names = [frame.state_names[i] for i in frame.vel_idx]
    vel_cols = {frame.state_names[i]: X[:, i] for i in frame.vel_idx}
    if frame.rate_idx is not None:
        rn = frame.state_names[frame.rate_idx]
        vel_names = vel_names + [rn]
        vel_cols[rn] = X[:, frame.rate_idx]

    # --- constant (gravity / trim) -----------------------------------------
    add(np.ones_like(h), "1")

    # --- exponential atmosphere, drag, lift, side-force ---------------------
    for H in scale_heights:
        rho = np.exp(-h / H)
        tag = f"exp(-h/{H/1000:.1f}k)"
        add(rho, tag)
        # quadratic drag, one per velocity axis
        for nm in vel_names:
            add(rho * vel_cols[nm] * v, f"{tag}*{nm}*|v|")
        # isotropic dynamic pressure (lift form)
        add(rho * v * v, f"{tag}*|v|^2")
        # side-force / weathervane forms on the lateral or rate channel
        lat = None
        if frame.lateral_idx is not None:
            lat = frame.state_names[frame.lateral_idx]
        elif frame.rate_idx is not None:
            lat = frame.state_names[frame.rate_idx]
        if lat is not None:
            add(rho * v * v * X[:, frame.state_names.index(lat)], f"{tag}*|v|^2*{lat}")

    # --- low-order velocity polynomials -------------------------------------
    for nm in vel_names:
        add(vel_cols[nm], nm)
    add(v, "|v|")
    for i, a in enumerate(vel_names):
        for b in vel_names[i:]:
            if a == b:
                add(vel_cols[a] * vel_cols[a], f"{a}^2")
            else:
                add(vel_cols[a] * vel_cols[b], f"{a}*{b}")

    Theta = np.column_stack(cols)
    if not np.all(np.isfinite(Theta)):
        raise ValueError("non-finite entries in library")
    return Theta, names


def library_condition_report(Theta, names):
    """Diagnose collinearity. Neighbouring exp(-h/H) columns are highly
    correlated by construction; this is why inclusion probability, not a point
    estimate, is the gate."""
    keep_var = Theta.std(axis=0) > 0
    Theta = Theta[:, keep_var]
    names = [n for n, k in zip(names, keep_var) if k]
    Th = Theta - Theta.mean(axis=0, keepdims=True)
    sd = Th.std(axis=0)
    sd[sd == 0] = 1.0
    Z = Th / sd
    C = np.corrcoef(Z, rowvar=False)
    np.fill_diagonal(C, 0.0)
    i, j = np.unravel_index(np.argmax(np.abs(C)), C.shape)
    return {
        "n_features": Theta.shape[1],
        "cond": float(np.linalg.cond(Z)),
        "max_abs_corr": float(np.abs(C[i, j])),
        "max_corr_pair": (names[i], names[j]),
    }
