#!/usr/bin/env python3
# diagnose_maneuver_structure.py
"""Is the maneuver forcing STRUCTURED (learnable/forecastable) or RANDOM (only
characterizable as a distribution)?

Why this gates the whole modeling decision
------------------------------------------
Every research report converged on the same diagnosis: the object's maneuvering
acceleration is an exogenous forcing that is not a clean function of state, so a
state-only physics model has an irreducible error floor on the maneuvering
channels. The forcing is

    u = a_measured - g            (Jerry's u = a - g; gravity removed)

and u is the combined aerodynamic force (drag + lift + bank-to-turn maneuver).
The strategic question is what KIND of signal u is:

  * STRUCTURED  -> u is predictable from state and/or its own recent history.
        A learned forcing predictor u_hat = f(state, history) is viable, and a
        single-trajectory forecast is a meaningful deliverable.

  * RANDOM      -> u is (largely) unpredictable from state; its future is not a
        function of anything you have at inference time. Then NO model can
        forecast a single trajectory accurately, and the honest deliverable is a
        DISTRIBUTION / reachable set of trajectories, not one line. This also
        means any method reporting low single-trajectory error is either
        overfitting each flight's specific maneuver sequence or using future
        information (the reconstruction-vs-forecasting trap).

This script measures where u falls on that spectrum, per component, using the
tests that actually separate the two cases:

  TEST 1  Temporal autocorrelation of u within a flight.
          Long correlation time  -> smooth, low-frequency, likely predictable
          from recent history (an AR/again-latent-state model can forecast it).
          Near-white (corr time ~ 1 step) -> random increments, not forecastable.

  TEST 2  Predictability of u from STATE (pos/vel) alone.
          R^2 of a flexible regressor u ~ g(state), evaluated by LEAVE-ONE-
          TRAJECTORY-OUT CV (the only honest split -- within-flight splits leak
          because of autocorrelation). High LOTO-R^2 -> state-driven, a physics
          library can capture it. Low -> not a function of state.

  TEST 3  Predictability of u from its OWN RECENT HISTORY (autoregression).
          One-step-ahead R^2 of u_t ~ [u_{t-1..t-p}]. High -> temporally
          structured (forecastable by carrying a forcing state). Low -> random.

  TEST 4  Cross-flight repeatability / distributional stability.
          Are the marginal statistics of u (magnitude, direction) consistent
          across flights? If the DISTRIBUTION is stable even when the SEQUENCE is
          not, that is the positive result for a probabilistic/ensemble
          deliverable: you can model the maneuver distribution even if you can't
          predict the specific sequence.

  TEST 5  Frequency content (median dominant period of u).
          Concentrated low-frequency power -> structured maneuvers. Broadband ->
          random.

Everything is done in the ECEF frame directly from the measured acceleration
columns (no numerical differentiation needed -- the truth files carry a,
ACC_SLICE), so results are not contaminated by finite-difference noise.

VERDICT is printed automatically with the modeling implication.

Usage
-----
    python diagnose_maneuver_structure.py \
        --tgt-data-paths path/to/maneuvering_dataset \
        --phase glide          # or whichever phase dir holds the trajectories

Run from the directory containing load_truth.py / trajectory_helpers.py.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

import numpy as np

# --- project imports -------------------------------------------------------
try:
    from load_truth import load_single_truth
    from trajectory_helpers import TIME_INDEX, POS_SLICE, VEL_SLICE, ACC_SLICE
except Exception as exc:  # pragma: no cover
    sys.exit(f"Run from the directory with load_truth.py / trajectory_helpers.py: {exc}")

try:
    from sklearn.ensemble import HistGradientBoostingRegressor
    _HAVE_SK = True
except Exception:
    _HAVE_SK = False

GM_EARTH = 3.986004418e14  # m^3/s^2


# ------------------------------------------------------------------ helpers

def gravity_ecef(pos):
    r = np.linalg.norm(pos, axis=1, keepdims=True)
    r = np.where(r < 1.0, 1.0, r)
    return -GM_EARTH * pos / r**3


def load_phase(target: Path, phase: str):
    phase_path = target / phase if (target / phase).is_dir() else target
    files = [Path(phase_path, x) for x in sorted(os.listdir(phase_path))
             if not x.startswith(".")]
    out, names = [], []
    for f in files:
        try:
            arr = load_single_truth(str(f), debug=False, min_state_vector_size=10, min_timesteps=5)
            arr = np.atleast_2d(arr)
            if arr.shape[1] >= 10 and arr.shape[0] >= 5:
                out.append(arr)
                names.append(f.name)
        except Exception:
            pass
    return out, names


def compute_u(traj):
    """u = a_measured - g in ECEF, plus the state used to predict it."""
    pos = traj[:, POS_SLICE]
    vel = traj[:, VEL_SLICE]
    acc = traj[:, ACC_SLICE]
    u = acc - gravity_ecef(pos)              # (n, 3) aerodynamic+maneuver force
    state = np.hstack([pos, vel])            # (n, 6)
    return u, state


def autocorr_time(x, max_lag=60):
    """Lag (steps) at which autocorrelation drops below 1/e. ~1 => white."""
    x = x - x.mean()
    if np.allclose(x, 0):
        return 0.0
    denom = np.dot(x, x)
    for lag in range(1, min(max_lag, len(x) - 1)):
        r = np.dot(x[:-lag], x[lag:]) / denom
        if r < np.exp(-1):
            return float(lag)
    return float(max_lag)


def dominant_period(x):
    x = x - x.mean()
    if np.allclose(x, 0) or len(x) < 8:
        return float("nan")
    sp = np.abs(np.fft.rfft(x)) ** 2
    freqs = np.fft.rfftfreq(len(x), d=1.0)
    sp[0] = 0.0
    k = int(np.argmax(sp))
    return float(1.0 / freqs[k]) if freqs[k] > 0 else float("nan")


def ar_r2(u_comp, p=5):
    """One-step-ahead R^2 of u_t ~ [u_{t-1..t-p}] within one flight."""
    n = len(u_comp)
    if n < p + 20:
        return float("nan")
    if np.std(u_comp) < 1e-12:
        # Constant component: perfectly "predictable" but carries no maneuver
        # information. Report 1.0 so it doesn't drag the median toward "random".
        return 1.0
    X = np.column_stack([u_comp[p - 1 - k: n - 1 - k] for k in range(p)])
    y = u_comp[p:]
    m = min(len(X), len(y))
    X, y = X[:m], y[:m]
    Xa = np.column_stack([np.ones(len(X)), X])
    coef, *_ = np.linalg.lstsq(Xa, y, rcond=None)
    pred = Xa @ coef
    ss_res = np.sum((y - pred) ** 2)
    ss_tot = np.sum((y - y.mean()) ** 2)
    return float(1 - ss_res / ss_tot) if ss_tot > 0 else float("nan")


def loto_state_r2(U_list, S_list, max_flights=None):
    """Leave-one-trajectory-out R^2 for u ~ g(state), per component.

    This is the honest test of 'is u a function of state': train on all but one
    flight, predict the held-out flight, average. Within-flight CV would leak
    through autocorrelation and overstate predictability.
    """
    if not _HAVE_SK:
        return None
    n_flights = len(U_list)
    idxs = list(range(n_flights))
    if max_flights:
        idxs = idxs[:max_flights]
    r2_per_comp = [[], [], []]
    for held in idxs:
        tr = [i for i in idxs if i != held]
        Xtr = np.vstack([S_list[i] for i in tr])
        Xte = S_list[held]
        for c in range(3):
            ytr = np.concatenate([U_list[i][:, c] for i in tr])
            yte = U_list[held][:, c]
            model = HistGradientBoostingRegressor(max_depth=4, max_iter=150,
                                                  learning_rate=0.08)
            model.fit(Xtr, ytr)
            pred = model.predict(Xte)
            ss_res = np.sum((yte - pred) ** 2)
            ss_tot = np.sum((yte - yte.mean()) ** 2)
            r2_per_comp[c].append(1 - ss_res / ss_tot if ss_tot > 0 else np.nan)
    return [float(np.nanmean(r)) for r in r2_per_comp]


# --------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tgt-data-paths", required=True)
    ap.add_argument("--phase", default="glide")
    ap.add_argument("--ar-order", type=int, default=5)
    ap.add_argument("--max-loto-flights", type=int, default=None,
                    help="Cap flights used in leave-one-out state regression (speed).")
    args = ap.parse_args()

    target = Path(args.tgt_data_paths)
    trajs, names = load_phase(target, args.phase)
    if len(trajs) < 3:
        sys.exit(f"Need >=3 trajectories; found {len(trajs)} in {target}/{args.phase}")

    U_list, S_list = [], []
    for tr in trajs:
        u, s = compute_u(tr)
        U_list.append(u)
        S_list.append(s)

    comp = ["x", "y", "z"]
    print("=" * 100)
    print("MANEUVER-FORCING STRUCTURE DIAGNOSTIC   u = a_measured - g   (ECEF)")
    print(f"  dataset : {target}/{args.phase}")
    print(f"  flights : {len(trajs)}   (steps: "
          f"min {min(len(u) for u in U_list)}, max {max(len(u) for u in U_list)})")
    print("=" * 100)

    # ---- TEST 1 & 5: autocorrelation time and dominant period ----
    act = {c: [] for c in range(3)}
    per = {c: [] for c in range(3)}
    arr = {c: [] for c in range(3)}
    for u in U_list:
        for c in range(3):
            act[c].append(autocorr_time(u[:, c]))
            per[c].append(dominant_period(u[:, c]))
            arr[c].append(ar_r2(u[:, c], p=args.ar_order))

    print("\n--- TEST 1: autocorrelation time of u (steps to fall below 1/e) ---")
    print("    ~1 step => white/random increments | large => smooth, predictable from history")
    for c in range(3):
        vals = np.array(act[c])
        print(f"    u_{comp[c]}: median {np.nanmedian(vals):5.1f}   "
              f"[p10 {np.nanpercentile(vals,10):.1f}, p90 {np.nanpercentile(vals,90):.1f}]")

    print("\n--- TEST 3: one-step AR(%d) R^2 of u from its OWN recent history ---" % args.ar_order)
    print("    high => temporally structured (forecastable by carrying a forcing state)")
    for c in range(3):
        vals = np.array(arr[c])
        print(f"    u_{comp[c]}: median {np.nanmedian(vals):6.3f}   "
              f"[p10 {np.nanpercentile(vals,10):.3f}, p90 {np.nanpercentile(vals,90):.3f}]")

    print("\n--- TEST 5: dominant oscillation period of u (steps) ---")
    for c in range(3):
        vals = np.array(per[c])
        print(f"    u_{comp[c]}: median {np.nanmedian(vals):6.1f}")

    # ---- TEST 2: predictability from STATE, leave-one-trajectory-out ----
    print("\n--- TEST 2: leave-one-trajectory-out R^2 for u ~ g(state) ---")
    print("    honest test of 'is u a function of state'. high => a state-based")
    print("    physics library can capture the maneuver; low => it cannot.")
    if _HAVE_SK:
        loto = loto_state_r2(U_list, S_list, max_flights=args.max_loto_flights)
        for c in range(3):
            print(f"    u_{comp[c]}: LOTO-R^2 {loto[c]:6.3f}")
    else:
        loto = None
        print("    [scikit-learn not available -- skipped. pip install scikit-learn]")

    # ---- TEST 4: distributional stability across flights ----
    print("\n--- TEST 4: cross-flight distributional stability of |u| ---")
    mags = [np.linalg.norm(u, axis=1) for u in U_list]
    means = np.array([m.mean() for m in mags])
    stds = np.array([m.std() for m in mags])
    cv_of_means = float(np.std(means) / (np.mean(means) + 1e-12))
    print(f"    per-flight mean |u|: {np.mean(means):.3f} m/s^2  "
          f"(flight-to-flight CV {cv_of_means:.2f})")
    print(f"    per-flight std  |u|: {np.mean(stds):.3f} m/s^2")
    print("    low CV => the maneuver DISTRIBUTION is stable across flights even")
    print("    if the sequence isn't -> a probabilistic/ensemble model is well posed.")

    # ---------------------------- verdict ----------------------------
    med_act = np.nanmedian([np.nanmedian(act[c]) for c in range(3)])
    med_ar = np.nanmedian([np.nanmedian(arr[c]) for c in range(3)])
    med_loto = np.nanmedian(loto) if loto is not None else float("nan")

    print("\n" + "=" * 100)
    print("VERDICT")
    print("=" * 100)
    print(f"  autocorr time (median)      : {med_act:.1f} steps")
    print(f"  AR self-predictability (med): {med_ar:.3f}")
    if loto is not None:
        print(f"  state predictability (LOTO) : {med_loto:.3f}")
    print()

    state_driven = (not np.isnan(med_loto)) and med_loto > 0.5
    history_driven = med_ar > 0.5 or med_act > 5
    if state_driven:
        print("  => STRUCTURED (state-driven). The maneuver forcing is substantially a")
        print("     function of state. A physics/UDE model with the right basis can")
        print("     capture it; single-trajectory forecasting is a valid deliverable.")
        print("     ACTION: focus on the state-based forcing terms; SINDy-with-control")
        print("     or a UDE residual keyed on state is the right tool.")
    elif history_driven:
        print("  => STRUCTURED (history-driven, weakly state-dependent). The forcing is")
        print("     smooth/autocorrelated and forecastable by CARRYING A FORCING STATE")
        print("     (latent-variable / recurrent residual), even though it is not a clean")
        print("     function of instantaneous state. Single-trajectory forecasting is")
        print("     viable over horizons up to ~the autocorrelation time; beyond that it")
        print("     degrades toward the distributional case.")
        print("     ACTION: a UDE with a recurrent/latent forcing state (your GRU-ODE")
        print("     residual is well suited) -- train it to carry and propagate u.")
    else:
        print("  => RANDOM. The forcing is neither a function of state nor forecastable")
        print("     from its own history. NO model can accurately forecast a single")
        print("     trajectory -- any method that claims to is overfitting each flight's")
        print("     maneuver sequence or using future information (the reconstruction")
        print("     trap). The correct deliverable is a DISTRIBUTION / reachable set.")
        if cv_of_means < 0.5:
            print("     GOOD NEWS: the maneuver DISTRIBUTION is stable across flights")
            print("     (low CV), so a probabilistic/ensemble forecast is well posed even")
            print("     though a point forecast is not.")
        print("     ACTION: reframe the deliverable as probabilistic; model the maneuver")
        print("     as a bounded/stochastic disturbance and report an ensemble or")
        print("     reachable set, not a single line. Re-scope any accuracy metric to a")
        print("     distributional one (e.g. coverage, CRPS) before comparing to Jerry's.")
    print("=" * 100)


if __name__ == "__main__":
    main()
