# ensemble_sindy.py
"""Ensemble-SINDy discovery module for sparse physical vector fields."""

from __future__ import annotations

import itertools
import numpy as np
import torch
from torch import nn


class PolynomialLibrary:
    def __init__(self, degree: int = 2, include_bias: bool = True):
        self.degree = degree
        self.include_bias = include_bias

    def fit_transform(self, Y: np.ndarray) -> np.ndarray:
        n_samples, n_features = Y.shape
        combos = []
        for d in range(0 if self.include_bias else 1, self.degree + 1):
            combos.extend(itertools.combinations_with_replacement(range(n_features), d))

        library = np.empty((n_samples, len(combos)), dtype=Y.dtype)
        for i, combo in enumerate(combos):
            if len(combo) == 0:
                library[:, i] = 1.0
            else:
                library[:, i] = np.prod(Y[:, combo], axis=1)
        return library


def stridge(
    Theta: np.ndarray,
    Ydot: np.ndarray,
    l1_threshold: float = 0.01,
    ridge_kw: float = 1e-3,
    max_iter: int = 25,
) -> np.ndarray:
    n_features = Theta.shape[1]
    n_targets = Ydot.shape[1]

    col_norms = np.linalg.norm(Theta, axis=0)
    col_norms[col_norms < 1e-8] = 1.0
    Theta_norm = Theta / col_norms

    Xi_norm = np.linalg.lstsq(
        Theta_norm.T @ Theta_norm + ridge_kw * np.eye(n_features),
        Theta_norm.T @ Ydot,
        rcond=None,
    )[0]

    for _ in range(max_iter):
        small_inds = np.abs(Xi_norm) < l1_threshold
        Xi_norm[small_inds] = 0.0
        for i in range(n_targets):
            big_inds = ~small_inds[:, i]
            if np.any(big_inds):
                Theta_sub = Theta_norm[:, big_inds]
                Xi_norm[big_inds, i] = np.linalg.lstsq(
                    Theta_sub.T @ Theta_sub + ridge_kw * np.eye(np.sum(big_inds)),
                    Theta_sub.T @ Ydot[:, i],
                    rcond=None,
                )[0]

    Xi = Xi_norm / col_norms[:, None]
    return Xi


class EnsembleSINDyDiscoverer:
    def __init__(
        self,
        degree: int = 2,
        n_bootstraps: int = 50,
        # Paper (Sec. 3): "m new rows are sampled with replacement from the original
        # m rows", giving the standard 1 - e^-1 ~= 0.632 coverage. A ratio of 0.7 with
        # replacement yields only ~0.50 coverage, discarding information in an already
        # data-starved regime. Default restored to 1.0.
        subsample_ratio: float = 1.0,
        l1_threshold: float = 0.01,
        # Paper uses tol = 0.6 for b(r)agging; 0.4 is reserved for LIBRARY bagging,
        # which is followed by a second bagging pass and so deliberately permissive.
        # This class performs data-bootstrap b(r)agging, so 0.6 is the right default.
        inclusion_prob_threshold: float = 0.60,
        aggregation: str = "bragging",
        pos_idx: list[int] | None = None,
        vel_idx: list[int] | None = None,
        pos_scale=None,
        vel_scale=None,
        vel_mean=None,
        library=None,
    ):
        self.degree = degree
        self.n_bootstraps = n_bootstraps
        self.subsample_ratio = subsample_ratio
        self.l1_threshold = l1_threshold
        self.inclusion_prob_threshold = inclusion_prob_threshold
        self.aggregation = aggregation
        self.pos_idx = pos_idx
        self.vel_idx = vel_idx
        # StandardScaler statistics for the position/velocity index pairs, needed to
        # express the velocity identity correctly in scaled space (see fit()).
        self.pos_scale = pos_scale
        self.vel_scale = vel_scale
        self.vel_mean = vel_mean
        # `library` lets a physics-informed basis be supplied; defaults to the
        # plain polynomial library for backwards compatibility.
        self.library_builder = library if library is not None else PolynomialLibrary(
            degree=degree, include_bias=True
        )

    def fit(self, Y_list: list[np.ndarray], dt: float) -> tuple[np.ndarray, np.ndarray]:
        Y_all, Ydot_all = [], []

        # Scaled-space conversion for the velocity identity (see below).
        ratio = offset = None
        if self.pos_scale is not None and self.vel_scale is not None:
            ratio = np.asarray(self.vel_scale, dtype=float) / np.asarray(self.pos_scale, dtype=float)
            offset = (
                np.asarray(self.vel_mean, dtype=float) / np.asarray(self.pos_scale, dtype=float)
                if self.vel_mean is not None
                else np.zeros_like(ratio)
            )

        for Y in Y_list:
            if len(Y) < 5:
                continue
            Ydot = np.gradient(Y, dt, axis=0)

            # Enforce the exact velocity identity for position-derivative targets.
            #
            # IMPORTANT: when Y is in StandardScaler space (use_scalar=True), the
            # identity is NOT Ydot[pos] = Y[vel]. It is
            #     d(pos_scaled)/dt = vel_scaled*(sigma_vel/sigma_pos) + mu_vel/sigma_pos
            # i.e. exactly the so_ratio / so_offset the predictor model applies.
            # The previous unscaled form overstated the target by sigma_pos/sigma_vel
            # (~1e2-1e3 for this geodesic frame), so SINDy was regressed against a
            # target that was orders of magnitude wrong. It duly returned ~1.0 on the
            # matching velocity term -- which is an artifact of the wrong target, not
            # a discovery. Those rows are also discarded downstream by the model's
            # second-order index_copy, so the mis-set targets only consumed fit budget.
            #
            # With no scaler supplied, ratio=1 / offset=0 recovers the original
            # (correct, unscaled) behaviour.
            if self.pos_idx is not None and self.vel_idx is not None:
                for k, (p_i, v_i) in enumerate(zip(self.pos_idx, self.vel_idx)):
                    if ratio is None:
                        Ydot[:, p_i] = Y[:, v_i]
                    else:
                        Ydot[:, p_i] = Y[:, v_i] * ratio[k] + offset[k]

            Y_all.append(Y[2:-2])
            Ydot_all.append(Ydot[2:-2])

        if len(Y_all) == 0:
            raise ValueError("No valid trajectory samples provided to Ensemble-SINDy.")

        Y_stacked = np.vstack(Y_all)
        Ydot_stacked = np.vstack(Ydot_all)

        Theta = self.library_builder.fit_transform(Y_stacked)
        n_samples, n_terms = Theta.shape

        # Stored for scale-aware diagnostics. Raw |coefficient| is NOT comparable
        # across a library whose columns span many orders of magnitude (a physical
        # drag column can be ~1e6 while a scaled polynomial column is ~1). The
        # meaningful quantity is the term's CONTRIBUTION, |coef| * ||column||,
        # optionally normalised by the target norm to be dimensionless.
        self.column_norms_ = np.linalg.norm(Theta, axis=0)
        self.target_norms_ = np.linalg.norm(Ydot_stacked, axis=0)
        n_targets = Ydot_stacked.shape[1]

        bootstrap_coeffs = np.zeros((self.n_bootstraps, n_terms, n_targets))
        sub_size = int(n_samples * self.subsample_ratio)

        for b in range(self.n_bootstraps):
            indices = np.random.choice(n_samples, size=sub_size, replace=True)
            Theta_b = Theta[indices]
            Ydot_b = Ydot_stacked[indices]
            bootstrap_coeffs[b] = stridge(
                Theta_b, Ydot_b, l1_threshold=self.l1_threshold
            )

        active_masks = np.abs(bootstrap_coeffs) > 1e-8
        inclusion_probs = np.mean(active_masks, axis=0)

        if self.aggregation == "bragging":
            Xi_agg = np.median(bootstrap_coeffs, axis=0)
        else:
            Xi_agg = np.mean(bootstrap_coeffs, axis=0)

        Xi_agg[inclusion_probs < self.inclusion_prob_threshold] = 0.0

        # Per-target coefficient of determination of the discovered model. This is
        # the correct criterion for comparing LIBRARIES or hyper-parameters (e.g.
        # scale height): term "contribution" is not, because collinear candidates
        # trade coefficient mass among themselves and leave it roughly flat.
        resid = Ydot_stacked - Theta @ Xi_agg
        ss_res = np.sum(resid ** 2, axis=0)
        ss_tot = np.sum((Ydot_stacked - Ydot_stacked.mean(axis=0)) ** 2, axis=0)
        self.r2_ = 1.0 - ss_res / np.where(ss_tot > 0, ss_tot, 1.0)
        return Xi_agg, inclusion_probs


class SINDyPhysicsModel(nn.Module):
    def __init__(
        self,
        Xi: np.ndarray,
        state_vector_len: int = 5,
        degree: int = 2,
        trainable: bool = True,
        library_spec: dict | None = None,
    ):
        """Sparse physics term F_p for the APHYNITY decomposition.

        `trainable` (default True) makes the discovered coefficients LEARNABLE.

        This matters: APHYNITY solves  min ||F_a||  s.t.  dX/dt = (F_p + F_a)(X)
        jointly over the physical parameters theta_p AND the network theta_a. Its
        existence/uniqueness results (Props. 1-2) are a metric projection of the
        true F onto the set F_p, and the paper's headline parameter-identification
        gains (e.g. 67.6% -> 2.3% error) come precisely from theta_p being corrected
        by that joint optimization.

        Previously Xi was a register_buffer, i.e. NOT in .parameters(), so theta_p
        was frozen at whatever E-SINDy found on numerically-differentiated data.
        With F_p fixed, F_a must supply all of (F - F_p), so ||F_a|| is bounded
        below by a large constant and minimizing it merely fights the data term
        instead of shifting work onto the physics. That is not the APHYNITY
        algorithm; it is a fixed-residual model with a penalty.

        The E-SINDy SPARSITY PATTERN is preserved via a non-trainable mask, so
        thresholded-out library terms stay exactly zero and cannot creep back in.
        A masked linear-in-parameters family is a finite-dimensional subspace,
        which the APHYNITY paper notes is a Chebyshev set - so the uniqueness
        guarantee still applies.
        """
        super().__init__()
        self.degree = degree
        self.state_vector_len = state_vector_len

        Xi_t = torch.as_tensor(Xi, dtype=torch.float32)
        # Sparsity pattern discovered by E-SINDy (inclusion-probability thresholded).
        self.register_buffer("Xi_mask", (Xi_t != 0).to(torch.float32))
        self.trainable = bool(trainable)
        if self.trainable:
            self.Xi_raw = nn.Parameter(Xi_t.clone())
        else:
            self.register_buffer("Xi_raw", Xi_t.clone())

        # `library_spec` (from PhysicsInformedLibrary.library_spec()) selects the
        # candidate basis. When omitted we fall back to the plain polynomial basis
        # so existing checkpoints and callers behave exactly as before.
        self.library_spec = library_spec
        if library_spec is None:
            combos = []
            for d in range(degree + 1):
                combos.extend(itertools.combinations_with_replacement(range(state_vector_len), d))
            self.combos = combos
        else:
            self.combos = [tuple(c) for c in library_spec["poly_combos"]]

    @property
    def Xi(self) -> torch.Tensor:
        """Effective coefficients: learnable values restricted to the sparse pattern."""
        return self.Xi_raw * self.Xi_mask

    def forward(self, y: torch.Tensor) -> torch.Tensor:
        if self.library_spec is not None:
            from physics_library import evaluate_library_torch

            Theta = evaluate_library_torch(y, self.library_spec)
            return torch.matmul(Theta, self.Xi)
        return self._forward_polynomial(y)

    def _forward_polynomial(self, y: torch.Tensor) -> torch.Tensor:
        cols = []
        for combo in self.combos:
            if len(combo) == 0:
                cols.append(torch.ones_like(y[..., :1]))
            elif len(combo) == 1:
                cols.append(y[..., combo[0] : combo[0] + 1])
            elif len(combo) == 2:
                cols.append(y[..., combo[0] : combo[0] + 1] * y[..., combo[1] : combo[1] + 1])
            elif len(combo) == 3:
                cols.append(
                    y[..., combo[0] : combo[0] + 1]
                    * y[..., combo[1] : combo[1] + 1]
                    * y[..., combo[2] : combo[2] + 1]
                )
            else:
                raise NotImplementedError("Polynomial degree > 3 not supported.")

        Theta = torch.cat(cols, dim=-1)
        return torch.matmul(Theta, self.Xi)
