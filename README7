    def forward(self, y: torch.Tensor) -> torch.Tensor:
        # y is [s, h, v_s, v_alpha, v_h] in scaled space
        # Direct PyTorch implementation of the aerodynamic basis functions
        s, h, v_s, v_alpha, v_h = y[..., 0:1], y[..., 1:2], y[..., 2:3], y[..., 3:4], y[..., 4:5]
        
        # Approximate dynamic terms
        v_sq = v_s**2 + v_h**2
        rho = torch.exp(-torch.clamp(h, min=-2.0, max=10.0)) # scaled altitude proxy

        features = [
            torch.ones_like(s),
            rho * v_sq,
            rho * (v_s**2),
            rho * v_s * v_h,
            v_sq,
            -torch.ones_like(s),
            v_s, v_alpha, v_h
        ]
        Theta = torch.cat(features, dim=-1)
        return torch.matmul(Theta, self.Xi)

