# direct_model_evaluator.py

import argparse
import glob
import os
import sys
import numpy as np
import pandas as pd
import onnxruntime
import matplotlib.pyplot as plt

# Import simulation & coordinate transform functions from codebase
from load_truth import load_single_truth
from simple_sim_esindy import (
    sim_ingress,
    load_phase_guide_point,
    _load_encoder_session,
)
from trajectory_evaluator import (
    compute_trajectory_metrics,
    plot_trajectory_dashboard,
    print_csv_metrics_table,
)
from trajectory_helpers import POS_SLICE, VEL_SLICE, TIME_INDEX


def evaluate_model_directly(args):
    """Executes in-memory trajectory rollouts from trained ONNX model and computes evaluation metrics."""
    if not os.path.exists(args.model):
        raise FileNotFoundError(f"ONNX model file not found at: {args.model}")

    model_dir = os.path.dirname(args.model)
    model_basename = os.path.basename(args.model)
    model_name = ".".join(model_basename.split(".")[:-1])

    # Resolve scalar pickle path
    if args.scalar is None or not os.path.exists(args.scalar):
        clean_basename = model_basename.replace(".onnx", "")
        possible_scalar = os.path.join(model_dir, f"{clean_basename}_scalar.pickle")
        if os.path.exists(possible_scalar):
            args.scalar = possible_scalar
        else:
            raise FileNotFoundError(f"Scalar pickle file not found at {possible_scalar}")

    # Expand truth files
    truth_files = []
    for entry in args.truths:
        if os.path.isdir(entry):
            truth_files.extend(glob.glob(os.path.join(entry, "**", "*.csv"), recursive=True))
            truth_files.extend(glob.glob(os.path.join(entry, "*.csv")))
        else:
            truth_files.append(entry)

    truth_files = sorted(list(set(truth_files)))
    if not truth_files:
        print("No truth CSV files found matching input paths.")
        sys.exit(1)

    all_metrics = []

    print(f"\n--- Starting Direct In-Memory Model Evaluation ---")
    print(f"Model: {model_basename}")
    print(f"Truth Trajectories: {len(truth_files)}\n")

    for t_path in truth_files:
        base_name = os.path.basename(t_path)
        traj_name = base_name.replace(".csv", "")

        # 1. Load truth trajectory & ECEF guide point
        truth_states = load_single_truth(t_path)
        guide_point_ecef = load_phase_guide_point(t_path, truth_states)

        # 2. Perform in-memory tactical interface rollouts (No CSV written to disk)
        truth_states_cut, extraps, truth_extraps = sim_ingress(truth_states, guide_point_ecef, args)

        if extraps is None or len(extraps) == 0 or isinstance(truth_states_cut, int):
            print(f"[Skip] Extrapolation failed or empty for {base_name}")
            continue

        # 3. Use primary rollout for full-horizon evaluation
        pred_traj = extraps[0]
        truth_traj = truth_extraps[0]

        # 4. Compute metrics
        metrics = compute_trajectory_metrics(truth_traj, pred_traj, traj_name)
        all_metrics.append(metrics)

        # 5. Render & save 6-panel dashboard plot
        plot_trajectory_dashboard(
            metrics,
            guide_point_ecef,
            output_dir=args.output_dir,
            show_plot=args.show,
        )

    if not all_metrics:
        print("Error: No evaluations were completed successfully.")
        sys.exit(1)

    # 6. Print CSV metrics table directly to terminal
    print_csv_metrics_table(all_metrics)


def main():
    parser = argparse.ArgumentParser(
        description="Direct In-Memory Model Evaluator (No simple_sim CSV generation required)"
    )
    parser.add_argument(
        "-t", "--truths", nargs="+", required=True, help="Path to truth CSV file(s) or directory"
    )
    parser.add_argument("-m", "--model", required=True, help="Path to trained ONNX field model (.onnx)")
    parser.add_argument(
        "-s", "--scalar", default=None, help="Path to scalar pickle file (auto-inferred if omitted)"
    )
    parser.add_argument("-o", "--output-dir", required=True, help="Directory to save output dashboard PNGs")
    parser.add_argument("--frame", default="geodesic", choices=["dcu", "grdth", "geodesic"])
    parser.add_argument("--geodesic-mode", default="integrated", choices=["original", "integrated"])
    parser.add_argument("--sr-min", type=int, default=10000, help="Minimum slant range cutoff [m]")
    parser.add_argument("--sr-max", type=int, default=150000000, help="Maximum slant range cutoff [m]")
    parser.add_argument("--dt", type=float, default=1.0, help="Extrapolation time step [s]")
    parser.add_argument("--sub-steps", type=int, default=4, help="RK4 sub-steps per interval")
    parser.add_argument("--gruode", action="store_true", default=True, help="Enable GRU-ODE continuous rollout")
    parser.add_argument("--show", action="store_true", help="Display interactive plots")

    args = parser.parse_args()
    evaluate_model_directly(args)


if __name__ == "__main__":
    main()
