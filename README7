class HGVPhysics(nn.Module):
    """Sparse, state-only physical vector field for an HGV.

    This is the torch mirror of sindy_physics.build_terms(). The two must stay
    numerically identical: the SINDy fit is the initialisation for these
    parameters, and a mismatch would silently start training from the wrong
    point. test_physics_parity.py checks them against each other.

    Terms, all in SI, evaluated on the PHYSICAL state:

      drag       a = -k_d * rho * V * v          antiparallel to v, always
      lift       a_h = -k_l * rho * V * v_u * vhat_h
                 a_u = +k_l * rho * V * V_h      perpendicular to v, zero work
      gravity    g = k_g * g0 * (R/(R+alt))^2
      curvature  a_u = +k_c * V_h^2 / (R+alt)    rotating velocity bases only

    with rho = exp(-alt/H), the sea-level density folded into k_d and k_l.

    WHY THIS EXTRAPOLATES AND A NETWORK DOES NOT
    Both invariants are structural, not learned, so they hold at every state in
    R^n including states no trajectory ever visited:
      - drag . v <= 0 for all v, because k_d is constrained non-negative and
        the term is built as -k_d*rho*V*v. Energy can never be added.
      - lift . v == 0 identically, by construction of the perpendicular.
    That is the property being bought. Prior work found extrapolations gaining
    energy, exceeding launch speed and flying below ground; no amount of data
    can give a free-form network that guarantee, and these two lines give it
    unconditionally.

    PARAMETERISATION
    Learned coefficients are dimensionless log-multipliers on the SINDy values:
    k = k_ref * exp(clamp(log_k, -bound, +bound)). Three reasons:
      1. Positivity is automatic, so the dissipation guarantee survives
         training. A free-signed k_d could be driven negative by the optimiser
         and would then be an energy *source* - the exact failure being fixed.
      2. All trainable physics parameters are O(1) near zero regardless of
         whether the underlying quantity is 1e-4 (k_d, in 1/m) or 7200 (H, in
         m), so one learning rate is appropriate for all of them.
      3. The clamp is a trust region around a fit that was validated offline.
         It stops the optimiser from quietly annihilating the physics term to
         let the network take over, which would forfeit the extrapolation
         property while looking fine on in-distribution validation.
    """

    def __init__(
        self,
        *,
        n_features: int,
        height_idx: int,
        phys_vel_idx,
        horiz_vel_local,
        vert_vel_local: int,
        horiz_pos_idx,
        fixed_velocity_basis: bool,
        alt_ref_m: float = 0.0,
        scale_height_m: float = 7200.0,
        coefficients: dict | None = None,
        enabled: dict | None = None,
        trainable: dict | None = None,
        learn_scale_height: bool = True,
        max_density_ratio: float = 5.0,
        log_bound: float = 4.0,
    ):
        super().__init__()
        coefficients = coefficients or {}
        enabled = enabled or {}
        trainable = trainable or {}

        self.n_features = int(n_features)
        self.fixed_velocity_basis = bool(fixed_velocity_basis)
        self.log_bound = float(log_bound)

        self.register_buffer("height_idx", torch.tensor([int(height_idx)], dtype=torch.long))
        self.register_buffer("phys_vel_idx", torch.tensor(list(phys_vel_idx), dtype=torch.long))
        self.register_buffer("horiz_vel_local", torch.tensor(list(horiz_vel_local), dtype=torch.long))
        self.register_buffer("vert_vel_local", torch.tensor([int(vert_vel_local)], dtype=torch.long))
        self.register_buffer("horiz_pos_idx", torch.tensor(list(horiz_pos_idx), dtype=torch.long))
        self.register_buffer("alt_ref", torch.tensor(float(alt_ref_m)))
        self.register_buffer("max_log_density", torch.tensor(math.log(float(max_density_ratio))))

        # Reference values from Ensemble-SINDy; the learned parameters are
        # multiplicative corrections on these.
        self.register_buffer("k_drag_ref", torch.tensor(float(coefficients.get("drag", 0.0))))
        self.register_buffer("k_lift_ref", torch.tensor(float(coefficients.get("lift", 0.0))))
        self.register_buffer("scale_height_ref", torch.tensor(float(scale_height_m)))

        # Structural sparsity from the bootstrap inclusion probabilities.
        # A pruned term is multiplied by zero, so its gradient is zero and it
        # can never silently reappear during training.
        self.register_buffer("m_drag", torch.tensor(1.0 if enabled.get("drag", False) else 0.0))
        self.register_buffer("m_lift", torch.tensor(1.0 if enabled.get("lift", False) else 0.0))
        self.register_buffer("m_grav", torch.tensor(1.0 if enabled.get("gravity", True) else 0.0))
        has_curv = (not self.fixed_velocity_basis) and enabled.get("curvature", True)
        self.register_buffer("m_curv", torch.tensor(1.0 if has_curv else 0.0))

        # Known kinematics: fixed at 1.0 unless explicitly made trainable.
        self.register_buffer("k_gravity", torch.tensor(float(coefficients.get("gravity", 1.0))))
        self.register_buffer("k_curvature", torch.tensor(float(coefficients.get("curvature", 1.0))))

        def _param(name: str, active: bool) -> nn.Parameter:
            p = nn.Parameter(torch.zeros(()))
            p.requires_grad_(bool(active) and bool(trainable.get(name, True)))
            return p

        self.log_k_drag = _param("drag", enabled.get("drag", False))
        self.log_k_lift = _param("lift", enabled.get("lift", False))
        self.log_scale_height = nn.Parameter(torch.zeros(()))
        self.log_scale_height.requires_grad_(bool(learn_scale_height))

    # -- accessors -----------------------------------------------------------
    def _mult(self, log_p: torch.Tensor) -> torch.Tensor:
        return torch.exp(torch.clamp(log_p, -self.log_bound, self.log_bound))

    def k_drag(self) -> torch.Tensor:
        return self.k_drag_ref * self._mult(self.log_k_drag) * self.m_drag

    def k_lift(self) -> torch.Tensor:
        return self.k_lift_ref * self._mult(self.log_k_lift) * self.m_lift

    def scale_height(self) -> torch.Tensor:
        return self.scale_height_ref * self._mult(self.log_scale_height)

    # -- field ---------------------------------------------------------------
    def forward(self, y_phys: torch.Tensor) -> torch.Tensor:
        """Physical-unit acceleration on the physics velocity channels.

        Args:
            y_phys: (..., n_features) state in metres and metres/second.
        Returns:
            (..., len(phys_vel_idx)) acceleration in m/s^2, ordered to match
            phys_vel_idx.
        """
        # No tangent-plane altitude correction. NEXT_frame writes
        # lned[i, 3] = hae (true height above the WGS-84 ellipsoid) and the
        # geodesic frame writes h - h0, so the altitude channel is already a
        # geometric altitude in both frames. Adding d^2/(2R) here would inject
        # a spurious ~785 m error at 100 km down-range.
        alt = y_phys.index_select(-1, self.height_idx) + self.alt_ref
        pos_h = y_phys.index_select(-1, self.horiz_pos_idx)

        # Saturate the density. Below the datum exp(-alt/H) grows without
        # bound - at alt = -100 km it is e^13.9 ~ 1.1e6 - which makes the field
        # violently stiff in exactly the regime the model is known to wander
        # into, and dopri5 responds by driving the step size to nothing.
        # Saturation keeps the restoring deceleration strong and correctly
        # signed while leaving the ODE integrable. torch.minimum rather than
        # clamp(max=tensor): wider version support and a cleaner ONNX graph.
        rho = torch.exp(torch.minimum(-alt / self.scale_height(), self.max_log_density))

        v = y_phys.index_select(-1, self.phys_vel_idx)
        vh = v.index_select(-1, self.horiz_vel_local)
        vu = v.index_select(-1, self.vert_vel_local)
        speed_h = torch.sqrt((vh * vh).sum(-1, keepdim=True) + _EPS)
        speed = torch.sqrt(speed_h * speed_h + vu * vu + _EPS)

        zero = torch.zeros_like(v)

        # drag: full vector form, so it opposes motion in every direction
        acc = -self.k_drag() * rho * speed * v

        # lift: perpendicular within the vertical plane => a . v == 0 exactly
        k_l = self.k_lift()
        lift_h = -(k_l * rho * speed * vu / speed_h) * vh
        lift_u = k_l * rho * speed * speed_h
        lift = zero.index_copy(-1, self.horiz_vel_local, lift_h)
        lift = lift.index_copy(-1, self.vert_vel_local, lift_u)
        acc = acc + lift

        # gravity
        g = self.m_grav * self.k_gravity * G0 * (EARTH_RADIUS_M / (EARTH_RADIUS_M + alt)) ** 2
        if self.fixed_velocity_basis:
            # "Down" at horizontal offset p_h, expressed in the origin's fixed
            # basis, is about (-p_h/R, -1): gravity tilts as the vehicle
            # travels down-range. That tilt is what produces the apparent
            # curvature relief in a fixed basis, which is why no curvature term
            # is used here - including both would double-count.
            grav = zero.index_copy(-1, self.horiz_vel_local, -(g / EARTH_RADIUS_M) * pos_h)
            grav = grav.index_copy(-1, self.vert_vel_local, -g)
        else:
            grav = zero.index_copy(-1, self.vert_vel_local, -g)
        acc = acc + grav

        # curvature relief, rotating velocity bases only
        curv_u = self.m_curv * self.k_curvature * speed_h * speed_h / (EARTH_RADIUS_M + alt)
        acc = acc + zero.index_copy(-1, self.vert_vel_local, curv_u)

        return acc

    # -- interpretability ----------------------------------------------------
    @torch.no_grad()
    def describe(self, rho0: float = 1.225) -> dict:
        """Physically meaningful readout of theta_p, for logging.

        Track these across training. If the ballistic coefficient wanders to
        something absurd, the augmentation is pushing the physics around to
        absorb residual it should be modelling itself, and the decomposition
        has stopped being interpretable.
        """
        kd = float(self.k_drag())
        kl = float(self.k_lift())
        return {
            "k_drag_per_m": kd,
            "k_lift_per_m": kl,
            "scale_height_m": float(self.scale_height()),
            "ballistic_coefficient_kg_m2": (rho0 / (2.0 * kd)) if kd > 0 else float("nan"),
            "lift_to_drag_ratio": (kl / kd) if kd > 0 else float("nan"),
        }

    @classmethod
    def from_spec(cls, spec: dict, **overrides) -> "HGVPhysics":
        """Build directly from the JSON written by sindy_physics.discover_physics."""
        if spec.get("schema") != "hgv_physics/1":
            raise ValueError(f"unexpected physics spec schema: {spec.get('schema')!r}")
        check = spec.get("frame_contract_check", {})
        if not check.get("ok", True):
            raise ValueError(
                "physics spec failed its frame-contract check and must not be trained on:\n  "
                + "\n  ".join(check.get("messages", []))
            )
        fr = spec["frame"]
        kwargs = dict(
            n_features=fr["n_features"],
            height_idx=fr["height_idx"],
            phys_vel_idx=fr["phys_vel_idx"],
            horiz_vel_local=fr["horiz_vel_local"],
            vert_vel_local=fr["vert_vel_local"],
            horiz_pos_idx=fr["horiz_pos_idx"],
            fixed_velocity_basis=fr["fixed_velocity_basis"],
            alt_ref_m=fr.get("alt_ref_m", 0.0),
            scale_height_m=spec["scale_height_m"],
            coefficients=spec["coefficients"],
            enabled=spec["enabled"],
            trainable=spec.get("trainable", {}),
            learn_scale_height=spec.get("learn_scale_height", True),
            max_density_ratio=spec.get("max_density_ratio", 5.0),
        )
        kwargs.update(overrides)
        return cls(**kwargs)


class GRUODEPredictorModel(nn.Module):
    def __init__(
        self,
        func: GRUODEFunc,
        pos_idx: list[int] | None = None,
        vel_idx: list[int] | None = None,
        pos_scale=None,
        vel_scale=None,
        vel_mean=None,
        physics: HGVPhysics | None = None,
        state_mean=None,
        state_scale=None,
        disable_augmentation: bool = False,
        zero_init_augmentation: bool | None = None,
        transport_correction: bool = False,
    ):
        """Production wrapper implementing a stateless continuous integration field.

        Args:
            physics: optional f_physics. When present the field becomes
                xdot = f_physics + f_NODE on the physics velocity channels.
            state_mean, state_scale: the StandardScaler statistics for the
                time-stripped state. Required with physics, because f_physics
                is defined in metres and the solver state is scaled.
            disable_augmentation: ablation. Zeroes f_NODE on the physics
                channels, giving the "incomplete physics" baseline of
                APHYNITY Table 1.
            zero_init_augmentation: start f_NODE at exactly zero. Defaults to
                True whenever physics is supplied.
            transport_correction: replace the naive identity d(pos)/dt = vel
                with the correct frame kinematics. Required for frames whose
                velocity basis is fixed at the origin while position is
                measured along the curved earth - which is what the lned frame
                does (see the note on the attribute below). Off by default so
                no existing run changes behaviour silently.
        """
        super().__init__()
        self.func = func
        self.n_features = func.state_vector_len
        self.hidden_size = func.latent_dim
        self.second_order = pos_idx is not None and vel_idx is not None

        if self.second_order:
            self.register_buffer("pos_idx", torch.tensor(list(pos_idx), dtype=torch.long))
            self.register_buffer("vel_idx", torch.tensor(list(vel_idx), dtype=torch.long))
            if pos_scale is not None and vel_scale is not None:
                ratio = torch.as_tensor(vel_scale, dtype=torch.float32) / torch.as_tensor(
                    pos_scale, dtype=torch.float32
                )
                offset = (
                    torch.as_tensor(vel_mean, dtype=torch.float32)
                    / torch.as_tensor(pos_scale, dtype=torch.float32)
                    if vel_mean is not None
                    else torch.zeros_like(ratio)
                )
                self.register_buffer("so_ratio", ratio)
                self.register_buffer("so_offset", offset)
                self.scaled_space = True
            else:
                self.scaled_space = False

        self.transport_correction = bool(transport_correction)
        self.physics = physics
        if physics is not None or self.transport_correction:
            if state_mean is None or state_scale is None:
                raise ValueError(
                    "physics and transport_correction both require state_mean and "
                    "state_scale (the StandardScaler statistics for the time-stripped "
                    "state). Both are defined in metres and metres/second while the "
                    "solver state is scaled. Without these they would be evaluated on "
                    "standardised numbers and would be silently meaningless - the same "
                    "class of unit/frame error that has already cost this project a "
                    "120 km offset."
                )
            if physics is not None and physics.n_features != self.n_features:
                raise ValueError(
                    f"physics expects {physics.n_features} state features, model has "
                    f"{self.n_features}. The frame contract does not match."
                )
            sm = torch.as_tensor(state_mean, dtype=torch.float32).reshape(-1)
            ss = torch.as_tensor(state_scale, dtype=torch.float32).reshape(-1)
            if sm.numel() != self.n_features or ss.numel() != self.n_features:
                raise ValueError(
                    f"state_mean/state_scale must have {self.n_features} entries, got "
                    f"{sm.numel()}/{ss.numel()}. Strip the time column first."
                )
            self.register_buffer("state_mean", sm)
            self.register_buffer("state_scale", ss)

            # One code path for the ablation: a mask rather than a branch, so
            # tracing and ONNX export see the same graph either way.
            aug_mask = torch.ones(self.n_features)
            if physics is not None:
                # Physics returns m/s^2; the solver integrates scaled units, so
                # d(y_scaled)/dt = (dy_phys/dt) / scale.
                self.register_buffer(
                    "phys_vel_state_scale", ss.index_select(0, physics.phys_vel_idx)
                )
                if disable_augmentation:
                    aug_mask.index_fill_(0, physics.phys_vel_idx, 0.0)
            self.register_buffer("aug_mask", aug_mask)

            # f_NODE's output on the position channels is discarded below by
            # the exact second-order identity, so it must not be penalised:
            # doing so would push a component with zero effect on the dynamics
            # toward zero and bias the reported ||F_a||.
            eff = torch.ones(self.n_features)
            if self.second_order:
                eff.index_fill_(0, self.pos_idx, 0.0)
            self.register_buffer("aug_effective_mask", eff)

            if zero_init_augmentation is None:
                zero_init_augmentation = physics is not None
            if zero_init_augmentation:
                self.func.zero_init_decoder()

        if self.transport_correction:
            if not self.second_order or len(list(pos_idx)) != 3:
                raise ValueError(
                    "transport_correction needs a 3-position frame with pos_idx and "
                    f"vel_idx set; got pos_idx={pos_idx}. It is defined for the lned "
                    "layout [Forward, Right, Altitude, VForward, VRight, VUp]."
                )
            # local offsets within pos_idx / vel_idx: horizontal pair, then vertical
            self.register_buffer("tp_h", torch.tensor([0, 1], dtype=torch.long))
            self.register_buffer("tp_v", torch.tensor([2], dtype=torch.long))
            self.register_buffer("pos_state_scale", ss.index_select(0, self.pos_idx))

        self.disable_augmentation = bool(disable_augmentation)

    def forward(self, t, state: torch.Tensor) -> torch.Tensor:
        self.func.nfe += 1

        # Unpack the absolute physical and latent partitions directly from the solver state
        y_read = state[..., : self.n_features]
        h = state[..., self.n_features : self.n_features + self.hidden_size]

        # Enforce analytical bounding constraints cleanly on every evaluation step
        h = torch.tanh(h)
        dh = self.func.cell(t, h)
        xdot = self.func.decode(h)

        if self.physics is not None:
            # f_physics is state-only and lives in physical units.
            y_phys = y_read * self.state_scale + self.state_mean
            a_phys = self.physics(y_phys) / self.phys_vel_state_scale
            xdot = xdot * self.aug_mask + torch.zeros_like(xdot).index_copy(
                -1, self.physics.phys_vel_idx, a_phys
            )

        if self.transport_correction:
            # The naive identity d(pos)/dt = vel is exact only when the
            # position coordinates are the time-integral of the velocity
            # coordinates. In the lned frame they are not:
            #   forward/right : components of the GEODESIC displacement, i.e.
            #                   distance measured along the ellipsoid surface
            #   altitude      : hae, true height above the ellipsoid
            #   v_f/v_r/v_u   : ECEF velocity rotated into the NED frame AT THE
            #                   ORIGIN (NEXT_frame passes `origin`, not the
            #                   current point)
            # Position is measured at the vehicle, velocity is resolved in a
            # basis pinned at the origin. Once the vehicle has travelled far
            # enough for the local vertical to rotate, the two disagree. On a
            # 621 km glide the disagreement reaches 82 m/s in altitude, and
            # imposing the naive identity anyway integrates to ~30 km of
            # altitude drift over the horizon. The correction below reduces
            # that to ~0.04 km.
            #
            # At geodesic distance d the local vertical has rotated by
            # psi = d/Re toward the direction of travel, so
            #   local_along =  v_along*cos(psi) - v_up*sin(psi)
            #   local_up    =  v_along*sin(psi) + v_up*cos(psi)
            # and horizontal rates are scaled by Re/(Re+alt) because forward
            # and right are surface distances while the vehicle is at altitude.
            y_phys = y_read * self.state_scale + self.state_mean
            p_all = y_phys.index_select(-1, self.pos_idx)
            v_all = y_phys.index_select(-1, self.vel_idx)
            p_h = p_all.index_select(-1, self.tp_h)
            alt = p_all.index_select(-1, self.tp_v)
            v_h = v_all.index_select(-1, self.tp_h)
            v_u = v_all.index_select(-1, self.tp_v)

            dist = torch.sqrt((p_h * p_h).sum(-1, keepdim=True) + _EPS)
            u_hat = p_h / dist
            psi = dist / EARTH_RADIUS_M
            sin_p, cos_p = torch.sin(psi), torch.cos(psi)

            v_along = (v_h * u_hat).sum(-1, keepdim=True)
            v_local_along = v_along * cos_p - v_u * sin_p
            v_local_up = v_along * sin_p + v_u * cos_p
            ground_scale = EARTH_RADIUS_M / (EARTH_RADIUS_M + alt)

            dpos_h = (v_local_along * u_hat + (v_h - v_along * u_hat)) * ground_scale
            dpos_phys = torch.zeros_like(p_all).index_copy(-1, self.tp_h, dpos_h)
            dpos_phys = dpos_phys.index_copy(-1, self.tp_v, v_local_up)
            xdot = xdot.index_copy(-1, self.pos_idx, dpos_phys / self.pos_state_scale)

        elif self.second_order:
            vel_now = y_read.index_select(-1, self.vel_idx)
            if getattr(self, "scaled_space", False):
                vel_now = vel_now * self.so_ratio + self.so_offset
            pos_deriv = vel_now
            xdot = xdot.index_copy(-1, self.pos_idx, pos_deriv)

        return torch.cat((xdot, dh), dim=-1)

    # -- APHYNITY support ----------------------------------------------------
    def augmentation_norm(self, states: torch.Tensor, detach_states: bool = True) -> torch.Tensor:
        """||F_a||^2 over a batch of solver states, for the APHYNITY penalty.

        APHYNITY defines the norm on the data as sum_ik ||F_a(X_k^i)||^2. This
        uses a mean rather than a sum so that lambda0 and tau2 do not need
        rescaling when the batch size, horizon or dt changes - which matters
        here because cross-run metrics are already known not to be comparable
        across those settings.

        Args:
            states: (..., n_features + hidden), the solved trajectory.
            detach_states: detach before evaluating. On by default, and the
                default is deliberate. Evaluating the penalty on the model's
                own predictions opens a degenerate route to minimising it:
                rather than shrinking F_a, the optimiser can steer the
                trajectory into regions where F_a happens to be small.
                Detaching removes that route while leaving the gradient with
                respect to theta_a fully intact.
        """
        if self.physics is None:
            return states.new_zeros(())
        s = states.detach() if detach_states else states
        h = torch.tanh(s[..., self.n_features : self.n_features + self.hidden_size])
        f_a = self.func.decode(h) * self.aug_mask * self.aug_effective_mask
        return (f_a**2).sum(-1).mean()

    @torch.no_grad()
    def describe_physics(self) -> dict:
        return self.physics.describe() if self.physics is not None else {}
