class StaticAugmentedGRUODEPredictorModel(nn.Module):
    def __init__(self, func: GRUODEFunc, pos_idx=None, vel_idx=None, pos_scale=None, vel_scale=None, vel_mean=None):
        super().__init__()
        self.func = func
        self.n_features = func.state_vector_len
        self.hidden_size = func.latent_dim
        self.second_order = pos_idx is not None and vel_idx is not None
        
        # Decoder takes instantaneous physical state + dynamic h + frozen h0 parameter
        self.augmented_decoder = nn.Sequential(
            nn.Linear(self.n_features + self.hidden_size * 2, func.nhidden),
            nn.SiLU(),
            nn.Linear(func.nhidden, self.n_features)
        )
        if self.second_order:
            self.register_buffer("pos_idx", torch.tensor(list(pos_idx), dtype=torch.long))
            self.register_buffer("vel_idx", torch.tensor(list(vel_idx), dtype=torch.long))
            if pos_scale is not None and vel_scale is not None:
                self.register_buffer("so_ratio", torch.as_tensor(vel_scale, dtype=torch.float32) / torch.as_tensor(pos_scale, dtype=torch.float32))
                self.register_buffer("so_offset", torch.as_tensor(vel_mean, dtype=torch.float32) / torch.as_tensor(pos_scale, dtype=torch.float32))
                self.scaled_space = True
            else:
                self.scaled_space = False

    def forward(self, t, state: torch.Tensor) -> torch.Tensor:
        # State vector: [y (5), h_dyn (100), h_static (100)] -> Width: 205
        y = state[..., :self.n_features]
        h_dyn = state[..., self.n_features : self.n_features + self.hidden_size]
        h_static = state[..., self.n_features + self.hidden_size:]

        dh_dyn = self.func.cell(t, h_dyn, y)
        dh_static = torch.zeros_like(h_static)  # Invariant trajectory signature

        dec_in = torch.cat([y, h_dyn, h_static], dim=-1)
        xdot = self.augmented_decoder(dec_in)

        if self.second_order:
            vel_now = y.index_select(-1, self.vel_idx)
            if getattr(self, "scaled_space", False):
                vel_now = vel_now * self.so_ratio + self.so_offset
            xdot = xdot.index_copy(-1, self.pos_idx, vel_now)

        return torch.cat([xdot, dh_dyn, dh_static], dim=-1)

