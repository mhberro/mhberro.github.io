# physics_field.py
"""Torch implementation of the SINDy-discovered f_physics term. FRAME-AGNOSTIC.

Supports both the 5-state geodesic frame [s,h,v_s,v_alpha,v_h] and the 6-state
lned frame [Forward,Right,Altitude,VForward,VRight,VUp]. The frame is read from
the discovery JSON, so a coefficient file and the model it is loaded into cannot
silently disagree.

Design constraints:
  1. STATELESS -- no module-state mutation in forward, or autograd/adjoint break.
  2. ONNX-EXPORTABLE under torch.export. Every term is encoded at CONSTRUCTION
     time into dense numeric buffers; evaluation is gather + multiply with no
     data-dependent control flow and no Python branching on tensor values.
  3. INDEPENDENTLY EVALUABLE -- f_physics(y) runs without the neural term, for
     the planned runtime guardrail blend.
  4. SCALING: unscale -> physics in physical units -> rescale. The derivative
     transform has NO mean term (d/dt of a constant is zero).
  5. NON-TRAINABLE by default; optional fine-tuning under a tight prior.

TERM ENCODING (frame-agnostic). Every library term is exactly:

    coef * exp(-h * inv_H) * |v|^p * comp[c1] * comp[c2]

where comp is the state vector augmented with a trailing 1.0, so c=n_state
means "absent". Non-density terms use inv_H = 0, giving exp(0) = 1 exactly.
This single form covers the constant, density, drag, lift, side-force,
polynomial and coupling families in both frames.
"""

from __future__ import annotations

import json
from pathlib import Path

import torch
from torch import nn

# frame layouts, mirroring physics_library.FrameSpec
FRAME_SPECS = {
    "geodesic": {
        "state_names": ["s", "h", "v_s", "v_alpha", "v_h"],
        "alt_idx": 1,
        "speed_idx": [2, 4],          # v_alpha excluded: rad/s, not m/s
        "pos_idx": [0, 1],
        "vel_idx": [2, 4],
    },
    "lned": {
        "state_names": ["Forward", "Right", "Altitude", "VForward", "VRight", "VUp"],
        "alt_idx": 2,                 # true height above ellipsoid
        "speed_idx": [3, 4, 5],       # all genuine linear velocities
        "pos_idx": [0, 1, 2],
        "vel_idx": [3, 4, 5],
    },
}


def parse_term(name: str, state_names: list[str]):
    """Map a library term name to (inv_H, speed_power, c1, c2).

    c1/c2 are state indices, or len(state_names) meaning "absent".
    Raises on anything unrecognised -- failing loudly beats silently dropping a
    discovered term and shipping physics that is quietly missing its drag.
    """
    n = len(state_names)
    inv_H, p, comps = 0.0, 0, []

    for tok in name.strip().split("*"):
        tok = tok.strip()
        if tok in ("", "1"):
            continue
        if tok.startswith("exp(-h/") and tok.endswith("k)"):
            H_km = float(tok[len("exp(-h/"):-2])
            if H_km <= 0:
                raise ValueError(f"non-positive scale height in {name!r}")
            inv_H = 1.0 / (H_km * 1000.0)
            continue
        if tok == "|v|":
            p += 1
            continue
        if tok == "|v|^2":
            p += 2
            continue
        if tok.endswith("^2"):
            base = tok[:-2]
            if base not in state_names:
                raise ValueError(f"unknown state {base!r} in term {name!r}")
            comps += [state_names.index(base)] * 2
            continue
        if tok in state_names:
            comps.append(state_names.index(tok))
            continue
        raise ValueError(f"unrecognised token {tok!r} in library term {name!r}")

    if len(comps) > 2:
        raise ValueError(f"term {name!r} has >2 state factors; unsupported")
    while len(comps) < 2:
        comps.append(n)  # absent -> multiplies by 1.0
    return inv_H, float(p), comps[0], comps[1]


class PhysicsField(nn.Module):
    """f_physics(y_phys) -> (..., n_state) derivative in PHYSICAL units.

    Position rows are left at ZERO on purpose: they are exact identities already
    enforced in GRUODEPredictorModel.forward via index_copy. Writing them here
    too would double-count.
    """

    def __init__(self, terms, frame="lned", trainable: bool = False):
        """
        Args:
            terms: list of (term_name, row_index, coefficient).
            frame: "geodesic" or "lned".
        """
        super().__init__()
        if frame not in FRAME_SPECS:
            raise ValueError(f"unknown frame {frame!r}")
        spec = FRAME_SPECS[frame]
        self.frame = frame
        self.state_names = spec["state_names"]
        self.n_state = len(self.state_names)
        self.alt_idx = spec["alt_idx"]
        self.n_terms = len(terms)
        self.trainable = bool(trainable)

        self.register_buffer("speed_idx", torch.tensor(spec["speed_idx"], dtype=torch.long))

        inv_H, pw, c1, c2, rows, coefs = [], [], [], [], [], []
        for name, row, c in terms:
            iH, p, a, b = parse_term(name, self.state_names)
            if not (0 <= int(row) < self.n_state):
                raise ValueError(f"row {row} out of range for {frame} frame")
            inv_H.append(iH); pw.append(p); c1.append(a); c2.append(b)
            rows.append(int(row)); coefs.append(float(c))

        self.register_buffer("inv_H", torch.tensor(inv_H, dtype=torch.float32))
        self.register_buffer("speed_pow", torch.tensor(pw, dtype=torch.float32))
        self.register_buffer("c1", torch.tensor(c1, dtype=torch.long))
        self.register_buffer("c2", torch.tensor(c2, dtype=torch.long))
        self.register_buffer("rows", torch.tensor(rows, dtype=torch.long))

        coef = torch.tensor(coefs, dtype=torch.float32)
        if trainable:
            self.coef = nn.Parameter(coef)
        else:
            self.register_buffer("coef", coef)
        self.register_buffer("coef_prior", coef.clone())

        scatter = torch.zeros(self.n_terms, self.n_state)
        for i, r in enumerate(rows):
            scatter[i, r] = 1.0
        self.register_buffer("row_scatter", scatter)

    def forward(self, y_phys: torch.Tensor) -> torch.Tensor:
        """f_physics in PHYSICAL units. Stateless. Returns (..., n_state)."""
        if self.n_terms == 0:
            return torch.zeros_like(y_phys)

        h = y_phys[..., self.alt_idx].unsqueeze(-1)              # (...,1)
        vsel = y_phys.index_select(-1, self.speed_idx)
        v = torch.sqrt((vsel * vsel).sum(-1, keepdim=True) + 1e-24)

        # exp(-h*inv_H): inv_H = 0 for non-density terms gives exactly 1.0
        rho = torch.exp(-h * self.inv_H)                          # (...,n_terms)
        vpow = torch.pow(v, self.speed_pow)                       # (...,n_terms)

        ones = torch.ones_like(y_phys[..., :1])
        aug = torch.cat([y_phys, ones], dim=-1)                   # (...,n_state+1)
        a = aug.index_select(-1, self.c1)
        b = aug.index_select(-1, self.c2)

        vals = rho * vpow * a * b * self.coef                     # (...,n_terms)
        return vals @ self.row_scatter                            # (...,n_state)

    def prior_penalty(self) -> torch.Tensor:
        """Tight-prior regulariser for optional fine-tuning. Without it,
        fine-tuning can drift the physics term into fitting maneuvers, which
        destroys the extrapolation guarantee it exists to provide."""
        if not self.trainable or self.n_terms == 0:
            return torch.zeros((), device=self.coef.device)
        scale = self.coef_prior.abs().clamp_min(1e-12)
        return (((self.coef - self.coef_prior) / scale) ** 2).mean()

    @classmethod
    def from_json(cls, path, frame=None, trainable=False, verbose=True):
        """Build from discover_physics.py's exported coefficients.

        The frame is read from the JSON. If `frame` is also given and disagrees,
        this raises rather than silently misaligning columns.
        """
        spec = json.loads(Path(path).read_text())
        json_frame = spec.get("frame", "geodesic")
        if frame is not None and frame != json_frame:
            raise ValueError(
                f"frame mismatch: coefficients were discovered in {json_frame!r} "
                f"but the model is running {frame!r}. Re-run discovery in the "
                f"frame you are training in."
            )
        fr = json_frame
        names = FRAME_SPECS[fr]["state_names"]
        terms = []
        for row_name, r in spec["rows"].items():
            row = r.get("row_index")
            if row is None:
                raise ValueError(f"row_index missing for {row_name}")
            for nm, c in zip(r["terms"], r["coefficients"]):
                terms.append((nm, int(row), float(c)))
        obj = cls(terms, frame=fr, trainable=trainable)
        if verbose:
            print(f"[PhysicsField] frame={fr} gate={spec.get('gate')} "
                  f"terms={len(terms)} states={obj.n_state}")
            for row_name, r in spec["rows"].items():
                n = len(r["terms"])
                tag = "" if n else "   <-- UNEXPLAINED, contributes zero"
                print(f"    {row_name:16s}: {n} terms{tag}")
        return obj


class ScaledPhysicsField(nn.Module):
    """Wraps PhysicsField with the StandardScaler unscale/rescale contract.

        y_phys   = y_scaled * scale + mean        [state inverse: HAS mean]
        f_phys   = physics(y_phys)
        f_scaled = f_phys / scale                 [derivative: NO mean]

    The missing mean on the derivative is the trap. A wrong version still runs
    and still trains; it just injects a large constant drift into every row.
    """

    def __init__(self, physics: PhysicsField, state_mean, state_scale):
        super().__init__()
        self.physics = physics
        n = physics.n_state
        mean = torch.as_tensor(state_mean, dtype=torch.float32).flatten()
        scale = torch.as_tensor(state_scale, dtype=torch.float32).flatten()
        if mean.numel() != n or scale.numel() != n:
            raise ValueError(
                f"frame {physics.frame!r} is {n}-state, but scaler stats have "
                f"mean {mean.numel()} / scale {scale.numel()} entries."
            )
        if torch.any(scale <= 0):
            raise ValueError("scaler scale_ contains non-positive entries")
        self.register_buffer("state_mean", mean)
        self.register_buffer("state_scale", scale)

    def forward(self, y_scaled: torch.Tensor) -> torch.Tensor:
        """Returns f_physics expressed in SCALED derivative units."""
        y_phys = y_scaled * self.state_scale + self.state_mean
        return self.physics(y_phys) / self.state_scale
