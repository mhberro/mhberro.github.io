# physics_library.py
"""Aerodynamic candidate library for HGV glide dynamics in the 5-state
integrated geodesic frame [s, h, v_s, v_alpha, v_h].

Design rationale (per-family justification is in FAMILY_NOTES below). The
library is built from flight-mechanics forms, NOT a generic polynomial sweep:
a polynomial sweep cannot express exp(-h/H), and the exponential atmosphere is
the single term that buys correct out-of-distribution extrapolation.

Everything here operates in PHYSICAL UNITS (metres, seconds, radians).
The scaled-space transform happens later, at integration time, not here.
"""

from __future__ import annotations

import numpy as np

# ---------------------------------------------------------------------------
# state layout (physical units)
# ---------------------------------------------------------------------------
S_IDX, H_IDX, VS_IDX, VA_IDX, VH_IDX = 0, 1, 2, 3, 4
STATE_NAMES = ["s", "h", "v_s", "v_alpha", "v_h"]

# rows we actually fit. ds/dt = v_s and dh/dt = v_h are exact identities and
# are hard-coded in GRUODEPredictorModel.forward -- asking SINDy to rediscover
# them is a correctness check, not a discovery (see fit_identity_rows).
ACCEL_ROWS = [VS_IDX, VA_IDX, VH_IDX]
ACCEL_ROW_NAMES = ["dv_s/dt", "dv_alpha/dt", "dv_h/dt"]

# candidate exponential-atmosphere scale heights [m]. The true US-standard
# value is ~7.16 km in the 10-50 km band; we let the ensemble choose because
# the effective scale height depends on the altitude band actually flown.
SCALE_HEIGHTS_M = (6000.0, 6500.0, 7000.0, 7500.0, 8000.0, 8500.0, 9000.0)

G0 = 9.80665  # [m/s^2]

FAMILY_NOTES = {
    "const": "Gravity / trim bias. dv_h/dt must contain ~-g; its recovery is a sanity check.",
    "density": "rho(h) ~ exp(-h/H). The OOD-safety term: lower h -> denser air -> more drag.",
    "drag": "rho(h)*v*|v| and rho(h)*v_i*|v|. Quadratic drag is the dominant glide force.",
    "lift": "rho(h)*|v|^2 acting on the vertical/lateral rows: sustains glide equilibrium.",
    "poly": "Low-order velocity polynomials. Absorb mild non-aerodynamic structure.",
    "coupling": "v_alpha*v_s etc. Kinematic curvature coupling in a rotating track frame.",
}


def _speed(X: np.ndarray) -> np.ndarray:
    """Total speed magnitude. v_alpha is a RATE (rad/s), not a linear velocity,
    so it is deliberately excluded from the speed norm -- including it would be
    a units error (rad/s summed with m/s)."""
    return np.sqrt(X[:, VS_IDX] ** 2 + X[:, VH_IDX] ** 2) + 1e-12


def build_library(X: np.ndarray, scale_heights=SCALE_HEIGHTS_M) -> tuple[np.ndarray, list[str]]:
    """Build the candidate feature matrix Theta(X).

    Args:
        X: (N, 5) states in PHYSICAL units [s, h, v_s, v_alpha, v_h].
        scale_heights: candidate H values for exp(-h/H).

    Returns:
        Theta: (N, n_features)
        names: feature names, aligned with Theta columns.
    """
    X = np.asarray(X, dtype=np.float64)
    if X.ndim != 2 or X.shape[1] != 5:
        raise ValueError(f"expected (N,5) physical-unit states, got {X.shape}")

    h = X[:, H_IDX]
    v_s = X[:, VS_IDX]
    v_a = X[:, VA_IDX]
    v_h = X[:, VH_IDX]
    v = _speed(X)

    cols: list[np.ndarray] = []
    names: list[str] = []

    def add(col, name):
        cols.append(np.asarray(col, dtype=np.float64))
        names.append(name)

    # --- constant (gravity / trim) -----------------------------------------
    add(np.ones_like(h), "1")

    # --- exponential atmosphere and drag/lift forms -------------------------
    for H in scale_heights:
        rho = np.exp(-h / H)
        tag = f"exp(-h/{H/1000:.1f}k)"
        add(rho, tag)
        # quadratic drag along each linear-velocity axis
        add(rho * v_s * v, f"{tag}*v_s*|v|")
        add(rho * v_h * v, f"{tag}*v_h*|v|")
        # isotropic dynamic-pressure term (lift-form / |v|^2)
        add(rho * v * v, f"{tag}*|v|^2")
        # lateral: dynamic pressure driving azimuth rate (lift-form on v_alpha)
        add(rho * v * v * v_a, f"{tag}*|v|^2*v_alpha")
        add(rho * v * v_a, f"{tag}*|v|*v_alpha")

    # --- low-order velocity polynomials -------------------------------------
    add(v_s, "v_s")
    add(v_h, "v_h")
    add(v_a, "v_alpha")
    add(v, "|v|")
    add(v_s * v_s, "v_s^2")
    add(v_h * v_h, "v_h^2")
    add(v_s * v_h, "v_s*v_h")

    # --- kinematic coupling -------------------------------------------------
    add(v_a * v_s, "v_alpha*v_s")
    add(v_a * v_h, "v_alpha*v_h")
    add(v_a * v_a, "v_alpha^2")

    Theta = np.column_stack(cols)
    if not np.all(np.isfinite(Theta)):
        bad = names[int(np.argmax(~np.isfinite(Theta).all(axis=0)))]
        raise ValueError(f"non-finite entries in library (first bad family near '{bad}')")
    return Theta, names


def library_condition_report(Theta: np.ndarray, names: list[str]) -> dict:
    """Diagnose collinearity. Many exp(-h/H) columns at nearby H are highly
    correlated by construction; ensembling handles the resulting instability by
    reporting inclusion probability rather than a single coefficient, but the
    user should still see how bad it is."""
    # Drop zero-variance columns (e.g. the constant) before the correlation
    # report -- they are legitimate library terms but make corrcoef divide by
    # zero, producing a cosmetic inf/nan that masks real conditioning problems.
    keep_var = Theta.std(axis=0) > 0
    Theta = Theta[:, keep_var]
    names = [n for n, k in zip(names, keep_var) if k]
    Th = Theta - Theta.mean(axis=0, keepdims=True)
    sd = Th.std(axis=0)
    sd[sd == 0] = 1.0
    Z = Th / sd
    C = np.corrcoef(Z, rowvar=False)
    np.fill_diagonal(C, 0.0)
    i, j = np.unravel_index(np.argmax(np.abs(C)), C.shape)
    return {
        "n_features": Theta.shape[1],
        "cond": float(np.linalg.cond(Z)),
        "max_abs_corr": float(np.abs(C[i, j])),
        "max_corr_pair": (names[i], names[j]),
    }
